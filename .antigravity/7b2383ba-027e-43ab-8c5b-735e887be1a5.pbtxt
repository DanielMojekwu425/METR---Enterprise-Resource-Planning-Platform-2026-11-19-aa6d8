            lines {
              text: "export const ENTERPRISE_JOURNEYS: JourneyDefinition[] = ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'lead-to-cash\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    code: \'J-01\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    title: \'Lead-to-Cash\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    phase: \'Phase 1\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    description:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Every revenue line traces cleanly from qualified opportunity through locked quote revisions, sales orders, numbered invoices, and balanced general ledger journals.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    stages: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        id: \'lead\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        label: \'Lead\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        docCode: \'CRM-01\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        statusLabel: \'Qualified & Matched\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        summary:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Capture leads with source attribution, owner scope, and controlled conversion into the deduplicated party registry without losing the original prospect trail.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        stateMachine: \'new \342\206\222 contacted \342\206\222 qualified \342\206\222 converted\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        invariant: \'Conversion is strictly idempotent; original lead record is retained permanently.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        endpoint: \'POST /api/v1/leads/{id}/convert\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        outboxEvent: \'crm.lead.converted.v1\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        id: \'quote\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        label: \'Quote\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        docCode: \'SAL-01\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        statusLabel: \'Revision R2 Approved\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        summary:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Versioned commercial quotations lock item descriptions, unit prices, discounts, tax codes, and validity windows on approval with two-person threshold controls.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        stateMachine: \'draft \342\206\222 submitted \342\206\222 approved \342\206\222 sent \342\206\222 accepted\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        invariant: \'Approved revisions are immutable; any commercial edit opens a new revision snapshot.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        endpoint: \'POST /api/v1/quotes/{id}/approve\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        outboxEvent: \'sales.quote.approved.v1\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        id: \'order\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        label: \'Order\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        docCode: \'SAL-02\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        statusLabel: \'Confirmed Commitment\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        summary:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Accepted quotations convert into traceable sales orders linking every goods, service, or recurring line to downstream fulfilment, contracts, or projects.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        stateMachine: \'draft \342\206\222 confirmed \342\206\222 fulfilling \342\206\222 fulfilled\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        invariant: \'No cancellation after billing or fulfilment without a compensating workflow.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
