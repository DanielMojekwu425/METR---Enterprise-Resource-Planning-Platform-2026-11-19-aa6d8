    tool_calls {
      id: "call_10801445585565164155"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Replace SQL, Monorepo, and API code blocks in ArchitectureTrustSection with plain-English business governance and trust tabs\", \"EndLine\":270, \"Instruction\":\"Rewrite ArchitectureTrustSection keeping the exact dark navy 5:7 split layout, 4-tab inspector, and 6-card reliability strip, while replacing all developer jargon (SQL, NestJS, Next.js, PostgreSQL, Monorepo, API Payload, OWASP, WAL/PITR, Section B1-B9) with clear business trust, financial safeguard, multi-company, approval, and privacy assurance cards.\", \"ReplacementContent\":\"import React, { useState } from \'react\';\\nimport { AnimatePresence, motion } from \'motion/react\';\\nimport {\\n  Building2,\\n  CheckCircle2,\\n  FileCheck2,\\n  Layers,\\n  Lock,\\n  Scale,\\n  ShieldCheck,\\n  UserCheck,\\n} from \'lucide-react\';\\nimport { Reveal } from \'@metr/ui\';\\nimport { RELIABILITY_METRICS, TRUST_SHOWCASE_TABS } from \'../data/metrContent\';\\n\\ntype TrustTab = \'financial\' | \'entities\' | \'approvals\' | \'privacy\';\\n\\nconst PLATFORM_PILLARS = [\\n  {\\n    icon: Layers,\\n    layer: \'Unified Business Workspace\',\\n    detail:\\n      \'One fast, consistent workspace for sales, operations, and finance\342\200\224no juggling disconnected spreadsheets or apps.\',\\n  },\\n  {\\n    icon: UserCheck,\\n    layer: \'Built-In Approval Controls\',\\n    detail:\\n      \'Multi-step sign-offs prevent staff from approving their own high-value quotes, purchases, or payouts.\',\\n  },\\n  {\\n    icon: Scale,\\n    layer: \'Audit-Ready Financial Core\',\\n    detail:\\n      \'Every transaction balances automatically and leaves a permanent, tamper-proof trail for external auditors.\',\\n  },\\n  {\\n    icon: Lock,\\n    layer: \'Encrypted Files & Continuous Backups\',\\n    detail:\\n      \'Contracts, invoices, and receipts stay privately encrypted with automated backups and tested rapid recovery.\',\\n  },\\n];\\n\\nconst TRUST_TABS: { id: TrustTab; label: string; icon: typeof Scale }[] = [\\n  { id: \'financial\', label: \'Financial Safeguards\', icon: Scale },\\n  { id: \'entities\', label: \'Multi-Company Control\', icon: Building2 },\\n  { id: \'approvals\', label: \'Approvals & Access\', icon: FileCheck2 },\\n  { id: \'privacy\', label: \'Privacy & Continuity\', icon: ShieldCheck },\\n];\\n\\nexport function ArchitectureTrustSection() {\\n  const [activeTab, setActiveTab] = useState<TrustTab>(\'financial\');\\n  const currentTabData = TRUST_SHOWCASE_TABS[activeTab];\\n\\n  return (\\n    <section\\n      id=\\\"architecture\\\"\\n      className=\\\"bg-[#102A43] text-white border-b border-[#172B4D] py-16 lg:py-24\\\"\\n    >\\n      <div className=\\\"mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-12\\\">\\n        <Reveal>\\n          <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start\\\">\\n            {/* Left 5 Columns: Business Trust & Platform Pillars */}\\n            <div className=\\\"lg:col-span-5 space-y-6\\\">\\n              <div>\\n                <p className=\\\"text-[11px] font-bold uppercase tracking-[0.08em] text-[#2DD4BF] mb-3\\\">\\n                  Trust, Security & Controls\\n                </p>\\n                <h2 className=\\\"font-[Manrope] text-[28px] sm:text-[36px] lg:text-[40px] font-bold leading-[1.2] tracking-[-0.02em] text-white\\\">\\n                  Built for financial accuracy, strict privacy, and audit readiness.\\n                </h2>\\n                <p className=\\\"mt-4 text-[15px] sm:text-[16px] leading-[26px] text-[#D1E4FF]\\\">\\n                  METR keeps your operations, approvals, and financial books inside one tightly\\n                  governed platform\342\200\224so every number is traceable, every company stays cleanly\\n                  separated, and nothing falls through the cracks.\\n                </p>\\n              </div>\\n\\n              {/* Clean Platform Pillars List */}\\n              <div className=\\\"rounded-[1rem] bg-[#0B1724] border border-white/10 divide-y divide-white/[0.08]\\\">\\n                {PLATFORM_PILLARS.map((row) => {\\n                  const Icon = row.icon;\\n                  return (\\n                    <div key={row.layer} className=\\\"p-4 flex items-start gap-3.5\\\">\\n                      <span className=\\\"mt-0.5 inline-flex h-8 w-8 items-center justify-center rounded-[0.5rem] bg-[#102A43] border border-white/10 text-[#2DD4BF] shrink-0\\\">\\n                        <Icon size={16} aria-hidden=\\\"true\\\" />\\n                      </span>\\n                      <div>\\n                        <div className=\\\"text-[13px] font-semibold text-white\\\">{row.layer}</div>\\n                        <div className=\\\"text-[13px] text-[#B0C9E8] mt-0.5 leading-[20px]\\\">\\n                          {row.detail}\\n                        </div>\\n                      </div>\\n                    </div>\\n                  );\\n                })}\\n              </div>\\n            </div>\\n\\n            {/* Right 7 Columns: Dark Surface Interactive Controls & Assurance Showcase */}\\n            <div className=\\\"lg:col-span-7\\\">\\n              <div className=\\\"rounded-[1.25rem] bg-[#0B1724] border border-white/12 overflow-hidden\\\">\\n                {/* Tab Bar */}\\n                <div\\n                  role=\\\"tablist\\\"\\n                  aria-label=\\\"Platform trust and safeguard views\\\"\\n                  className=\\\"flex flex-wrap items-center gap-1 p-2.5 bg-[#08121D] border-b border-white/10\\\"\\n                >\\n                  {TRUST_TABS.map((tab) => {\\n                    const Icon = tab.icon;\\n                    const active = activeTab === tab.id;\\n                    return (\\n                      <button\\n                        key={tab.id}\\n                        type=\\\"button\\\"\\n                        role=\\\"tab\\\"\\n                        aria-selected={active}\\n                        onClick={() => setActiveTab(tab.id)}\\n                        className={`inline-flex items-center gap-1.5 px-3.5 py-2 rounded-[0.5rem] text-[12px] font-semibold transition-colors whitespace-nowrap shrink-0 metr-focus ${\\n                          active\\n                            ? \'bg-[#0F766E] text-white\'\\n                            : \'text-[#B0C9E8] hover:text-white hover:bg-white/[0.06]\'\\n                        }`}\\n                      >\\n                        <Icon size={13} aria-hidden=\\\"true\\\" />\\n                        {tab.label}\\n                      </button>\\n                    );\\n                  })}\\n                </div>\\n\\n                {/* Tab Content */}\\n                <div className=\\\"p-5 sm:p-6 min-h-[380px] flex flex-col justify-between\\\">\\n                  <AnimatePresence mode=\\\"wait\\\">\\n                    <motion.div\\n                      key={activeTab}\\n                      initial={{ opacity: 0, y: 6 }}\\n                      animate={{ opacity: 1, y: 0 }}\\n                      exit={{ opacity: 0, y: -6 }}\\n                      transition={{ duration: 0.18 }}\\n                      className=\\\"space-y-4\\\"\\n                    >\\n                      <div className=\\\"flex flex-wrap items-center justify-between gap-2 text-[11px] font-semibold uppercase tracking-[0.06em] text-[#80D5CB]\\\">\\n                        <span>{currentTabData.headerLeft}</span>\\n                        <span>{currentTabData.headerRight}</span>\\n                      </div>\\n\\n                      <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                        {currentTabData.cards.map((card) => (\\n                          <div\\n                            key={card.title}\\n                            className=\\\"rounded-[0.75rem] bg-[#102A43]/70 border border-white/10 p-4 flex flex-col justify-between gap-3\\\"\\n                          >\\n                            <div className=\\\"space-y-1.5\\\">\\n                              <div className=\\\"flex items-center justify-between gap-2\\\">\\n                                <h3 className=\\\"font-[Manrope] text-[15px] font-bold text-white leading-snug\\\">\\n                                  {card.title}\\n                                </h3>\\n                                <span className=\\\"text-[10px] font-bold uppercase tracking-[0.06em] text-[#2DD4BF] whitespace-nowrap shrink-0\\\">\\n                                  {card.badge}\\n                                </span>\\n                              </div>\\n                              <p className=\\\"text-[13px] leading-[20px] text-[#D1E4FF]\\\">\\n                                {card.summary}\\n                              </p>\\n                            </div>\\n\\n                            <ul className=\\\"space-y-1.5 pt-2.5 border-t border-white/[0.08]\\\">\\n                              {card.highlights.map((item) => (\\n                                <li\\n                                  key={item}\\n                                  className=\\\"flex items-start gap-2 text-[12px] leading-[17px] text-[#B0C9E8]\\\"\\n                                >\\n                                  <CheckCircle2\\n                                    size={13}\\n                                    className=\\\"text-[#2DD4BF] mt-0.5 shrink-0\\\"\\n                                    aria-hidden=\\\"true\\\"\\n                                  />\\n                                  <span>{item}</span>\\n                                </li>\\n                              ))}\\n                            </ul>\\n                          </div>\\n                        ))}\\n                      </div>\\n                    </motion.div>\\n                  </AnimatePresence>\\n                </div>\\n              </div>\\n            </div>\\n          </div>\\n        </Reveal>\\n\\n        {/* Platform Reliability & Security Commitments Strip */}\\n        <Reveal delay={0.1}>\\n          <div className=\\\"mt-12 pt-10 border-t border-white/12\\\">\\n            <div className=\\\"flex flex-wrap items-baseline justify-between gap-4 mb-6\\\">\\n              <h3 className=\\\"font-[Manrope] text-[18px] font-bold text-white\\\">\\n                Platform Reliability & Security Commitments\\n              </h3>\\n              <p className=\\\"text-[12px] text-[#B0C9E8]\\\">\\n                Routinely verified through uptime checks, backup drills, and company privacy audits.\\n              </p>\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4\\\">\\n              {RELIABILITY_METRICS.map((metric) => (\\n                <div\\n                  key={metric.id}\\n                  className=\\\"rounded-[1rem] bg-[#0B1724] border border-white/10 p-4 flex flex-col justify-between gap-2\\\"\\n                >\\n                  <span className=\\\"text-[11px] font-bold uppercase tracking-[0.08em] text-[#80D5CB]\\\">\\n                    {metric.eyebrow}\\n                  </span>\\n                  <span className=\\\"font-[Manrope] font-tabular text-[22px] font-bold text-white leading-tight\\\">\\n                    {metric.value}\\n                  </span>\\n                  <span className=\\\"text-[12px] text-[#B0C9E8] leading-[17px]\\\">\\n                    {metric.detail}\\n                  </span>\\n                </div>\\n              ))}\\n            </div>\\n          </div>\\n        </Reveal>\\n      </div>\\n    </section>\\n  );\\n}\", \"StartLine\":1, \"TargetContent\":\"import React, { useState } from \'react\';\\nimport { AnimatePresence, motion } from \'motion/react\';\\nimport { Code2, Database, FolderTree, Lock, Server, ShieldCheck } from \'lucide-react\';\\nimport { Reveal } from \'@metr/ui\';\\nimport {\\n  MONOREPO_TREE,\\n  NFR_METRICS,\\n  SAMPLE_API_PAYLOAD,\\n  SQL_PATTERN_SNIPPET,\\n} from \'../data/metrContent\';\\n\\ntype SpecTab = \'sql\' | \'monorepo\' | \'api\' | \'security\';\\n\\nconst SECURITY_CONTROLS = [\\n  {\\n    title: \'Tenant & Legal Entity Scoping\',\\n    detail:\\n      \'Every tenant-owned row carries tenant_id derived strictly from authenticated server context, enforced with composite foreign keys (tenant_id, id) and optional PostgreSQL RLS.\',\\n  },\\n  {\\n    title: \'Deny-by-Default Authorization & Financial SoD\',\\n    detail:\\n      \'Server-side role + company + branch scope checks on every API action and export. Initiators cannot self-approve sensitive quotes, POs, vendor payments, or journals.\',\\n  },\\n  {\\n    title: \'Durable Transactional Outbox\',\\n    detail:\\n      \'Async side effects (emails, PDFs, webhook reconciliations) write to workflow.outbox_events in the same ACID transaction with idempotent event_key delivery.\',\\n  },\\n  {\\n    title: \'OWASP ASVS 5.0.0 L2 & NDPA 2023 Readiness\',\\n    detail:\\n      \'MFA for privileged approvers, KMS-managed secrets, signed short-lived S3 file URLs, masked payroll/bank identifiers, and append-only SHA-256 audit logs.\',\\n  },\\n];\\n\\nexport function ArchitectureTrustSection() {\\n  const [activeTab, setActiveTab] = useState<SpecTab>(\'sql\');\\n\\n  return (\\n    <section\\n      id=\\\"architecture\\\"\\n      className=\\\"bg-[#102A43] text-white border-b border-[#172B4D] py-16 lg:py-24\\\"\\n    >\\n      <div className=\\\"mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-12\\\">\\n        <Reveal>\\n          <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start\\\">\\n            {/* Left 5 Columns: Technical Identity & Architectural Layers */}\\n            <div className=\\\"lg:col-span-5 space-y-6\\\">\\n              <div>\\n                <p className=\\\"text-[11px] font-bold uppercase tracking-[0.08em] text-[#2DD4BF] mb-3\\\">\\n                  Technical Identity & Trust \302\267 Section B1\342\200\223B9\\n                </p>\\n                <h2 className=\\\"font-[Manrope] text-[28px] sm:text-[36px] lg:text-[40px] font-bold leading-[1.2] tracking-[-0.02em] text-white\\\">\\n                  Modular monolith discipline. Ledger-grade PostgreSQL core.\\n                </h2>\\n                <p className=\\\"mt-4 text-[15px] sm:text-[16px] leading-[26px] text-[#D1E4FF]\\\">\\n                  METR rejects premature microservice sprawl in favor of one transactional NestJS\\n                  backend with domain-enforced module boundaries, a Next.js + TypeScript web client,\\n                  and ACID PostgreSQL schemas.\\n                </p>\\n              </div>\\n\\n              {/* Clean Architectural Stack List */}\\n              <div className=\\\"rounded-[1rem] bg-[#0B1724] border border-white/10 divide-y divide-white/[0.08]\\\">\\n                {[\\n                  {\\n                    icon: Server,\\n                    layer: \'Web Client\',\\n                    stack: \'Next.js + TypeScript + Tailwind (apps/web + packages/ui)\',\\n                  },\\n                  {\\n                    icon: Code2,\\n                    layer: \'Application API\',\\n                    stack: \'NestJS Modular Monolith \302\267 REST /api/v1 \302\267 OpenAPI + Idempotency-Key\',\\n                  },\\n                  {\\n                    icon: Database,\\n                    layer: \'Relational Core\',\\n                    stack: \'PostgreSQL ACID \302\267 15 Domain Schemas \302\267 Transactional Outbox\',\\n                  },\\n                  {\\n                    icon: Lock,\\n                    layer: \'Files & Continuity\',\\n                    stack: \'Private Encrypted S3 Buckets \302\267 Signed URLs \302\267 Continuous WAL/PITR\',\\n                  },\\n                ].map((row) => {\\n                  const Icon = row.icon;\\n                  return (\\n                    <div key={row.layer} className=\\\"p-4 flex items-start gap-3.5\\\">\\n                      <span className=\\\"mt-0.5 inline-flex h-8 w-8 items-center justify-center rounded-[0.5rem] bg-[#102A43] border border-white/10 text-[#2DD4BF] shrink-0\\\">\\n                        <Icon size={16} aria-hidden=\\\"true\\\" />\\n                      </span>\\n                      <div>\\n                        <div className=\\\"text-[13px] font-semibold text-white\\\">{row.layer}</div>\\n                        <div className=\\\"text-[13px] text-[#B0C9E8] mt-0.5 leading-[20px]\\\">\\n                          {row.stack}\\n                        </div>\\n                      </div>\\n                    </div>\\n                  );\\n                })}\\n              </div>\\n            </div>\\n\\n            {/* Right 7 Columns: Dark Surface Code & Contract Inspector */}\\n            <div className=\\\"lg:col-span-7\\\">\\n              <div className=\\\"rounded-[1.25rem] bg-[#0B1724] border border-white/12 overflow-hidden\\\">\\n                {/* Tab Bar */}\\n                <div\\n                  role=\\\"tablist\\\"\\n                  aria-label=\\\"Technical specification views\\\"\\n                  className=\\\"flex flex-wrap items-center gap-1 p-2.5 bg-[#08121D] border-b border-white/10\\\"\\n                >\\n                  {[\\n                    { id: \'sql\' as const, label: \'SQL Ledger Pattern\', icon: Database },\\n                    { id: \'monorepo\' as const, label: \'Monorepo Structure\', icon: FolderTree },\\n                    { id: \'api\' as const, label: \'API Payload (D5)\', icon: Code2 },\\n                    { id: \'security\' as const, label: \'Security Controls\', icon: ShieldCheck },\\n                  ].map((tab) => {\\n                    const Icon = tab.icon;\\n                    const active = activeTab === tab.id;\\n                    return (\\n                      <button\\n                        key={tab.id}\\n                        type=\\\"button\\\"\\n                        role=\\\"tab\\\"\\n                        aria-selected={active}\\n                        onClick={() => setActiveTab(tab.id)}\\n                        className={`inline-flex items-center gap-1.5 px-3.5 py-2 rounded-[0.5rem] text-[12px] font-semibold transition-colors whitespace-nowrap shrink-0 metr-focus ${\\n                          active\\n                            ? \'bg-[#0F766E] text-white\'\\n                            : \'text-[#B0C9E8] hover:text-white hover:bg-white/[0.06]\'\\n                        }`}\\n                      >\\n                        <Icon size={13} aria-hidden=\\\"true\\\" />\\n                        {tab.label}\\n                      </button>\\n                    );\\n                  })}\\n                </div>\\n\\n                {/* Tab Content */}\\n                <div className=\\\"p-5 sm:p-6 min-h-[360px] flex flex-col justify-between\\\">\\n                  <AnimatePresence mode=\\\"wait\\\">\\n                    {activeTab === \'sql\' && (\\n                      <motion.div\\n                        key=\\\"sql\\\"\\n                        initial={{ opacity: 0, y: 6 }}\\n                        animate={{ opacity: 1, y: 0 }}\\n                        exit={{ opacity: 0, y: -6 }}\\n                        transition={{ duration: 0.18 }}\\n                        className=\\\"space-y-3\\\"\\n                      >\\n                        <div className=\\\"flex items-center justify-between text-[11px] font-mono text-[#80D5CB]\\\">\\n                          <span>database/migrations/0012_finance_ledger.sql</span>\\n                          <span>PostgreSQL 18 \302\267 numeric(20,4)</span>\\n                        </div>\\n                        <pre className=\\\"font-mono text-[12px] sm:text-[13px] leading-[21px] text-[#EDF0FF] overflow-x-auto p-4 rounded-[0.75rem] bg-[#102A43]/60 border border-white/[0.08]\\\">\\n                          <code>{SQL_PATTERN_SNIPPET}</code>\\n                        </pre>\\n                      </motion.div>\\n                    )}\\n\\n                    {activeTab === \'monorepo\' && (\\n                      <motion.div\\n                        key=\\\"monorepo\\\"\\n                        initial={{ opacity: 0, y: 6 }}\\n                        animate={{ opacity: 1, y: 0 }}\\n                        exit={{ opacity: 0, y: -6 }}\\n                        transition={{ duration: 0.18 }}\\n                        className=\\\"space-y-3\\\"\\n                      >\\n                        <div className=\\\"flex items-center justify-between text-[11px] font-mono text-[#80D5CB]\\\">\\n                          <span>Section B3 \302\267 Repository Conventions</span>\\n                          <span>Workspace Packages</span>\\n                        </div>\\n                        <pre className=\\\"font-mono text-[12px] sm:text-[13px] leading-[22px] text-[#EDF0FF] overflow-x-auto p-4 rounded-[0.75rem] bg-[#102A43]/60 border border-white/[0.08]\\\">\\n                          <code>{MONOREPO_TREE}</code>\\n                        </pre>\\n                      </motion.div>\\n                    )}\\n\\n                    {activeTab === \'api\' && (\\n                      <motion.div\\n                        key=\\\"api\\\"\\n                        initial={{ opacity: 0, y: 6 }}\\n                        animate={{ opacity: 1, y: 0 }}\\n                        exit={{ opacity: 0, y: -6 }}\\n                        transition={{ duration: 0.18 }}\\n                        className=\\\"space-y-3\\\"\\n                      >\\n                        <div className=\\\"flex items-center justify-between text-[11px] font-mono text-[#80D5CB]\\\">\\n                          <span>Section D5 \302\267 Versioned Quote Creation</span>\\n                          <span>Decimal Strings \302\267 ISO-4217</span>\\n                        </div>\\n                        <pre className=\\\"font-mono text-[12px] sm:text-[13px] leading-[21px] text-[#EDF0FF] overflow-x-auto p-4 rounded-[0.75rem] bg-[#102A43]/60 border border-white/[0.08]\\\">\\n                          <code>{SAMPLE_API_PAYLOAD}</code>\\n                        </pre>\\n                      </motion.div>\\n                    )}\\n\\n                    {activeTab === \'security\' && (\\n                      <motion.div\\n                        key=\\\"security\\\"\\n                        initial={{ opacity: 0, y: 6 }}\\n                        animate={{ opacity: 1, y: 0 }}\\n                        exit={{ opacity: 0, y: -6 }}\\n                        transition={{ duration: 0.18 }}\\n                        className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\"\\n                      >\\n                        {SECURITY_CONTROLS.map((ctrl) => (\\n                          <div\\n                            key={ctrl.title}\\n                            className=\\\"rounded-[0.75rem] bg-[#102A43]/70 border border-white/10 p-4 space-y-2\\\"\\n                          >\\n                            <h3 className=\\\"font-[Manrope] text-[15px] font-bold text-white\\\">\\n                              {ctrl.title}\\n                            </h3>\\n                            <p className=\\\"text-[13px] leading-[20px] text-[#D1E4FF]\\\">\\n                              {ctrl.detail}\\n                            </p>\\n                          </div>\\n                        ))}\\n                      </motion.div>\\n                    )}\\n                  </AnimatePresence>\\n                </div>\\n              </div>\\n            </div>\\n          </div>\\n        </Reveal>\\n\\n        {/* Non-Functional Requirements & Design SLO Strip (Section B9) */}\\n        <Reveal delay={0.1}>\\n          <div className=\\\"mt-12 pt-10 border-t border-white/12\\\">\\n            <div className=\\\"flex flex-wrap items-baseline justify-between gap-4 mb-6\\\">\\n              <h3 className=\\\"font-[Manrope] text-[18px] font-bold text-white\\\">\\n                Target Non-Functional Engineering Baselines (Section B9)\\n              </h3>\\n              <p className=\\\"text-[12px] text-[#B0C9E8]\\\">\\n                Design targets validated through load, PITR recovery, and automated boundary suites.\\n              </p>\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4\\\">\\n              {NFR_METRICS.map((metric) => (\\n                <div\\n                  key={metric.id}\\n                  className=\\\"rounded-[1rem] bg-[#0B1724] border border-white/10 p-4 flex flex-col justify-between gap-2\\\"\\n                >\\n                  <span className=\\\"text-[11px] font-bold uppercase tracking-[0.08em] text-[#80D5CB]\\\">\\n                    {metric.eyebrow}\\n                  </span>\\n                  <span className=\\\"font-[Manrope] font-tabular text-[22px] font-bold text-white leading-tight\\\">\\n                    {metric.value}\\n                  </span>\\n                  <span className=\\\"text-[12px] text-[#B0C9E8] leading-[17px]\\\">\\n                    {metric.detail}\\n                  </span>\\n                </div>\\n              ))}\\n            </div>\\n          </div>\\n        </Reveal>\\n      </div>\\n    </section>\\n  );\\n}\", \"TargetFile\":\"/apps/web/src/components/ArchitectureTrustSection.tsx\", \"toolAction\":\"Updating ArchitectureTrustSection to business controls\", \"toolSummary\":\"Update ArchitectureTrustSection.tsx\"}"
      thinking_signature: "\022\313\002\n\310\002\001i\024}\023\304\234|\207\004Qs\330\016_\275\231\355\264\236wF14Bj\365\\\005\rk\230\361\"\026\245\214\266aX+\302\033k\001\024\210\271\016\002H\031q\025\006\371\335\337\n\"\b\243\252\304\b\217\306C\374x\374\257FI\247X\272\342\362%\240\307\262Jf9\343\036\312\243\340\240.\334\262\253\037\352\250\247\2305\303\312P\273A\031\024t\215\226\021\242\021jk\253\316\357\025\354\332\226\261\237\271\360\331\312\335C\242*mb\325\217\0032\366H]1$\357\236z\361g\205B\243+\245 \224\371\343\331\002\222Y*^\250\217d\374\246\037i\315\320\335a\316p\273\217\373\320\217\353\330\317\255\237\347\311\2476\307\225\336\241\241)b+\243.Dp\274\304\317\270C\216\262\376\001\243\330G23i|\212)\213\fN&\250\234\246\250\274\r\001\375\321\351\331\266?\021\350\227\331*<\305\203k\006\360\372V\332W\261\034\346\017Ub\271\351\373\315R\202\272\242\3234\233\204\302\017U\261<\251\321t\272\277\3463\237N_\266\300\216\234\244q\343H!\312\226\250\205*fhn\276\265Q\201\301e\n\342\221\024\bl\363Wk\233\315\206Hu\262Wid"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_10801445585565164562"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Remove PDF section codes, M0-M5 codes, and engineering jargon from RoadmapSection\", \"EndLine\":237, \"Instruction\":\"Update RoadmapSection headings, view toggles, milestone step numbers (01-06 instead of M0-M5), and step-by-step timeline labels into clear customer-facing rollout terminology.\", \"ReplacementContent\":\"import React, { useState } from \'react\';\\nimport { AnimatePresence, motion } from \'motion/react\';\\nimport { CheckCircle2, ClipboardCheck, ShieldCheck } from \'lucide-react\';\\nimport { PhaseBadge, Reveal } from \'@metr/ui\';\\nimport { ROADMAP_MILESTONES, VERTICAL_SLICES } from \'../data/metrContent\';\\n\\ntype RoadmapView = \'milestones\' | \'slices\';\\n\\nexport function RoadmapSection() {\\n  const [view, setView] = useState<RoadmapView>(\'milestones\');\\n  const [activeMilestoneId, setActiveMilestoneId] = useState<string>(\'m2\');\\n\\n  const activeMilestone =\\n    ROADMAP_MILESTONES.find((m) => m.id === activeMilestoneId) ?? ROADMAP_MILESTONES[0];\\n\\n  return (\\n    <section id=\\\"roadmap\\\" className=\\\"bg-white border-b border-[#E5EBF0] py-16 lg:py-24\\\">\\n      <div className=\\\"mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-12\\\">\\n        <Reveal>\\n          <div className=\\\"flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-10\\\">\\n            <div className=\\\"max-w-2xl\\\">\\n              <p className=\\\"text-[11px] font-bold uppercase tracking-[0.08em] text-[#0F766E] mb-3\\\">\\n                Phased Rollout Plan\\n              </p>\\n              <h2 className=\\\"font-[Manrope] text-[28px] sm:text-[36px] lg:text-[40px] font-bold leading-[1.2] tracking-[-0.02em] text-[#102A43]\\\">\\n                Start with core finance. Expand smoothly as you grow.\\n              </h2>\\n              <p className=\\\"mt-3 text-[15px] sm:text-[16px] leading-[26px] text-[#526579]\\\">\\n                METR rolls out in complete, ready-to-use business stages\342\200\224so your team goes live\\n                with sales and accounting first before activating purchasing, delivery, and HR.\\n              </p>\\n            </div>\\n\\n            <div\\n              role=\\\"group\\\"\\n              aria-label=\\\"Roadmap view mode\\\"\\n              className=\\\"inline-flex items-center gap-1 rounded-[0.75rem] bg-[#F5F7FA] p-1 border border-[#D7E0E8] self-start lg:self-auto\\\"\\n            >\\n              <button\\n                type=\\\"button\\\"\\n                aria-pressed={view === \'milestones\'}\\n                onClick={() => setView(\'milestones\')}\\n                className={`px-3.5 py-2 rounded-[0.5rem] text-[13px] font-semibold transition-colors whitespace-nowrap shrink-0 metr-focus ${\\n                  view === \'milestones\'\\n                    ? \'bg-white text-[#102A43] shadow-[0_1px_2px_rgba(16,42,69,0.08)]\'\\n                    : \'text-[#526579] hover:text-[#172B4D]\'\\n                }`}\\n              >\\n                Rollout Stages\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                aria-pressed={view === \'slices\'}\\n                onClick={() => setView(\'slices\')}\\n                className={`px-3.5 py-2 rounded-[0.5rem] text-[13px] font-semibold transition-colors whitespace-nowrap shrink-0 metr-focus ${\\n                  view === \'slices\'\\n                    ? \'bg-white text-[#102A43] shadow-[0_1px_2px_rgba(16,42,69,0.08)]\'\\n                    : \'text-[#526579] hover:text-[#172B4D]\'\\n                }`}\\n              >\\n                Step-by-Step Timeline\\n              </button>\\n            </div>\\n          </div>\\n        </Reveal>\\n\\n        <AnimatePresence mode=\\\"wait\\\">\\n          {view === \'milestones\' ? (\\n            <motion.div\\n              key=\\\"milestones\\\"\\n              initial={{ opacity: 0, y: 10 }}\\n              animate={{ opacity: 1, y: 0 }}\\n              exit={{ opacity: 0, y: -6 }}\\n              transition={{ duration: 0.22 }}\\n              className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\\\"\\n            >\\n              {/* Left 5 Columns: Sequenced Stage Rail */}\\n              <div\\n                className=\\\"lg:col-span-5 flex flex-col gap-3\\\"\\n                role=\\\"tablist\\\"\\n                aria-label=\\\"Rollout stages\\\"\\n              >\\n                {ROADMAP_MILESTONES.map((ms) => {\\n                  const isActive = ms.id === activeMilestone.id;\\n                  return (\\n                    <button\\n                      key={ms.id}\\n                      type=\\\"button\\\"\\n                      role=\\\"tab\\\"\\n                      aria-selected={isActive}\\n                      onClick={() => setActiveMilestoneId(ms.id)}\\n                      className={`w-full text-left rounded-[0.875rem] p-4 border transition-all duration-150 metr-focus flex items-center justify-between gap-4 ${\\n                        isActive\\n                          ? \'bg-[#F5F7FA] border-[#0F766E] shadow-[0_4px_12px_rgba(16,42,69,0.06)]\'\\n                          : \'bg-white border-[#D7E0E8] hover:border-[#0F766E]/40 hover:bg-[#F5F7FA]/50\'\\n                      }`}\\n                    >\\n                      <div className=\\\"flex items-center gap-3.5 min-w-0\\\">\\n                        <span\\n                          className={`inline-flex h-10 w-10 items-center justify-center rounded-[0.5rem] font-tabular text-[13px] font-bold shrink-0 ${\\n                            isActive\\n                              ? \'bg-[#0F766E] text-white\'\\n                              : \'bg-[#102A43]/[0.06] text-[#102A43]\'\\n                          }`}\\n                        >\\n                          {ms.stepNumber}\\n                        </span>\\n                        <div className=\\\"min-w-0\\\">\\n                          <div\\n                            className={`font-[Manrope] text-[16px] font-bold truncate ${\\n                              isActive ? \'text-[#0F766E]\' : \'text-[#102A43]\'\\n                            }`}\\n                          >\\n                            {ms.title}\\n                          </div>\\n                          <div className=\\\"text-[12px] text-[#526579] mt-0.5\\\">\\n                            {ms.deliverables.length} key capabilities\\n                          </div>\\n                        </div>\\n                      </div>\\n                      <PhaseBadge phase={ms.phase} />\\n                    </button>\\n                  );\\n                })}\\n              </div>\\n\\n              {/* Right 7 Columns: Selected Stage Highlights Card */}\\n              <div className=\\\"lg:col-span-7\\\">\\n                <AnimatePresence mode=\\\"wait\\\">\\n                  <motion.div\\n                    key={activeMilestone.id}\\n                    initial={{ opacity: 0, y: 8 }}\\n                    animate={{ opacity: 1, y: 0 }}\\n                    exit={{ opacity: 0, y: -6 }}\\n                    transition={{ duration: 0.2, ease: [0.16, 1, 0.3, 1] }}\\n                    className=\\\"metr-card rounded-[1.25rem] p-6 sm:p-8 space-y-6\\\"\\n                  >\\n                    <div className=\\\"flex flex-wrap items-center justify-between gap-3 pb-5 border-b border-[#E5EBF0]\\\">\\n                      <div>\\n                        <span className=\\\"text-[12px] font-semibold uppercase tracking-[0.06em] text-[#0F766E]\\\">\\n                          Stage {activeMilestone.stepNumber}\\n                        </span>\\n                        <h3 className=\\\"font-[Manrope] text-[24px] sm:text-[28px] font-bold text-[#102A43] mt-0.5\\\">\\n                          {activeMilestone.title}\\n                        </h3>\\n                      </div>\\n                      <PhaseBadge phase={activeMilestone.phase} />\\n                    </div>\\n\\n                    <div className=\\\"space-y-3\\\">\\n                      <h4 className=\\\"text-[11px] font-bold uppercase tracking-[0.08em] text-[#526579]\\\">\\n                        What Your Team Gets\\n                      </h4>\\n                      <ul className=\\\"space-y-3\\\">\\n                        {activeMilestone.deliverables.map((item) => (\\n                          <li\\n                            key={item}\\n                            className=\\\"flex items-start gap-3 text-[15px] leading-[24px] text-[#172B4D]\\\"\\n                          >\\n                            <CheckCircle2\\n                              size={18}\\n                              className=\\\"text-[#0F766E] mt-0.5 shrink-0\\\"\\n                              aria-hidden=\\\"true\\\"\\n                            />\\n                            <span>{item}</span>\\n                          </li>\\n                        ))}\\n                      </ul>\\n                    </div>\\n\\n                    <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2\\\">\\n                      <div className=\\\"rounded-[0.75rem] bg-[#F5F7FA] border border-[#E5EBF0] p-4 space-y-1.5\\\">\\n                        <div className=\\\"flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-[0.08em] text-[#102A43]\\\">\\n                          <ClipboardCheck size={14} className=\\\"text-[#0F766E]\\\" aria-hidden=\\\"true\\\" />\\n                          <span>How You\342\200\231ll See It Working</span>\\n                        </div>\\n                        <p className=\\\"text-[13px] leading-[20px] text-[#3E4947]\\\">\\n                          {activeMilestone.reviewEvidence}\\n                        </p>\\n                      </div>\\n\\n                      <div className=\\\"rounded-[0.75rem] bg-[#F5F7FA] border border-[#E5EBF0] p-4 space-y-1.5\\\">\\n                        <div className=\\\"flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-[0.08em] text-[#102A43]\\\">\\n                          <ShieldCheck size={14} className=\\\"text-[#0F766E]\\\" aria-hidden=\\\"true\\\" />\\n                          <span>Go-Live Readiness Check</span>\\n                        </div>\\n                        <p className=\\\"text-[13px] leading-[20px] text-[#3E4947]\\\">\\n                          {activeMilestone.exitGate}\\n                        </p>\\n                      </div>\\n                    </div>\\n                  </motion.div>\\n                </AnimatePresence>\\n              </div>\\n            </motion.div>\\n          ) : (\\n            <motion.div\\n              key=\\\"slices\\\"\\n              initial={{ opacity: 0, y: 10 }}\\n              animate={{ opacity: 1, y: 0 }}\\n              exit={{ opacity: 0, y: -6 }}\\n              transition={{ duration: 0.22 }}\\n              className=\\\"metr-card rounded-[1rem] overflow-hidden\\\"\\n            >\\n              <div className=\\\"overflow-x-auto\\\">\\n                <table className=\\\"w-full text-left border-collapse\\\">\\n                  <thead>\\n                    <tr className=\\\"bg-[#F5F7FA] border-b border-[#D7E0E8] text-[11px] font-bold uppercase tracking-[0.08em] text-[#526579]\\\">\\n                      <th className=\\\"py-3.5 px-5 w-28\\\">Stage</th>\\n                      <th className=\\\"py-3.5 px-5\\\">Business Capability Delivered</th>\\n                      <th className=\\\"py-3.5 px-5\\\">Readiness Milestone</th>\\n                      <th className=\\\"py-3.5 px-5 text-right\\\">Phase</th>\\n                    </tr>\\n                  </thead>\\n                  <tbody className=\\\"divide-y divide-[#E5EBF0] text-[14px]\\\">\\n                    {VERTICAL_SLICES.map((slice) => (\\n                      <tr key={slice.sequence} className=\\\"hover:bg-[#F5F7FA]/60 transition-colors\\\">\\n                        <td className=\\\"py-4 px-5 font-tabular font-bold text-[#0F766E] whitespace-nowrap\\\">\\n                          Stage 0{slice.sequence}\\n                        </td>\\n                        <td className=\\\"py-4 px-5 font-medium text-[#172B4D]\\\">\\n                          {slice.outcome}\\n                        </td>\\n                        <td className=\\\"py-4 px-5 text-[#526579]\\\">{slice.exitGate}</td>\\n                        <td className=\\\"py-4 px-5 text-right\\\">\\n                          <PhaseBadge phase={slice.phase} />\\n                        </td>\\n                      </tr>\\n                    ))}\\n                  </tbody>\\n                </table>\\n              </div>\\n            </motion.div>\\n          )}\\n        </AnimatePresence>\\n      </div>\\n    </section>\\n  );\\n}\", \"StartLine\":1, \"TargetContent\":\"import React, { useState } from \'react\';\\nimport { AnimatePresence, motion } from \'motion/react\';\\nimport { CheckCircle2, ClipboardCheck, ShieldCheck } from \'lucide-react\';\\nimport { PhaseBadge, Reveal } from \'@metr/ui\';\\nimport { ROADMAP_MILESTONES, VERTICAL_SLICES } from \'../data/metrContent\';\\n\\ntype RoadmapView = \'milestones\' | \'slices\';\\n\\nexport function RoadmapSection() {\\n  const [view, setView] = useState<RoadmapView>(\'milestones\');\\n  const [activeMilestoneId, setActiveMilestoneId] = useState<string>(\'m2\');\\n\\n  const activeMilestone =\\n    ROADMAP_MILESTONES.find((m) => m.id === activeMilestoneId) ?? ROADMAP_MILESTONES[0];\\n\\n  return (\\n    <section id=\\\"roadmap\\\" className=\\\"bg-white border-b border-[#E5EBF0] py-16 lg:py-24\\\">\\n      <div className=\\\"mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-12\\\">\\n        <Reveal>\\n          <div className=\\\"flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-10\\\">\\n            <div className=\\\"max-w-2xl\\\">\\n              <p className=\\\"text-[11px] font-bold uppercase tracking-[0.08em] text-[#0F766E] mb-3\\\">\\n                Sequenced Delivery Plan \302\267 Section D1 & D2\\n              </p>\\n              <h2 className=\\\"font-[Manrope] text-[28px] sm:text-[36px] lg:text-[40px] font-bold leading-[1.2] tracking-[-0.02em] text-[#102A43]\\\">\\n                Vertical slices before breadth. Proven GL before expansion.\\n              </h2>\\n              <p className=\\\"mt-3 text-[15px] sm:text-[16px] leading-[26px] text-[#526579]\\\">\\n                METR ships complete end-to-end user journeys\342\200\224UI, API, server-side authorization,\\n                migrations, outbox events, and audit tests\342\200\224gated by explicit business sign-offs.\\n              </p>\\n            </div>\\n\\n            <div\\n              role=\\\"group\\\"\\n              aria-label=\\\"Roadmap view mode\\\"\\n              className=\\\"inline-flex items-center gap-1 rounded-[0.75rem] bg-[#F5F7FA] p-1 border border-[#D7E0E8] self-start lg:self-auto\\\"\\n            >\\n              <button\\n                type=\\\"button\\\"\\n                aria-pressed={view === \'milestones\'}\\n                onClick={() => setView(\'milestones\')}\\n                className={`px-3.5 py-2 rounded-[0.5rem] text-[13px] font-semibold transition-colors whitespace-nowrap shrink-0 metr-focus ${\\n                  view === \'milestones\'\\n                    ? \'bg-white text-[#102A43] shadow-[0_1px_2px_rgba(16,42,69,0.08)]\'\\n                    : \'text-[#526579] hover:text-[#172B4D]\'\\n                }`}\\n              >\\n                Release Milestones (M0\342\200\223M5)\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                aria-pressed={view === \'slices\'}\\n                onClick={() => setView(\'slices\')}\\n                className={`px-3.5 py-2 rounded-[0.5rem] text-[13px] font-semibold transition-colors whitespace-nowrap shrink-0 metr-focus ${\\n                  view === \'slices\'\\n                    ? \'bg-white text-[#102A43] shadow-[0_1px_2px_rgba(16,42,69,0.08)]\'\\n                    : \'text-[#526579] hover:text-[#172B4D]\'\\n                }`}\\n              >\\n                Vertical Slices (0\342\200\2237)\\n              </button>\\n            </div>\\n          </div>\\n        </Reveal>\\n\\n        <AnimatePresence mode=\\\"wait\\\">\\n          {view === \'milestones\' ? (\\n            <motion.div\\n              key=\\\"milestones\\\"\\n              initial={{ opacity: 0, y: 10 }}\\n              animate={{ opacity: 1, y: 0 }}\\n              exit={{ opacity: 0, y: -6 }}\\n              transition={{ duration: 0.22 }}\\n              className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\\\"\\n            >\\n              {/* Left 5 Columns: Sequenced Milestone Rail */}\\n              <div\\n                className=\\\"lg:col-span-5 flex flex-col gap-3\\\"\\n                role=\\\"tablist\\\"\\n                aria-label=\\\"Release milestones\\\"\\n              >\\n                {ROADMAP_MILESTONES.map((ms) => {\\n                  const isActive = ms.id === activeMilestone.id;\\n                  return (\\n                    <button\\n                      key={ms.id}\\n                      type=\\\"button\\\"\\n                      role=\\\"tab\\\"\\n                      aria-selected={isActive}\\n                      onClick={() => setActiveMilestoneId(ms.id)}\\n                      className={`w-full text-left rounded-[0.875rem] p-4 border transition-all duration-150 metr-focus flex items-center justify-between gap-4 ${\\n                        isActive\\n                          ? \'bg-[#F5F7FA] border-[#0F766E] shadow-[0_4px_12px_rgba(16,42,69,0.06)]\'\\n                          : \'bg-white border-[#D7E0E8] hover:border-[#0F766E]/40 hover:bg-[#F5F7FA]/50\'\\n                      }`}\\n                    >\\n                      <div className=\\\"flex items-center gap-3.5 min-w-0\\\">\\n                        <span\\n                          className={`inline-flex h-10 w-10 items-center justify-center rounded-[0.5rem] font-mono text-[13px] font-bold shrink-0 ${\\n                            isActive\\n                              ? \'bg-[#0F766E] text-white\'\\n                              : \'bg-[#102A43]/[0.06] text-[#102A43]\'\\n                          }`}\\n                        >\\n                          {ms.code}\\n                        </span>\\n                        <div className=\\\"min-w-0\\\">\\n                          <div\\n                            className={`font-[Manrope] text-[16px] font-bold truncate ${\\n                              isActive ? \'text-[#0F766E]\' : \'text-[#102A43]\'\\n                            }`}\\n                          >\\n                            {ms.title}\\n                          </div>\\n                          <div className=\\\"text-[12px] text-[#526579] mt-0.5\\\">\\n                            {ms.deliverables.length} core deliverables\\n                          </div>\\n                        </div>\\n                      </div>\\n                      <PhaseBadge phase={ms.phase} />\\n                    </button>\\n                  );\\n                })}\\n              </div>\\n\\n              {/* Right 7 Columns: Selected Milestone Evidence & Deliverables Card */}\\n              <div className=\\\"lg:col-span-7\\\">\\n                <AnimatePresence mode=\\\"wait\\\">\\n                  <motion.div\\n                    key={activeMilestone.id}\\n                    initial={{ opacity: 0, y: 8 }}\\n                    animate={{ opacity: 1, y: 0 }}\\n                    exit={{ opacity: 0, y: -6 }}\\n                    transition={{ duration: 0.2, ease: [0.16, 1, 0.3, 1] }}\\n                    className=\\\"metr-card rounded-[1.25rem] p-6 sm:p-8 space-y-6\\\"\\n                  >\\n                    <div className=\\\"flex flex-wrap items-center justify-between gap-3 pb-5 border-b border-[#E5EBF0]\\\">\\n                      <div>\\n                        <span className=\\\"font-mono text-[12px] font-semibold text-[#0F766E]\\\">\\n                          Release {activeMilestone.code}\\n                        </span>\\n                        <h3 className=\\\"font-[Manrope] text-[24px] sm:text-[28px] font-bold text-[#102A43] mt-0.5\\\">\\n                          {activeMilestone.title}\\n                        </h3>\\n                      </div>\\n                      <PhaseBadge phase={activeMilestone.phase} />\\n                    </div>\\n\\n                    <div className=\\\"space-y-3\\\">\\n                      <h4 className=\\\"text-[11px] font-bold uppercase tracking-[0.08em] text-[#526579]\\\">\\n                        Engineering Deliverables\\n                      </h4>\\n                      <ul className=\\\"space-y-3\\\">\\n                        {activeMilestone.deliverables.map((item) => (\\n                          <li key={item} className=\\\"flex items-start gap-3 text-[15px] leading-[24px] text-[#172B4D]\\\">\\n                            <CheckCircle2\\n                              size={18}\\n                              className=\\\"text-[#0F766E] mt-0.5 shrink-0\\\"\\n                              aria-hidden=\\\"true\\\"\\n                            />\\n                            <span>{item}</span>\\n                          </li>\\n                        ))}\\n                      </ul>\\n                    </div>\\n\\n                    <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2\\\">\\n                      <div className=\\\"rounded-[0.75rem] bg-[#F5F7FA] border border-[#E5EBF0] p-4 space-y-1.5\\\">\\n                        <div className=\\\"flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-[0.08em] text-[#102A43]\\\">\\n                          <ClipboardCheck size={14} className=\\\"text-[#0F766E]\\\" aria-hidden=\\\"true\\\" />\\n                          <span>Business Review Evidence</span>\\n                        </div>\\n                        <p className=\\\"text-[13px] leading-[20px] text-[#3E4947]\\\">\\n                          {activeMilestone.reviewEvidence}\\n                        </p>\\n                      </div>\\n\\n                      <div className=\\\"rounded-[0.75rem] bg-[#F5F7FA] border border-[#E5EBF0] p-4 space-y-1.5\\\">\\n                        <div className=\\\"flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-[0.08em] text-[#102A43]\\\">\\n                          <ShieldCheck size={14} className=\\\"text-[#0F766E]\\\" aria-hidden=\\\"true\\\" />\\n                          <span>Quality Exit Gate</span>\\n                        </div>\\n                        <p className=\\\"text-[13px] leading-[20px] text-[#3E4947]\\\">\\n                          {activeMilestone.exitGate}\\n                        </p>\\n                      </div>\\n                    </div>\\n                  </motion.div>\\n                </AnimatePresence>\\n              </div>\\n            </motion.div>\\n          ) : (\\n            <motion.div\\n              key=\\\"slices\\\"\\n              initial={{ opacity: 0, y: 10 }}\\n              animate={{ opacity: 1, y: 0 }}\\n              exit={{ opacity: 0, y: -6 }}\\n              transition={{ duration: 0.22 }}\\n              className=\\\"metr-card rounded-[1rem] overflow-hidden\\\"\\n            >\\n              <div className=\\\"overflow-x-auto\\\">\\n                <table className=\\\"w-full text-left border-collapse\\\">\\n                  <thead>\\n                    <tr className=\\\"bg-[#F5F7FA] border-b border-[#D7E0E8] text-[11px] font-bold uppercase tracking-[0.08em] text-[#526579]\\\">\\n                      <th className=\\\"py-3.5 px-5 w-24\\\">Sequence</th>\\n                      <th className=\\\"py-3.5 px-5\\\">Vertical Slice / Outcome</th>\\n                      <th className=\\\"py-3.5 px-5\\\">Exit Gate</th>\\n                      <th className=\\\"py-3.5 px-5 text-right\\\">Phase</th>\\n                    </tr>\\n                  </thead>\\n                  <tbody className=\\\"divide-y divide-[#E5EBF0] text-[14px]\\\">\\n                    {VERTICAL_SLICES.map((slice) => (\\n                      <tr key={slice.sequence} className=\\\"hover:bg-[#F5F7FA]/60 transition-colors\\\">\\n                        <td className=\\\"py-4 px-5 font-mono font-tabular font-bold text-[#0F766E]\\\">\\n                          Slice 0{slice.sequence}\\n                        </td>\\n                        <td className=\\\"py-4 px-5 font-medium text-[#172B4D]\\\">\\n                          {slice.outcome}\\n                        </td>\\n                        <td className=\\\"py-4 px-5 text-[#526579]\\\">{slice.exitGate}</td>\\n                        <td className=\\\"py-4 px-5 text-right\\\">\\n                          <PhaseBadge phase={slice.phase} />\\n                        </td>\\n                      </tr>\\n                    ))}\\n                  </tbody>\\n                </table>\\n              </div>\\n            </motion.div>\\n          )}\\n        </AnimatePresence>\\n      </div>\\n    </section>\\n  );\\n}\", \"TargetFile\":\"/apps/web/src/components/RoadmapSection.tsx\", \"toolAction\":\"Updating RoadmapSection to business language\", \"toolSummary\":\"Update RoadmapSection.tsx\"}"
