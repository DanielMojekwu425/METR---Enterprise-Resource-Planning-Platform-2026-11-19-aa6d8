      thinking_signature: "\022\361\006\n\356\006\001i\024}\023ZO\361\207\2314\033c\266\306i\340\000\206=x=\021\241!z*x\226h\027\256\224\320\326\000`\313S\271\33356\327dV\332z\354t\223Q\0003\245\333\256pG\006\350\\\023L\201B\277G\234\0000\371\206VB\370\325\343\352l\267j,\214\352\020\305\262&\214o\37160\270\"z\336\273\360<\222\342\363\374\"V\b[\353\271\027Xm\272\\{\357\323\260\315t\261\377\356\313\364B^R\231\267\350\223e\301\331D\034\240\321\207\313\346\366 \330x\362\033\352\236\354P\224-\225z\356\367N\245t\001z\305\237\226\2424\367U\0339\354\277\257\305\232\346\344\357\027\312y\021\3306\226\221\301\030\206\241\256&9\t\245\357\240;\323\246\024\343\003\023`\004\373rN4\370\214n\rv\306\246\253)\027\316\377\2462K\177\316\351*\344pU\326_\351rR Q\342-Y\016\236&\212\264\300C\203\017;\2568\265\240\300|\270.\377Y\235\243\020\302\aU\243->\331\235\321DV~)\265S\223\364\223\227\316\372~\332\2620\322(\341\b\220Z\216\270\274\244\360w?\357\255\234/\022\242h-xk\232@\266\210\374\"\001\330\330\237\257\023\302\322\224\327k\235]t\337i\352\210\356\237\216\300\262)\002!\006B!kJ\321\311\210\341\341up\034\243\200\251\223\327\324K\031\300\240\035\343\347b\355}\320\225Q\025k\342\2064\006dw\264\3007\327\244\202\vv\2316\305hX\305;\240V\006\244\246\n\360e\344\354:\267\363=`l\237qo`\235\277 k\314\376\275\366\000\241\326\237\210\210\314O!\225\260g\342q\024\336\363\2612\247m\021\352FM\305C@|)\0366Z-\315\313\353\024P\037;\005-:\360\004b\f\240\343\364\237\227\266F\264vF\263\305\352*\025~*\217;\022G\002{\034\335\204\356\025\315\242\331\n\201\036\232\\\216\212\227\255>\272\035\255\251B\335t\2036@\330?\\\032\352\a\326\347\351\305\303(\206\204\353qPN?\033\316\354\b\256xU\034\263~\030\253\304=&g \322=6Y\221\005\267\340{\343\264\022\340\003\240\375J\2263\322d\216\256\332\241s\364!\244\033X\3631\373\324\177\274\200\370\354\3649\034v\334\244\021\362^\326{\304\000\261\030\337D\253\320\371b \t\266k\032dp\365J\225\241\362\246r\207\234\254\006\031\224c\032u\222\n\230a\034S\2137\020\277\327\273\343\237^\225D\340\2