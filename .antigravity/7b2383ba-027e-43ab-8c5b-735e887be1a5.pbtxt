    command_line: "trap \'playwright-cli close\' EXIT\nmkdir -p .playwright-cli && \\\nplaywright-cli open --browser=chromium http://localhost:3000 && \\\nplaywright-cli resize 1440 900 && \\\nsleep 1 && \\\nplaywright-cli screenshot --filename=.playwright-cli/r1-desktop-hero.png && \\\nplaywright-cli run-code \'async (page) => {\n  // Journey 1: Hero multi-entity switch & imbalance guard\n  await page.getByRole(\"button\", { name: \"Meridian UK (GBP)\" }).click();\n  await page.getByRole(\"button\", { name: \"Test Imbalance Guard\" }).click();\n  const blockedText = await page.getByText(\"Posting Blocked (UAT-04)\").isVisible();\n  if (!blockedText) throw new Error(\"Imbalance guard did not trigger\");\n  await page.getByRole(\"button\", { name: \"Restore Balance\" }).click();\n\n  // Journey 2: Connected Movement & Modules Grid Inspector\n  await page.locator(\"#workflow\").scrollIntoViewIfNeeded();\n  await page.getByRole(\"button\", { name: /J-02/i }).click();\n  await page.getByRole(\"tab\", { name: /Goods Receipt/i }).click();\n  const receiptEndpoint = await page.getByText(\"POST /api/v1/goods-receipts\").isVisible();\n  if (!receiptEndpoint) throw new Error(\"Goods Receipt stage detail did not appear\");\n\n  await page.locator(\"#modules\").scrollIntoViewIfNeeded();\n  await page.getByRole(\"button\", { name: \"Phase 1: Core\" }).click();\n  await page.getByRole(\"button\", { name: /Finance & General Ledger/i }).click();\n  await page.waitForTimeout(350);\n  const inspectorVisible = await page.getByRole(\"region\", { name: /Finance & General Ledger schema inspector/i }).isVisible();\n  if (!inspectorVisible) throw new Error(\"Module schema inspector did not open\");\n  await page.screenshot({ path: \".playwright-cli/r1-desktop-modules.png\" });\n\n  // Inspect Dark Architecture section & switch tab\n  await page.locator(\"#architecture\").scrollIntoViewIfNeeded();\n  await page.getByRole(\"tab\", { name: \"Monorepo Structure\" }).click();\n  await page.waitForTimeout(300);\n\n  // Journey 3: Roadmap, FAQ & Waitlist validation + real API submission\n  await page.locator(\"#roadmap\").scrollIntoViewIfNeeded();\n  await page.getByRole(\"button\", { name: \"Vertical Slices (0\342\200\2237)\" }).click();\n  const sliceVisible = await page.getByText(\"Slice 03\").isVisible();\n  if (!sliceVisible) throw new Error(\"Vertical Slices table did not render\");\n\n  await page.locator(\"#faq\").scrollIntoViewIfNeeded();\n  await page.getByRole(\"button\", { name: /double-entry integrity/i }).click();\n  await page.waitForTimeout(250);\n\n  await page.locator(\"#waitlist\").scrollIntoViewIfNeeded();\n  await page.getByRole(\"button\", { name: \"Request Early Access\" }).click();\n  const emailErr = await page.getByText(\"Enter a valid work email address.\").isVisible();\n  if (!emailErr) throw new Error(\"Waitlist validation error did not show on empty submit\");\n\n  await page.getByLabel(/Full Name/i).fill(\"Chibuzo Daniel\");\n  await page.getByLabel(/Work Email/i).fill(\"chibuzo@metr-pilot.io\");\n  await page.getByLabel(/Organization Name/i).fill(\"Meridian Enterprise Holdings\");\n  await page.getByLabel(/Operational Persona/i).selectOption(\"Company Executive / CEO\");\n  await page.getByLabel(/Legal Entity Footprint/i).selectOption(\"2\342\200\2235 Legal Entities (Multi-Currency)\");\n  await page.getByRole(\"button\", { name: \"Request Early Access\" }).click();\n  await page.getByText(/Welcome to the METR Pilot Queue, Chibuzo Daniel/i).waitFor({ timeout: 5000 });\n  await page.waitForTimeout(300);\n  await page.screenshot({ path: \".playwright-cli/r1-desktop-waitlist.png\" });\n\n  // Mobile 390x844 responsive check\n  await page.setViewportSize({ width: 390, height: 844 });\n  await page.evaluate(() => window.scrollTo(0, 0));\n  await page.waitForTimeout(350);\n  const overflowX = await page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);\n  console.log(\"JOURNEY_CHECK_PASS\", JSON.stringify({ blockedText, receiptEndpoint, inspectorVisible, sliceVisible, emailErr, overflowX }));\n  await page.screenshot({ path: \".playwright-cli/r1-mobile-hero.png\" });\n}\' && \\\nplaywright-cli console && \\\nplaywright-cli requests"
