      arguments_json: "{\"CodeContent\":\"/**\\n * @metr/ui \342\200\224 Precision Ledger & Flow Design Tokens\\n * Exported as typed constants for shared consumption across apps/web and packages/ui.\\n */\\n\\nexport const metrTokens = {\\n  name: \'Precision Ledger & Flow\',\\n  colors: {\\n    primary: \'#0F766E\',\\n    primaryDeep: \'#005C55\',\\n    primaryHover: \'#0D655E\',\\n    primaryActive: \'#0B544E\',\\n    primaryFixed: \'#9CF2E8\',\\n    onPrimary: \'#FFFFFF\',\\n    onPrimaryContainer: \'#A3FAEF\',\\n\\n    secondaryNavy: \'#102A43\',\\n    secondary: \'#49607C\',\\n    secondaryContainer: \'#C7DFFF\',\\n    tertiaryMint: \'#2DD4BF\',\\n    tertiaryDeep: \'#005C52\',\\n\\n    ink: \'#172B4D\',\\n    onSurface: \'#041B3C\',\\n    mutedText: \'#526579\',\\n\\n    canvas: \'#F5F7FA\',\\n    surface: \'#FFFFFF\',\\n    surfaceBright: \'#F9F9FF\',\\n    surfaceContainerLow: \'#F1F3FF\',\\n    darkSurface: \'#0B1724\',\\n    inverseSurface: \'#1D3052\',\\n\\n    borderSubtle: \'#E5EBF0\',\\n    borderDefault: \'#D7E0E8\',\\n    error: \'#BA1A1A\',\\n    errorContainer: \'#FFDAD6\',\\n  },\\n  typography: {\\n    display: {\\n      fontFamily: \'Manrope, sans-serif\',\\n      fontSize: \'56px\',\\n      fontWeight: 800,\\n      lineHeight: \'64px\',\\n      letterSpacing: \'-0.03em\',\\n    },\\n    headlineLg: {\\n      fontFamily: \'Manrope, sans-serif\',\\n      fontSize: \'40px\',\\n      fontWeight: 700,\\n      lineHeight: \'48px\',\\n      letterSpacing: \'-0.02em\',\\n    },\\n    headlineMd: {\\n      fontFamily: \'Manrope, sans-serif\',\\n      fontSize: \'28px\',\\n      fontWeight: 700,\\n      lineHeight: \'36px\',\\n      letterSpacing: \'-0.015em\',\\n    },\\n    headlineSm: {\\n      fontFamily: \'Manrope, sans-serif\',\\n      fontSize: \'20px\',\\n      fontWeight: 600,\\n      lineHeight: \'28px\',\\n      letterSpacing: \'-0.01em\',\\n    },\\n    bodyLg: {\\n      fontFamily: \'Inter, sans-serif\',\\n      fontSize: \'18px\',\\n      fontWeight: 400,\\n      lineHeight: \'28px\',\\n    },\\n    bodyMd: {\\n      fontFamily: \'Inter, sans-serif\',\\n      fontSize: \'15px\',\\n      fontWeight: 400,\\n      lineHeight: \'24px\',\\n    },\\n    eyebrow: {\\n      fontFamily: \'Inter, sans-serif\',\\n      fontSize: \'11px\',\\n      fontWeight: 700,\\n      lineHeight: \'16px\',\\n      letterSpacing: \'0.08em\',\\n    },\\n  },\\n  radius: {\\n    sm: \'0.25rem\',\\n    default: \'0.5rem\',\\n    md: \'0.75rem\',\\n    lg: \'1rem\',\\n    xl: \'1.5rem\',\\n    full: \'9999px\',\\n  },\\n  spacing: {\\n    gutter: \'1.5rem\',\\n    gutterMobile: \'1rem\',\\n    margin: \'3rem\',\\n    marginMobile: \'1.25rem\',\\n    xs: \'0.25rem\',\\n    sm: \'0.5rem\',\\n    md: \'1rem\',\\n    lg: \'1.5rem\',\\n    xl: \'2.5rem\',\\n  },\\n  elevation: {\\n    resting: \'0 1px 3px rgba(16, 42, 69, 0.04), 0 1px 2px rgba(16, 42, 69, 0.02)\',\\n    hover: \'0 10px 24px -4px rgba(16, 42, 69, 0.08), 0 4px 8px -2px rgba(16, 42, 69, 0.04)\',\\n  },\\n} as const;\\n\\nexport type MetrTokens = typeof metrTokens;\\n\", \"Description\":\"Create reusable Precision Ledger & Flow TypeScript design tokens in packages/ui\", \"Overwrite\":true, \"TargetFile\":\"/packages/ui/src/tokens.ts\", \"toolAction\":\"Creating @metr/ui design tokens\", \"toolSummary\":\"Create @metr/ui design tokens\"}"
      original_name: "write_to_file"
