  code_action {
    action_spec {
      create_file {
        instruction: "@import \"tailwindcss\";\n\n@theme {\n  /* Precision Ledger & Flow \342\200\224 Color Tokens */\n  --color-metr-primary: #0F766E;\n  --color-metr-primary-deep: #005C55;\n  --color-metr-primary-hover: #0D655E;\n  --color-metr-primary-active: #0B544E;\n  --color-metr-primary-fixed: #9CF2E8;\n  --color-metr-primary-on-container: #A3FAEF;\n\n  --color-metr-navy: #102A43;\n  --color-metr-ink: #172B4D;\n  --color-metr-on-surface: #041B3C;\n  --color-metr-dark-surface: #0B1724;\n  --color-metr-inverse-surface: #1D3052;\n  --color-metr-inverse-on-surface: #EDF0FF;\n\n  --color-metr-mint: #2DD4BF;\n  --color-metr-tertiary: #005C52;\n  --color-metr-tertiary-container: #00776A;\n\n  --color-metr-canvas: #F5F7FA;\n  --color-metr-surface: #FFFFFF;\n  --color-metr-surface-bright: #F9F9FF;\n  --color-metr-surface-low: #F1F3FF;\n  --color-metr-muted: #526579;\n  --color-metr-border-subtle: #E5EBF0;\n  --color-metr-border-default: #D7E0E8;\n  --color-metr-error: #BA1A1A;\n  --color-metr-error-container: #FFDAD6;\n\n  /* Typography Families */\n  --font-display: \"Manrope\", ui-sans-serif, system-ui, sans-serif;\n  --font-sans: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  --font-mono: \"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace;\n\n  /* Spacing Rhythm (8px cadence) */\n  --spacing-metr-xs: 0.25rem;\n  --spacing-metr-sm: 0.5rem;\n  --spacing-metr-md: 1rem;\n  --spacing-metr-lg: 1.5rem;\n  --spacing-metr-xl: 2.5rem;\n  --spacing-metr-gutter: 1.5rem;\n  --spacing-metr-margin: 3rem;\n\n  /* Corner Geometry (Rounded Level 2) */\n  --radius-metr-sm: 0.25rem;\n  --radius-metr-default: 0.5rem;\n  --radius-metr-md: 0.75rem;\n  --radius-metr-lg: 1rem;\n  --radius-metr-xl: 1.5rem;\n\n  /* Calibrated Elevation */\n  --shadow-metr-resting: 0 1px 3px rgba(16, 42, 69, 0.04), 0 1px 2px rgba(16, 42, 69, 0.02);\n  --shadow-metr-hover: 0 10px 24px -4px rgba(16, 42, 69, 0.08), 0 4px 8px -2px rgba(16, 42, 69, 0.04);\n}\n\n:root {\n  --metr-color-primary: #0F766E;\n  --metr-color-primary-deep: #005C55;\n  --metr-color-primary-hover: #0D655E;\n  --metr-color-primary-active: #0B544E;\n  --metr-color-navy: #102A43;\n  --metr-color-ink: #172B4D;\n  --metr-color-dark-surface: #0B1724;\n  --metr-color-mint: #2DD4BF;\n  --metr-color-canvas: #F5F7FA;\n  --metr-color-surface: #FFFFFF;\n  --metr-color-muted: #526579;\n  --metr-color-border-subtle: #E5EBF0;\n  --metr-color-border-default: #D7E0E8;\n  --metr-color-error: #BA1A1A;\n  --metr-shadow-resting: 0 1px 3px rgba(16, 42, 69, 0.04), 0 1px 2px rgba(16, 42, 69, 0.02);\n  --metr-shadow-hover: 0 10px 24px -4px rgba(16, 42, 69, 0.08), 0 4px 8px -2px rgba(16, 42, 69, 0.04);\n}\n\n@layer base {\n  html {\n    font-family: var(--font-sans);\n    color: var(--metr-color-ink);\n    background-color: var(--metr-color-canvas);\n  }\n\n  h1, h2, h3, h4, h5, h6 {\n    font-family: var(--font-display);\n    text-wrap: balance;\n  }\n\n  button:not(:disabled),\n  a[href] {\n    cursor: pointer;\n  }\n}\n\n.font-tabular {\n  font-variant-numeric: tabular-nums slashed-zero;\n  font-feature-settings: \"tnum\" 1, \"zero\" 1;\n}\n\n.metr-card {\n  background-color: var(--metr-color-surface);\n  border: 1px solid var(--metr-color-border-default);\n  box-shadow: var(--metr-shadow-resting);\n  transition: box-shadow 180ms cubic-bezier(0.16, 1, 0.3, 1), border-color 180ms cubic-bezier(0.16, 1, 0.3, 1), transform 180ms cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n.metr-card-interactive:hover {\n  box-shadow: var(--metr-shadow-hover);\n  border-color: rgba(15, 118, 110, 0.28);\n}\n\n.metr-focus:focus-visible {\n  outline: 2px solid #2DD4BF;\n  outline-offset: 2px;\n}\n\n.metr-input {\n  height: 44px;\n  background-color: #FFFFFF;\n  border: 1px solid #D7E0E8;\n  border-radius: 0.5rem;\n  color: #172B4D;\n  transition: border-color 160ms ease, box-shadow 160ms ease;\n}\n\n.metr-input::placeholder {\n  color: #526579;\n}\n\n.metr-input:focus {\n  outline: none;\n  border-color: #0F766E;\n  box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.15);\n}\n"
        path {
          absolute_uri: "file:///src/index.css"
        }
        overwrite: true
      }
