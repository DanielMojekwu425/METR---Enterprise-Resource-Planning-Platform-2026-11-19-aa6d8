            lines {
              text: "export const FAQ_ITEMS: AccordionItemData[] = ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    id: \'modular-monolith\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    category: \'Architecture\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    question: \'Why does METR launch as a modular monolith instead of microservices?\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    answer:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      \'Financial posting, stock reservations, and sales orders require strict ACID transactional guarantees. Splitting ledger, inventory, and orders across premature microservices introduces distributed failure modes before operations mature. METR enforces domain ownership boundaries inside a NestJS + TypeScript modular monolith backed by 15 PostgreSQL schemas and a durable transactional outbox.\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    specRef: \'METR-SPEC-001 \302\267 Section B1 & B2\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    id: \'tenant-vs-company\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    category: \'Security & Tenancy\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    question: \'How does METR separate a tenant workspace from multiple legal entities?\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    answer:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      \'A Tenant defines the workspace isolation boundary, while a Company represents an individual legal entity with its own Chart of Accounts, base currency, tax codes, fiscal periods, bank accounts, and atomic document number sequences. Every tenant-owned row carries tenant_id derived exclusively from authenticated server context and enforced via composite foreign keys (tenant_id, id) plus optional PostgreSQL RLS.\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    specRef: \'METR-SPEC-001 \302\267 Section B4\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    id: \'double-entry-immutability\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    category: \'Finance & Ledger\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    question: \'How are double-entry integrity and posted document immutability enforced?\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    answer:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      \'Every journal post executes atomically inside a database transaction that validates an open fiscal period, verifies SUM(debit_base) = SUM(credit_base) with numeric(20,4) fixed-point decimals (never IEEE floating-point), and records an idempotency key. Once posted or issued, journals and invoices cannot be edited or deleted\342\200\224corrections require linked reversing journals or approved credit notes.\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    specRef: \'METR-SPEC-001 \302\267 Section B7 & C9\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    id: \'unified-platform\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    category: \'Platform\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    question: \'Why use one unified platform instead of connecting separate apps together?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    answer:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'When CRM, invoicing, inventory, and accounting live in disconnected tools, teams waste hours copying numbers, fixing sync errors, and reconciling mismatched totals at month-end. METR runs your entire operation inside one cohesive system\342\200\224so an approved quote, a warehouse shipment, and a customer payment automatically keep your financial books in sync.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'multi-company\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    category: \'Security\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    question: \'Can we manage multiple companies and currencies under one account?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    answer:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Yes. Your organization workspace can house multiple legal entities\342\200\224such as a Nigerian subsidiary billing in NGN and a UK subsidiary billing in GBP. Each company keeps its own Chart of Accounts, tax rules, bank accounts, financial periods, and invoice numbering, while staff only see the companies they are authorized to access.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'accounting-accuracy\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    category: \'Accounting\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    question: \'How does METR keep our financial books accurate and audit-ready?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    answer:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Every accounting entry is automatically verified so total debits always equal total credits in an open financial period, using exact decimal precision with no rounding errors. Once an invoice is issued or a journal is posted, it cannot be quietly edited or deleted\342\200\224corrections always leave a clean trail through official credit notes or reversing entries.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
