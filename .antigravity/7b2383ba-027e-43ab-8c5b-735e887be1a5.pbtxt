      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { motion } from \'motion/react\';\\n\\nexport interface RevealProps {\\n  children: React.ReactNode;\\n  delay?: number;\\n  y?: number;\\n  className?: string;\\n}\\n\\n/**\\n * Subtle scroll-entry animation wrapper using compositor-only transform + opacity.\\n * viewport={{ once: true, amount: 0.12 }} keeps content accessible with zero layout shift.\\n */\\nexport function Reveal({ children, delay = 0, y = 16, className = \'\' }: RevealProps) {\\n  return (\\n    <motion.div\\n      initial={{ opacity: 0, y }}\\n      whileInView={{ opacity: 1, y: 0 }}\\n      viewport={{ once: true, amount: 0.12 }}\\n      transition={{ duration: 0.42, delay, ease: [0.16, 1, 0.3, 1] }}\\n      className={className}\\n    >\\n      {children}\\n    </motion.div>\\n  );\\n}\\n\", \"Description\":\"Create subtle Framer Motion Reveal animation helper in packages/ui\", \"Overwrite\":true, \"TargetFile\":\"/packages/ui/src/components/Reveal.tsx\", \"toolAction\":\"Creating Reveal animation component\", \"toolSummary\":\"Create Reveal component\"}"
      original_name: "write_to_file"
    }
