              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            checked={checked}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            onChange={() => togglePhase(choice.phase)}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            className=\"sr-only\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                          />"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
