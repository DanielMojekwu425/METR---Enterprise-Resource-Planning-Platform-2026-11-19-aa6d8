"font-mono\\\">Idempotency-Key</span> header to{\' \'}\\n                <span className=\\\"font-mono\\\">POST /api/v1/waitlist</span>.\\n              </span>\\n            </div>\\n          </Reveal>\\n\\n          {/* Right 7 Columns: Validated Waitlist Form or Confirmation Receipt */}\\n          <div className=\\\"lg:col-span-7\\\">\\n            {submittedRecord ? (\\n              <motion.div\\n                initial={{ opacity: 0, y: 12 }}\\n                animate={{ opacity: 1, y: 0 }}\\n                transition={{ duration: 0.3, ease: [0.16, 1, 0.3, 1] }}\\n                role=\\\"status\\\"\\n                aria-live=\\\"polite\\\"\\n                className=\\\"metr-card rounded-[1.25rem] p-6 sm:p-8 space-y-6 border-[#0F766E]/40\\\"\\n              >\\n                <div className=\\\"flex items-start gap-4 pb-5 border-b border-[#E5EBF0]\\\">\\n                  <span className=\\\"inline-flex h-11 w-11 items-center justify-center rounded-[0.75rem] bg-[#0F766E]/10 text-[#0F766E] shrink-0\\\">\\n                    <CheckCircle2 size={24} aria-hidden=\\\"true\\\" />\\n                  </span>\\n                  <div>\\n                    <p className=\\\"text-[11px] font-bold uppercase tracking-[0.08em] text-[#0F766E]\\\">\\n                      Waitlist Entry Recorded\\n                    </p>\\n                    <h3 className=\\\"font-[Manrope] text-[24px] font-bold text-[#102A43] mt-0.5\\\">\\n                      Welcome to the METR Pilot Queue, {submittedRecord.fullName}.\\n                    </h3>\\n                    <p className=\\\"text-[14px] text-[#526579] mt-1\\\">\\n                      Your organization onboarding request has been logged for technical scoping.\\n                    </p>\\n                  </div>\\n                </div>\"}, {\"AllowMultiple\":false, \"EndLine\":285, \"ReplacementContent\":\"                <div className=\\\"pt-2 flex flex-wrap items-center justify-between gap-4\\\">\\n                  <span className=\\\"text-[12px] text-[#526579]\\\">\\n                    Submitted \302\267 {new Date(submittedRecord.submittedAt).toUTCString()}\\n                  </span>\\n                  <Button variant=\\\"secondary\\\" size=\\\"sm\\\" onClick={handleReset}>\\n                    <RotateCcw size={14} aria-hidden=\\\"true\\\" />\\n                    Register Another Team Member\\n                  </Button>\\n                </div>\", \"StartLine\":276, \"TargetContent\":\"                <div className=\\\"pt-2 flex flex-wrap items-center justify-between gap-4\\\">\\n                  <span className=\\\"text-[12px] font-mono text-[#526579]\\\">\\n                    Recorded UTC \302\267 {new Date(submittedRecord.submittedAt).toUTCString()}\\n                  </span>\\n                  <Button variant=\\\"secondary\\\" size=\\\"sm\\\" onClick={handleReset}>\\n                    <RotateCcw size={14} aria-hidden=\\\"true\\\" />\\n                    Register Another Stakeholder\\n                  </Button>\\n                </div>\"}, {\"AllowMultiple\":false, \"EndLine\":525, \"ReplacementContent\":\"                  <div>\\n                    <label\\n                      htmlFor=\\\"waitlist-role\\\"\\n                      className=\\\"block text-[13px] font-semibold text-[#172B4D] mb-1.5\\\"\\n                    >\\n                      Your Role <span className=\\\"text-[#BA1A1A]\\\">*</span>\\n                    </label>\\n                    <select\\n                      id=\\\"waitlist-role\\\"\\n                      name=\\\"role\\\"\\n                      value={form.role}\\n                      onChange={(e) => handleFieldChange(\'role\', e.target.value)}\\n                      aria-invalid={Boolean(fieldErrors.role)}\\n                      aria-describedby={fieldErrors.role ? \'err-role\' : undefined}\\n                      className=\\\"metr-input w-full px-3.5 text-[14px]\\\"\\n                    >\\n                      <option value=\\\"\\\">Select role...</option>\\n                      {PERSONA_OPTIONS.map((roleOpt) => (\\n                        <option key={roleOpt} value={roleOpt}>\\n                          {roleOpt}\\n                        </option>\\n                      ))}\\n                    </select>\\n                    {fieldErrors.role && (\\n                      <p id=\\\"err-role\\\" className=\\\"mt-1.5 text-[12px] font-medium text-[#BA1A1A]\\\">\\n                        {fieldErrors.role}\\n                      </p>\\n                    )}\\n                  </div>\\n                </div>\\n\\n                <div>\\n                  <label\\n                    htmlFor=\\\"waitlist-entities\\\"\\n                    className=\\\"block text-[13px] font-semibold text-[#172B4D] mb-1.5\\\"\\n                  >\\n                    Company Structure <span className=\\\"text-[#BA1A1A]\\\">*</span>\\n                  </label>\\n                  <select\\n                    id=\\\"waitlist-entities\\\"\\n                    name=\\\"entityCount\\\"\\n                    value={form.entityCount}\\n                    onChange={(e) => handleFieldChange(\'entityCount\', e.target.value)}\\n                    aria-invalid={Boolean(fieldErrors.entityCount)}\\n                    aria-describedby={fieldErrors.entityCount ? \'err-entityCount\' : undefined}\\n                    className=\\\"metr-input w-full px-3.5 text-[14px]\\\"\\n                  >\\n                    <option value=\\\"\\\">Select company structure...</option>\\n                    {ENTITY_OPTIONS.map((opt) => (\\n                      <option key={opt} value={opt}>\\n                        {opt}\\n                      </option>\\n                    ))}\\n                  </select>\\n                  {fieldErrors.entityCount && (\\n                    <p\\n                      id=\\\"err-entityCount\\\"\\n                      className=\\\"mt-1.5 text-[12px] font-medium text-[#BA1A1A]\\\"\\n                    >\\n                      {fieldErrors.entityCount}\\n                    </p>\\n                  )}\\n                </div>\\n\\n                {/* Priority Phases Checkboxes (Precision Ledger 18px teal checkboxes) */}\\n                <fieldset>\\n                  <legend className=\\\"text-[13px] font-semibold text-[#172B4D] mb-2\\\">\\n                    Modules You\342\200\231re Most Interested In <span className=\\\"text-[#BA1A1A]\\\">*</span>\\n                  </legend>\\n                  <div className=\\\"space-y-2.5\\\">\\n                    {PHASE_CHOICES.map((choice) => {\\n                      const checked = form.priorityPhases.includes(choice.phase);\\n                      return (\\n                        <label\\n                          key={choice.phase}\\n                          className={`flex items-start gap-3 rounded-[0.5rem] border p-3 cursor-pointer transition-colors ${\\n                            checked\\n                              ? \'border-[#0F766E]/45 bg-[#0F766E]/[0.04]\'\\n                              : \'border-[#D7E0E8] bg-white hover:bg-[#F5F7FA]\'\\n                          }`}\\n                        >\\n                          <input\\n                            type=\\\"checkbox\\\"\\n                            checked={checked}\\n                            onChange={() => togglePhase(choice.phase)}\\n                            className=\\\"sr-only\\\"\\n                          />\\n                          <span\\n                            aria-hidden=\\\"true\\\"\\n                            className={`mt-0.5 inline-flex h-[18px] w-[18px] items-center justify-center rounded-[4px] border shrink-0 transition-colors ${\\n                              checked\\n                                ? \'bg-[#0F766E] border-[#0F766E] text-white\'\\n                                : \'bg-white border-[#D7E0E8]\'\\n                            }`}\\n                          >\\n                            {checked && <Check size={12} strokeWidth={3} />}\\n                          </span>\\n                          <span className=\\\"text-[13px] leading-[19px]\\\">\\n                            <strong className=\\\"font-semibold text-[#102A43]\\\">{choice.phase}</strong>\\n                            <span className=\\\"text-[#526579]\\\"> \342\200\224 {choice.description}</span>\\n                          </span>\\n                        </label>\\n                      );\\n                    })}\\n                  </div>\\n                  {fieldErrors.priorityPhases && (\\n                    <p className=\\\"mt-1.5 text-[12px] font-medium text-[#BA1A1A]\\\">\\n                      {fieldErrors.priorityPhases}\\n                    </p>\\n                  )}\\n                </fieldset>\\n\\n                <div>\\n                  <label\\n                    htmlFor=\\\"waitlist-notes\\\"\\n                    className=\\\"block text-[13px] font-semibold text-[#172B4D] mb-1.5\\\"\\n                  >\\n                    Current Tools or Setup Notes{\' \'}\\n                    <span className=\\\"font-normal text-[#526579]\\\">(Optional)</span>\\n                  </label>\\n                  <textarea\\n                    id=\\\"waitlist-notes\\\"\\n                    name=\\\"notes\\\"\\n                    rows={3}\\n                    placeholder=\\\"Current accounting software, currency needs, or team onboarding goals...\\\"\\n                    value={form.notes ?? \'\'}\\n                    onChange={(e) => handleFieldChange(\'notes\', e.target.value)}\\n                    className=\\\"w-full rounded-[0.5rem] border border-[#D7E0E8] bg-white px-3.5 py-2.5 text-[14px] text-[#172B4D] placeholder:text-[#526579] focus:outline-none focus:border-[#0F766E] focus:ring-[3px] focus:ring-[#0F766E]/15\\\"\\n                  />\\n                </div>\\n\\n                <div className=\\\"pt-2 flex flex-col sm:flex-row sm:items-center justify-between gap-4\\\">\\n                  <p className=\\\"text-[12px] text-[#526579]\\\">\\n                    No automated spam. Direct onboarding review with the METR team.\\n                  </p>\", \"StartLine\":388, \"TargetContent\":\"                  <div>\\n                    <label\\n                      htmlFor=\\\"waitlist-role\\\"\\n                      className=\\\"block text-[13px] font-semibold text-[#172B4D] mb-1.5\\\"\\n                    >\\n                      Operational Persona <span className=\\\"text-[#BA1A1A]\\\">*</span>\\n                    </label>\\n                    <select\\n                      id=\\\"waitlist-role\\\"\\n                      name=\\\"role\\\"\\n                      value={form.role}\\n                      onChange={(e) => handleFieldChange(\'role\', e.target.value)}\\n                      aria-invalid={Boolean(fieldErrors.role)}\\n                      aria-describedby={fieldErrors.role ? \'err-role\' : undefined}\\n                      className=\\\"metr-input w-full px-3.5 text-[14px]\\\"\\n                    >\\n                      <option value=\\\"\\\">Select role...</option>\\n                      {PERSONA_OPTIONS.map((roleOpt) => (\\n                        <option key={roleOpt} value={roleOpt}>\\n                          {roleOpt}\\n                        </option>\\n                      ))}\\n                    </select>\\n                    {fieldErrors.role && (\\n                      <p id=\\\"err-role\\\" className=\\\"mt-1.5 text-[12px] font-medium text-[#BA1A1A]\\\">\\n                        {fieldErrors.role}\\n                      </p>\\n                    )}\\n                  </div>\\n                </div>\\n\\n                <div>\\n                  <label\\n                    htmlFor=\\\"waitlist-entities\\\"\\n                    className=\\\"block text-[13px] font-semibold text-[#172B4D] mb-1.5\\\"\\n                  >\\n                    Legal Entity Footprint <span className=\\\"text-[#BA1A1A]\\\">*</span>\\n                  </label>\\n                  <select\\n                    id=\\\"waitlist-entities\\\"\\n                    name=\\\"entityCount\\\"\\n                    value={form.entityCount}\\n                    onChange={(e) => handleFieldChange(\'entityCount\', e.target.value)}\\n                    aria-invalid={Boolean(fieldErrors.entityCount)}\\n                    aria-describedby={fieldErrors.entityCount ? \'err-entityCount\' : undefined}\\n                    className=\\\"metr-input w-full px-3.5 text-[14px]\\\"\\n                  >\\n                    <option value=\\\"\\\">Select legal entity structure...</option>\\n                    {ENTITY_OPTIONS.map((opt) => (\\n                      <option key={opt} value={opt}>\\n                        {opt}\\n                      </option>\\n                    ))}\\n                  </select>\\n                  {fieldErrors.entityCount && (\\n                    <p\\n                      id=\\\"err-entityCount\\\"\\n                      className=\\\"mt-1.5 text-[12px] font-medium text-[#BA1A1A]\\\"\\n                    >\\n                      {fieldErrors.entityCount}\\n                    </p>\\n                  )}\\n                </div>\\n\\n                {/* Priority Phases Checkboxes (Precision Ledger 18px teal checkboxes) */}\\n                <fieldset>\\n                  <legend className=\\\"text-[13px] font-semibold text-[#172B4D] mb-2\\\">\\n                    Priority Rollout Scope <span className=\\\"text-[#BA1A1A]\\\">*</span>\\n                  </legend>\\n                  <div className=\\\"space-y-2.5\\\">\\n                    {PHASE_CHOICES.map((choice) => {\\n                      const checked = form.priorityPhases.includes(choice.phase);\\n                      return (\\n                        <label\\n                          key={choice.phase}\\n                          className={`flex items-start gap-3 rounded-[0.5rem] border p-3 cursor-pointer transition-colors ${\\n                            checked\\n                              ? \'border-[#0F766E]/45 bg-[#0F766E]/[0.04]\'\\n                              : \'border-[#D7E0E8] bg-white hover:bg-[#F5F7FA]\'\\n                          }`}\\n                        >\\n                          <input\\n                            type=\\\"checkbox\\\"\\n                            checked={checked}\\n                            onChange={() => togglePhase(choice.phase)}\\n                            className=\\\"sr-only\\\"\\n                          />\\n                          <span\\n                            aria-hidden=\\\"true\\\"\\n                            className={`mt-0.5 inline-flex h-[18px] w-[18px] items-center justify-center rounded-[4px] border shrink-0 transition-colors ${\\n                              checked\\n                                ? \'bg-[#0F766E] border-[#0F766E] text-white\'\\n                                : \'bg-white border-[#D7E0E8]\'\\n                            }`}\\n                          >\\n                            {checked && <Check size={12} strokeWidth={3} />}\\n                          </span>\\n                          <span className=\\\"text-[13px] leading-[19px]\\\">\\n                            <strong className=\\\"font-semibold text-[#102A43]\\\">{choice.phase}</strong>\\n                            <span className=\\\"text-[#526579]\\\"> \342\200\224 {choice.description}</span>\\n                          </span>\\n                        </label>\\n                      );\\n                    })}\\n                  </div>\\n                  {fieldErrors.priorityPhases && (\\n                    <p className=\\\"mt-1.5 text-[12px] font-medium text-[#BA1A1A]\\\">\\n                      {fieldErrors.priorityPhases}\\n                    </p>\\n                  )}\\n                </fieldset>\\n\\n                <div>\\n                  <label\\n                    htmlFor=\\\"waitlist-notes\\\"\\n                    className=\\\"block text-[13px] font-semibold text-[#172B4D] mb-1.5\\\"\\n                  >\\n                    Legacy System or Migration Context{\' \'}\\n                    <span className=\\\"font-normal text-[#526579]\\\">(Optional)</span>\\n                  </label>\\n                  <textarea\\n                    id=\\\"waitlist-notes\\\"\\n                    name=\\\"notes\\\"\\n                    rows={3}\\n                    placeholder=\\\"Current accounting software, currency requirements, or chart-of-accounts migration notes...\\\"\\n                    value={form.notes ?? \'\'}\\n                    onChange={(e) => handleFieldChange(\'notes\', e.target.value)}\\n                    className=\\\"w-full rounded-[0.5rem] border border-[#D7E0E8] bg-white px-3.5 py-2.5 text-[14px] text-[#172B4D] placeholder:text-[#526579] focus:outline-none focus:border-[#0F766E] focus:ring-[3px] focus:ring-[#0F766E]/15\\\"\\n                  />\\n                </div>\\n\\n                <div className=\\\"pt-2 flex flex-col sm:flex-row sm:items-center justify-between gap-4\\\">\\n                  <p className=\\\"text-[12px] text-[#526579]\\\">\\n                    No automated spam. Direct technical review with the METR implementation team.\\n                  </p>\"}], \"TargetFile\":\"/apps/web/src/components/WaitlistSection.tsx\", \"toolAction\":\"Updating WaitlistSection to business language\", \"toolSummary\":\"Update WaitlistSection.tsx\"}"
