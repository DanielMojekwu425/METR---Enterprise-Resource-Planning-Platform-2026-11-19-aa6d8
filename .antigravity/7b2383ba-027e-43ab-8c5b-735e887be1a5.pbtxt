              text: "                      return ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        <label"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                          key={choice.phase}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                          className={`flex items-start gap-3 rounded-[0.5rem] border p-3 cursor-pointer transition-colors ${"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            checked"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                              ? \'border-[#0F766E]/45 bg-[#0F766E]/[0.04]\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                              : \'border-[#D7E0E8] bg-white hover:bg-[#F5F7FA]\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                          }`}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
