            lines {
              text: "export const FAQ_ITEMS: AccordionItemData[] = ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'modular-monolith\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    category: \'Architecture\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    question: \'Why does METR launch as a modular monolith instead of microservices?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    answer:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Financial posting, stock reservations, and sales orders require strict ACID transactional guarantees. Splitting ledger, inventory, and orders across premature microservices introduces distributed failure modes before operations mature. METR enforces domain ownership boundaries inside a NestJS + TypeScript modular monolith backed by 15 PostgreSQL schemas and a durable transactional outbox.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    specRef: \'METR-SPEC-001 \302\267 Section B1 & B2\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'tenant-vs-company\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    category: \'Security & Tenancy\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    question: \'How does METR separate a tenant workspace from multiple legal entities?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    answer:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'A Tenant defines the workspace isolation boundary, while a Company represents an individual legal entity with its own Chart of Accounts, base currency, tax codes, fiscal periods, bank accounts, and atomic document number sequences. Every tenant-owned row carries tenant_id derived exclusively from authenticated server context and enforced via composite foreign keys (tenant_id, id) plus optional PostgreSQL RLS.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    specRef: \'METR-SPEC-001 \302\267 Section B4\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'double-entry-immutability\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    category: \'Finance & Ledger\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    question: \'How are double-entry integrity and posted document immutability enforced?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    answer:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Every journal post executes atomically inside a database transaction that validates an open fiscal period, verifies SUM(debit_base) = SUM(credit_base) with numeric(20,4) fixed-point decimals (never IEEE floating-point), and records an idempotency key. Once posted or issued, journals and invoices cannot be edited or deleted\342\200\224corrections require linked reversing journals or approved credit notes.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    specRef: \'METR-SPEC-001 \302\267 Section B7 & C9\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'separation-of-duties\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    category: \'Security & Tenancy\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    question: \'Can a system administrator view payroll or approve their own purchase orders?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    answer:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'No. METR enforces deny-by-default server-side authorization with strict Separation of Duties (SoD). Initiators cannot self-approve sensitive quotations, purchase orders, vendor payments, or journal postings above configured thresholds, and platform administrators never inherit unrestricted financial or HR payroll viewing merely by holding administrative privileges.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    specRef: \'METR-SPEC-001 \302\267 Section A3b & B8\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'vertical-slices\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    category: \'Rollout\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    question: \'How is METR rolled out without disrupting active finance and delivery teams?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    answer:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Engineering delivers complete vertical slices (UI + API + permission checks + PostgreSQL persistence + outbox events + GL reporting + negative tests) rather than disconnected tabs. Phase 1 proves Lead-to-Cash and Trial Balance reconciliation end-to-end before Phase 2 introduces procurement, warehousing, contracts, projects, and SLA support.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    specRef: \'METR-SPEC-001 \302\267 Section D1 & D2\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
