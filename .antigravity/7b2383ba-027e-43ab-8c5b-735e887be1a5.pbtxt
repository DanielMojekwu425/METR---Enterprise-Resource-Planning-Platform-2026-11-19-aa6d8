    model_api_content_id: "aeef3ad4cc814ef9a27da2278036bce2"
  }
  code_action {
    action_spec {
      create_file {
        instruction: "import crypto from \'node:crypto\';\nimport path from \'node:path\';\nimport express from \'express\';\nimport { createServer as createViteServer } from \'vite\';\nimport {\n  validateWaitlistSubmission,\n  type WaitlistRecord,\n  type WaitlistSubmissionInput,\n} from \'./packages/contracts/src/erp\';\n\nconst PORT = Number(process.env.PORT) || 3000;\nconst IS_PROD = process.env.NODE_ENV === \'production\';\n\n// In-memory idempotent waitlist ledger seeded with realistic pilot queue baseline\nconst BASELINE_COUNT = 38;\nconst waitlistRecords: WaitlistRecord[] = [];\nconst idempotencyCache = new Map<string, WaitlistRecord>();\n\nfunction makeRequestId(): string {\n  return `req_${crypto.randomBytes(6).toString(\'hex\')}`;\n}\n\nasync function startServer() {\n  const app = express();\n  app.use(express.json({ limit: \'64kb\' }));\n\n  // GET /api/v1/waitlist/count \342\200\224 Standard METR response envelope (Section B6)\n  app.get(\'/api/v1/waitlist/count\', (_req, res) => {\n    res.json({\n      data: {\n        totalCount: BASELINE_COUNT + waitlistRecords.length,\n      },\n      meta: {\n        requestId: makeRequestId(),\n        nextCursor: null,\n      },\n    });\n  });\n\n  // POST /api/v1/waitlist \342\200\224 Validated, idempotent stakeholder waitlist registration\n  app.post(\'/api/v1/waitlist\', (req, res) => {\n    const requestId = makeRequestId();\n    const idempotencyKey = req.header(\'Idempotency-Key\')?.trim();\n\n    if (idempotencyKey && idempotencyCache.has(idempotencyKey)) {\n      const existing = idempotencyCache.get(idempotencyKey)!;\n      res.status(200).json({\n        data: {\n          record: existing,\n          totalCount: BASELINE_COUNT + waitlistRecords.length,\n          idempotentReplay: true,\n        },\n        meta: {\n          requestId,\n          nextCursor: null,\n        },\n      });\n      return;\n    }\n\n    const input = req.body as WaitlistSubmissionInput;\n    const validation = validateWaitlistSubmission(input);\n\n    if (!validation.valid) {\n      res.status(400).json({\n        error: {\n          code: \'VALIDATION_ERROR\',\n          message: \'Please correct the highlighted fields before submitting.\',\n          details: Object.entries(validation.fieldErrors).map(([field, message]) => ({\n            field,\n            message,\n          })),\n        },\n        requestId,\n      });\n      return;\n    }\n\n    const seq = String(BASELINE_COUNT + waitlistRecords.length + 1).padStart(4, \'0\');\n    const record: WaitlistRecord = {\n      id: crypto.randomUUID(),\n      referenceCode: `METR-PLT-2026-${seq}`,\n      fullName: input.fullName.trim(),\n      workEmail: input.workEmail.trim().toLowerCase(),\n      companyName: input.companyName.trim(),\n      role: input.role.trim(),\n      entityCount: input.entityCount.trim(),\n      priorityPhases: input.priorityPhases,\n      notes: input.notes?.trim() || undefined,\n      submittedAt: new Date().toISOString(),\n    };\n\n    waitlistRecords.push(record);\n    if (idempotencyKey) {\n      idempotencyCache.set(idempotencyKey, record);\n    }\n\n    res.status(201).json({\n      data: {\n        record,\n        totalCount: BASELINE_COUNT + waitlistRecords.length,\n        idempotentReplay: false,\n      },\n      meta: {\n        requestId,\n        nextCursor: null,\n      },\n    });\n  });\n\n  if (!IS_PROD) {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distDir = path.resolve(process.cwd(), \'dist\');\n    app.use(express.static(distDir));\n    app.get(\'*\', (_req, res) => {\n      res.sendFile(path.join(distDir, \'index.html\'));\n    });\n  }\n\n  app.listen(PORT, \'0.0.0.0\', () => {\n    console.log(`METR ERP Web Server listening on http://0.0.0.0:${PORT}`);\n  });\n}\n\nstartServer().catch((err) => {\n  console.error(\'Failed to start METR server:\', err);\n  process.exit(1);\n});\n"
        path {
          absolute_uri: "file:///server.ts"
        }
        overwrite: true
      }
    }
