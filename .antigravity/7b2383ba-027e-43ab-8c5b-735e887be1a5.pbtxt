    tool_calls {
      id: "call_16039954103718413372"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Remove PDF section/journey codes, REST endpoints, and outbox keys from ConnectedWorkflowSection\", \"EndLine\":165, \"Instruction\":\"Update ConnectedWorkflowSection to remove Section A6 & A7, J-01/J-02/J-03 codes, CRM-01/SAL-01/FIN-01 codes, REST endpoints, and outbox event keys, replacing them with plain-English business workflow cards.\", \"ReplacementContent\":\"import React, { useState } from \'react\';\\nimport { AnimatePresence, motion } from \'motion/react\';\\nimport { ArrowRight, CheckSquare, GitCommitHorizontal, ShieldCheck } from \'lucide-react\';\\nimport { PhaseBadge, Reveal, WorkflowPipeline } from \'@metr/ui\';\\nimport { ENTERPRISE_JOURNEYS } from \'../data/metrContent\';\\n\\nexport function ConnectedWorkflowSection() {\\n  const [selectedJourneyId, setSelectedJourneyId] = useState(ENTERPRISE_JOURNEYS[0].id);\\n  const currentJourney =\\n    ENTERPRISE_JOURNEYS.find((j) => j.id === selectedJourneyId) ?? ENTERPRISE_JOURNEYS[0];\\n\\n  const [selectedStageByJourney, setSelectedStageByJourney] = useState<Record<string, string>>({\\n    \'lead-to-cash\': \'ledger\',\\n    \'procure-to-pay\': \'bill\',\\n    \'contract-to-renewal\': \'renewal\',\\n  });\\n\\n  const activeStageId =\\n    selectedStageByJourney[currentJourney.id] ?? currentJourney.stages[0].id;\\n  const activeStageIndex = Math.max(\\n    0,\\n    currentJourney.stages.findIndex((s) => s.id === activeStageId)\\n  );\\n  const activeStage = currentJourney.stages[activeStageIndex] ?? currentJourney.stages[0];\\n\\n  const handleSelectStage = (stageId: string) => {\\n    setSelectedStageByJourney((prev) => ({\\n      ...prev,\\n      [currentJourney.id]: stageId,\\n    }));\\n  };\\n\\n  return (\\n    <section id=\\\"workflow\\\" className=\\\"bg-white border-b border-[#E5EBF0] py-16 lg:py-24\\\">\\n      <div className=\\\"mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-12\\\">\\n        <Reveal>\\n          <div className=\\\"flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-10\\\">\\n            <div className=\\\"max-w-2xl\\\">\\n              <p className=\\\"text-[11px] font-bold uppercase tracking-[0.08em] text-[#0F766E] mb-3\\\">\\n                Connected Workflows\\n              </p>\\n              <h2 className=\\\"font-[Manrope] text-[28px] sm:text-[36px] lg:text-[40px] font-bold leading-[1.2] tracking-[-0.02em] text-[#102A43]\\\">\\n                Every business step connected from first quote to final books.\\n              </h2>\\n              <p className=\\\"mt-3 text-[15px] sm:text-[16px] leading-[26px] text-[#526579]\\\">\\n                Choose a core workflow and click any stage to see how approvals, built-in safeguards,\\n                and financial updates stay seamlessly in sync.\\n              </p>\\n            </div>\\n\\n            {/* Segmented Journey Switcher */}\\n            <div\\n              role=\\\"group\\\"\\n              aria-label=\\\"Select business workflow\\\"\\n              className=\\\"inline-flex flex-wrap items-center gap-1 rounded-[0.75rem] bg-[#F5F7FA] p-1 border border-[#D7E0E8] self-start lg:self-auto\\\"\\n            >\\n              {ENTERPRISE_JOURNEYS.map((journey) => {\\n                const active = journey.id === currentJourney.id;\\n                return (\\n                  <button\\n                    key={journey.id}\\n                    type=\\\"button\\\"\\n                    aria-pressed={active}\\n                    onClick={() => setSelectedJourneyId(journey.id)}\\n                    className={`px-3.5 py-2 rounded-[0.5rem] text-[13px] font-semibold transition-colors whitespace-nowrap shrink-0 metr-focus ${\\n                      active\\n                        ? \'bg-white text-[#102A43] shadow-[0_1px_2px_rgba(16,42,69,0.08)]\'\\n                        : \'text-[#526579] hover:text-[#172B4D]\'\\n                    }`}\\n                  >\\n                    {journey.title}\\n                  </button>\\n                );\\n              })}\\n            </div>\\n          </div>\\n        </Reveal>\\n\\n        {/* Journey Context Header */}\\n        <div className=\\\"mb-6 flex flex-wrap items-center justify-between gap-3\\\">\\n          <p className=\\\"text-[14px] text-[#3E4947] max-w-3xl\\\">{currentJourney.description}</p>\\n          <PhaseBadge phase={currentJourney.phase} />\\n        </div>\\n\\n        {/* Horizontal Connected Movement Pipeline */}\\n        <WorkflowPipeline\\n          stages={currentJourney.stages}\\n          activeStageId={activeStage.id}\\n          onSelectStage={handleSelectStage}\\n        />\\n\\n        {/* Selected Stage Business Detail Card */}\\n        <AnimatePresence mode=\\\"wait\\\">\\n          <motion.div\\n            key={`${currentJourney.id}-${activeStage.id}`}\\n            initial={{ opacity: 0, y: 10 }}\\n            animate={{ opacity: 1, y: 0 }}\\n            exit={{ opacity: 0, y: -6 }}\\n            transition={{ duration: 0.22, ease: [0.16, 1, 0.3, 1] }}\\n            className=\\\"mt-6 rounded-[1rem] border border-[#D7E0E8] bg-[#F5F7FA] p-6 lg:p-7\\\"\\n          >\\n            <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\\\">\\n              <div className=\\\"lg:col-span-5 space-y-2\\\">\\n                <div className=\\\"flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.08em] text-[#0F766E]\\\">\\n                  <span>Step 0{activeStageIndex + 1}</span>\\n                  <span aria-hidden=\\\"true\\\">\302\267</span>\\n                  <span>Stage Overview</span>\\n                </div>\\n                <h3 className=\\\"font-[Manrope] text-[22px] font-bold text-[#102A43]\\\">\\n                  {activeStage.label} \342\200\224 {activeStage.statusLabel}\\n                </h3>\\n                <p className=\\\"text-[15px] leading-[24px] text-[#3E4947]\\\">\\n                  {activeStage.summary}\\n                </p>\\n              </div>\\n\\n              <div className=\\\"lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                <div className=\\\"rounded-[0.75rem] bg-white border border-[#D7E0E8] p-4 space-y-1.5\\\">\\n                  <div className=\\\"flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-[0.08em] text-[#526579]\\\">\\n                    <GitCommitHorizontal size={14} className=\\\"text-[#0F766E]\\\" aria-hidden=\\\"true\\\" />\\n                    <span>Approval & Status Flow</span>\\n                  </div>\\n                  <p className=\\\"text-[13px] font-medium leading-[20px] text-[#102A43]\\\">\\n                    {activeStage.statusFlow}\\n                  </p>\\n                </div>\\n\\n                <div className=\\\"rounded-[0.75rem] bg-white border border-[#D7E0E8] p-4 space-y-1.5\\\">\\n                  <div className=\\\"flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-[0.08em] text-[#526579]\\\">\\n                    <ShieldCheck size={14} className=\\\"text-[#0F766E]\\\" aria-hidden=\\\"true\\\" />\\n                    <span>Built-In Safeguard</span>\\n                  </div>\\n                  <p className=\\\"text-[13px] leading-[20px] text-[#172B4D]\\\">\\n                    {activeStage.safeguard}\\n                  </p>\\n                </div>\\n\\n                <div className=\\\"rounded-[0.75rem] bg-white border border-[#D7E0E8] p-4 space-y-1.5\\\">\\n                  <div className=\\\"flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-[0.08em] text-[#526579]\\\">\\n                    <CheckSquare size={14} className=\\\"text-[#102A43]\\\" aria-hidden=\\\"true\\\" />\\n                    <span>Team Action</span>\\n                  </div>\\n                  <p className=\\\"text-[13px] leading-[20px] text-[#0F766E] font-medium\\\">\\n                    {activeStage.teamAction}\\n                  </p>\\n                </div>\\n\\n                <div className=\\\"rounded-[0.75rem] bg-white border border-[#D7E0E8] p-4 space-y-1.5\\\">\\n                  <div className=\\\"flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-[0.08em] text-[#526579]\\\">\\n                    <ArrowRight size={14} className=\\\"text-[#102A43]\\\" aria-hidden=\\\"true\\\" />\\n                    <span>Automatic Follow-On</span>\\n                  </div>\\n                  <p className=\\\"text-[13px] leading-[20px] text-[#102A43] font-medium\\\">\\n                    {activeStage.automaticResult}\\n                  </p>\\n                </div>\\n              </div>\\n            </div>\\n          </motion.div>\\n        </AnimatePresence>\\n      </div>\\n    </section>\\n  );\\n}\", \"StartLine\":1, \"TargetContent\":\"import React, { useState } from \'react\';\\nimport { AnimatePresence, motion } from \'motion/react\';\\nimport { ArrowRight, GitCommitHorizontal, ShieldCheck, Terminal } from \'lucide-react\';\\nimport { PhaseBadge, Reveal, WorkflowPipeline } from \'@metr/ui\';\\nimport { ENTERPRISE_JOURNEYS } from \'../data/metrContent\';\\n\\nexport function ConnectedWorkflowSection() {\\n  const [selectedJourneyId, setSelectedJourneyId] = useState(ENTERPRISE_JOURNEYS[0].id);\\n  const currentJourney =\\n    ENTERPRISE_JOURNEYS.find((j) => j.id === selectedJourneyId) ?? ENTERPRISE_JOURNEYS[0];\\n\\n  const [selectedStageByJourney, setSelectedStageByJourney] = useState<Record<string, string>>({\\n    \'lead-to-cash\': \'ledger\',\\n    \'procure-to-pay\': \'bill\',\\n    \'contract-to-renewal\': \'renewal\',\\n  });\\n\\n  const activeStageId =\\n    selectedStageByJourney[currentJourney.id] ?? currentJourney.stages[0].id;\\n  const activeStage =\\n    currentJourney.stages.find((s) => s.id === activeStageId) ?? currentJourney.stages[0];\\n\\n  const handleSelectStage = (stageId: string) => {\\n    setSelectedStageByJourney((prev) => ({\\n      ...prev,\\n      [currentJourney.id]: stageId,\\n    }));\\n  };\\n\\n  return (\\n    <section id=\\\"workflow\\\" className=\\\"bg-white border-b border-[#E5EBF0] py-16 lg:py-24\\\">\\n      <div className=\\\"mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-12\\\">\\n        <Reveal>\\n          <div className=\\\"flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-10\\\">\\n            <div className=\\\"max-w-2xl\\\">\\n              <p className=\\\"text-[11px] font-bold uppercase tracking-[0.08em] text-[#0F766E] mb-3\\\">\\n                Connected Movement \302\267 Section A6 & A7\\n              </p>\\n              <h2 className=\\\"font-[Manrope] text-[28px] sm:text-[36px] lg:text-[40px] font-bold leading-[1.2] tracking-[-0.02em] text-[#102A43]\\\">\\n                Controlled state transitions from first touch to posted ledger.\\n              </h2>\\n              <p className=\\\"mt-3 text-[15px] sm:text-[16px] leading-[26px] text-[#526579]\\\">\\n                Select an enterprise journey and click any stage node to inspect its enforced state\\n                machine, critical accounting invariant, REST endpoint, and transactional outbox event.\\n              </p>\\n            </div>\\n\\n            {/* Segmented Journey Switcher */}\\n            <div\\n              role=\\\"group\\\"\\n              aria-label=\\\"Select enterprise journey\\\"\\n              className=\\\"inline-flex flex-wrap items-center gap-1 rounded-[0.75rem] bg-[#F5F7FA] p-1 border border-[#D7E0E8] self-start lg:self-auto\\\"\\n            >\\n              {ENTERPRISE_JOURNEYS.map((journey) => {\\n                const active = journey.id === currentJourney.id;\\n                return (\\n                  <button\\n                    key={journey.id}\\n                    type=\\\"button\\\"\\n                    aria-pressed={active}\\n                    onClick={() => setSelectedJourneyId(journey.id)}\\n                    className={`px-3.5 py-2 rounded-[0.5rem] text-[13px] font-semibold transition-colors whitespace-nowrap shrink-0 metr-focus ${\\n                      active\\n                        ? \'bg-white text-[#102A43] shadow-[0_1px_2px_rgba(16,42,69,0.08)]\'\\n                        : \'text-[#526579] hover:text-[#172B4D]\'\\n                    }`}\\n                  >\\n                    <span className=\\\"font-mono text-[11px] mr-1.5 text-[#0F766E]\\\">\\n                      {journey.code}\\n                    </span>{\' \'}\\n                    {journey.title}\\n                  </button>\\n                );\\n              })}\\n            </div>\\n          </div>\\n        </Reveal>\\n\\n        {/* Journey Context Header */}\\n        <div className=\\\"mb-6 flex flex-wrap items-center justify-between gap-3\\\">\\n          <p className=\\\"text-[14px] text-[#3E4947] max-w-3xl\\\">{currentJourney.description}</p>\\n          <PhaseBadge phase={currentJourney.phase} />\\n        </div>\\n\\n        {/* Horizontal Connected Movement Pipeline */}\\n        <WorkflowPipeline\\n          stages={currentJourney.stages}\\n          activeStageId={activeStage.id}\\n          onSelectStage={handleSelectStage}\\n        />\\n\\n        {/* Selected Stage Architectural Inspector */}\\n        <AnimatePresence mode=\\\"wait\\\">\\n          <motion.div\\n            key={`${currentJourney.id}-${activeStage.id}`}\\n            initial={{ opacity: 0, y: 10 }}\\n            animate={{ opacity: 1, y: 0 }}\\n            exit={{ opacity: 0, y: -6 }}\\n            transition={{ duration: 0.22, ease: [0.16, 1, 0.3, 1] }}\\n            className=\\\"mt-6 rounded-[1rem] border border-[#D7E0E8] bg-[#F5F7FA] p-6 lg:p-7\\\"\\n          >\\n            <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\\\">\\n              <div className=\\\"lg:col-span-5 space-y-2\\\">\\n                <div className=\\\"flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.08em] text-[#0F766E]\\\">\\n                  <span>Stage Detail</span>\\n                  <span aria-hidden=\\\"true\\\">\302\267</span>\\n                  <span className=\\\"font-mono\\\">{activeStage.docCode}</span>\\n                </div>\\n                <h3 className=\\\"font-[Manrope] text-[22px] font-bold text-[#102A43]\\\">\\n                  {activeStage.label} \342\200\224 {activeStage.statusLabel}\\n                </h3>\\n                <p className=\\\"text-[15px] leading-[24px] text-[#3E4947]\\\">\\n                  {activeStage.summary}\\n                </p>\\n              </div>\\n\\n              <div className=\\\"lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                <div className=\\\"rounded-[0.75rem] bg-white border border-[#D7E0E8] p-4 space-y-1.5\\\">\\n                  <div className=\\\"flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-[0.08em] text-[#526579]\\\">\\n                    <GitCommitHorizontal size={14} className=\\\"text-[#0F766E]\\\" aria-hidden=\\\"true\\\" />\\n                    <span>Allowed Transitions</span>\\n                  </div>\\n                  <p className=\\\"font-mono text-[12px] leading-[20px] text-[#102A43] break-words\\\">\\n                    {activeStage.stateMachine}\\n                  </p>\\n                </div>\\n\\n                <div className=\\\"rounded-[0.75rem] bg-white border border-[#D7E0E8] p-4 space-y-1.5\\\">\\n                  <div className=\\\"flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-[0.08em] text-[#526579]\\\">\\n                    <ShieldCheck size={14} className=\\\"text-[#0F766E]\\\" aria-hidden=\\\"true\\\" />\\n                    <span>Critical Invariant</span>\\n                  </div>\\n                  <p className=\\\"text-[13px] leading-[20px] text-[#172B4D]\\\">\\n                    {activeStage.invariant}\\n                  </p>\\n                </div>\\n\\n                <div className=\\\"rounded-[0.75rem] bg-white border border-[#D7E0E8] p-4 space-y-1.5\\\">\\n                  <div className=\\\"flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-[0.08em] text-[#526579]\\\">\\n                    <Terminal size={14} className=\\\"text-[#102A43]\\\" aria-hidden=\\\"true\\\" />\\n                    <span>API Endpoint</span>\\n                  </div>\\n                  <p className=\\\"font-mono text-[12px] text-[#0F766E] font-medium\\\">\\n                    {activeStage.endpoint}\\n                  </p>\\n                </div>\\n\\n                <div className=\\\"rounded-[0.75rem] bg-white border border-[#D7E0E8] p-4 space-y-1.5\\\">\\n                  <div className=\\\"flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-[0.08em] text-[#526579]\\\">\\n                    <ArrowRight size={14} className=\\\"text-[#102A43]\\\" aria-hidden=\\\"true\\\" />\\n                    <span>Outbox Event Key</span>\\n                  </div>\\n                  <p className=\\\"font-mono text-[12px] text-[#102A43] font-medium\\\">\\n                    {activeStage.outboxEvent}\\n                  </p>\\n                </div>\\n              </div>\\n            </div>\\n          </motion.div>\\n        </AnimatePresence>\\n      </div>\\n    </section>\\n  );\\n}\", \"TargetFile\":\"/apps/web/src/components/ConnectedWorkflowSection.tsx\", \"toolAction\":\"Updating ConnectedWorkflowSection to business language\", \"toolSummary\":\"Update ConnectedWorkflowSection.tsx\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_16039954103718412615"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Remove schema names, table counts, REST endpoints, and PDF requirement IDs from ModulesGridSection\", \"EndLine\":272, \"Instruction\":\"Update ModulesGridSection so module cards and the expanded detail drawer present clean business categories, included tools, and team workflows without SQL schema names, table counts, P0/P1 codes, or CRM-01/FIN-01 requirement IDs.\", \"ReplacementContent\":\"import React, { useEffect, useMemo, useRef, useState } from \'react\';\\nimport { AnimatePresence, motion } from \'motion/react\';\\nimport {\\n  ArrowUpRight,\\n  Briefcase,\\n  CheckCircle2,\\n  Layers,\\n  Link2,\\n  X,\\n} from \'lucide-react\';\\nimport type { ReleasePhase } from \'@metr/contracts\';\\nimport { PhaseBadge, Reveal } from \'@metr/ui\';\\nimport { ERP_MODULES, type ErpModuleItem } from \'../data/metrContent\';\\n\\ntype PhaseFilter = \'All\' | ReleasePhase;\\n\\nconst FILTER_OPTIONS: { value: PhaseFilter; label: string }[] = [\\n  { value: \'All\', label: \'All Modules\' },\\n  { value: \'Phase 1\', label: \'Phase 1: Core\' },\\n  { value: \'Phase 2\', label: \'Phase 2: Operations\' },\\n  { value: \'Phase 3\', label: \'Phase 3: Expansion\' },\\n];\\n\\nexport function ModulesGridSection() {\\n  const [phaseFilter, setPhaseFilter] = useState<PhaseFilter>(\'All\');\\n  const [selectedModule, setSelectedModule] = useState<ErpModuleItem | null>(null);\\n  const inspectorRef = useRef<HTMLDivElement | null>(null);\\n\\n  useEffect(() => {\\n    if (selectedModule && inspectorRef.current) {\\n      inspectorRef.current.scrollIntoView({ behavior: \'smooth\', block: \'nearest\' });\\n    }\\n  }, [selectedModule]);\\n\\n  const visibleModules = useMemo(() => {\\n    if (phaseFilter === \'All\') return ERP_MODULES;\\n    return ERP_MODULES.filter((mod) => mod.phase === phaseFilter);\\n  }, [phaseFilter]);\\n\\n  return (\\n    <section id=\\\"modules\\\" className=\\\"bg-[#F5F7FA] border-b border-[#E5EBF0] py-16 lg:py-24\\\">\\n      <div className=\\\"mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-12\\\">\\n        <Reveal>\\n          <div className=\\\"flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-10\\\">\\n            <div className=\\\"max-w-2xl\\\">\\n              <p className=\\\"text-[11px] font-bold uppercase tracking-[0.08em] text-[#0F766E] mb-3\\\">\\n                Platform Modules\\n              </p>\\n              <h2 className=\\\"font-[Manrope] text-[28px] sm:text-[36px] lg:text-[40px] font-bold leading-[1.2] tracking-[-0.02em] text-[#102A43]\\\">\\n                12 connected modules. One unified workspace.\\n              </h2>\\n              <p className=\\\"mt-3 text-[15px] sm:text-[16px] leading-[26px] text-[#526579]\\\">\\n                Start with core sales, invoicing, and accounting\342\200\224then activate purchasing,\\n                inventory, projects, and HR as your business grows. Click any module to explore\\n                what it includes.\\n              </p>\\n            </div>\\n\\n            {/* Interactive Phase Filter Bar */}\\n            <div className=\\\"flex flex-col items-start lg:items-end gap-2\\\">\\n              <div\\n                role=\\\"group\\\"\\n                aria-label=\\\"Filter modules by rollout phase\\\"\\n                className=\\\"inline-flex flex-wrap items-center gap-1 rounded-[0.75rem] bg-white p-1 border border-[#D7E0E8]\\\"\\n              >\\n                {FILTER_OPTIONS.map((opt) => {\\n                  const active = phaseFilter === opt.value;\\n                  return (\\n                    <button\\n                      key={opt.value}\\n                      type=\\\"button\\\"\\n                      aria-pressed={active}\\n                      onClick={() => setPhaseFilter(opt.value)}\\n                      className={`px-3.5 py-2 rounded-[0.5rem] text-[13px] font-semibold transition-colors whitespace-nowrap shrink-0 metr-focus ${\\n                        active\\n                          ? \'bg-[#0F766E] text-white\'\\n                          : \'text-[#526579] hover:text-[#172B4D] hover:bg-[#F5F7FA]\'\\n                      }`}\\n                    >\\n                      {opt.label}\\n                    </button>\\n                  );\\n                })}\\n              </div>\\n              <p className=\\\"text-[12px] font-medium text-[#526579] font-tabular\\\">\\n                Showing {visibleModules.length} business{\' \'}\\n                {visibleModules.length === 1 ? \'module\' : \'modules\'}\\n              </p>\\n            </div>\\n          </div>\\n        </Reveal>\\n\\n        {/* Modules Grid */}\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\\\">\\n          {visibleModules.map((mod, idx) => {\\n            const isSelected = selectedModule?.id === mod.id;\\n            return (\\n              <motion.button\\n                key={mod.id}\\n                type=\\\"button\\\"\\n                layout=\\\"position\\\"\\n                initial={{ opacity: 0, y: 12 }}\\n                whileInView={{ opacity: 1, y: 0 }}\\n                viewport={{ once: true, amount: 0.1 }}\\n                transition={{\\n                  duration: 0.3,\\n                  delay: Math.min(idx * 0.04, 0.2),\\n                  ease: [0.16, 1, 0.3, 1],\\n                }}\\n                onClick={() => setSelectedModule(isSelected ? null : mod)}\\n                aria-expanded={isSelected}\\n                className={`metr-card metr-card-interactive text-left rounded-[1rem] p-6 flex flex-col justify-between gap-5 metr-focus ${\\n                  isSelected\\n                    ? \'border-[#0F766E] ring-2 ring-[#0F766E]/15\'\\n                    : \'\'\\n                }`}\\n              >\\n                <div className=\\\"space-y-3\\\">\\n                  {/* Clean category + Phase indicator */}\\n                  <div className=\\\"flex items-center justify-between gap-3\\\">\\n                    <span className=\\\"text-[11px] font-bold uppercase tracking-[0.08em] text-[#526579] truncate\\\">\\n                      {mod.category}\\n                    </span>\\n                    <PhaseBadge phase={mod.phase} />\\n                  </div>\\n\\n                  <div>\\n                    <h3 className=\\\"font-[Manrope] text-[20px] font-bold leading-[28px] tracking-[-0.01em] text-[#102A43]\\\">\\n                      {mod.name}\\n                    </h3>\\n                    <p className=\\\"mt-2 text-[14px] leading-[22px] text-[#3E4947]\\\">\\n                      {mod.summary}\\n                    </p>\\n                  </div>\\n                </div>\\n\\n                {/* Clean footer row */}\\n                <div className=\\\"pt-4 border-t border-[#E5EBF0] flex items-center justify-between gap-3\\\">\\n                  <span className=\\\"text-[12px] font-medium text-[#526579] font-tabular\\\">\\n                    {mod.includedTools.length} core capabilities\\n                  </span>\\n                  <span className=\\\"inline-flex items-center gap-1 text-[12px] font-semibold text-[#0F766E] whitespace-nowrap shrink-0\\\">\\n                    {isSelected ? \'Viewing below\' : \'Explore module\'}\\n                    <ArrowUpRight size={14} aria-hidden=\\\"true\\\" />\\n                  </span>\\n                </div>\\n              </motion.button>\\n            );\\n          })}\\n        </div>\\n\\n        {/* Interactive Module Details Panel */}\\n        <AnimatePresence>\\n          {selectedModule && (\\n            <motion.div\\n              ref={inspectorRef}\\n              key={selectedModule.id}\\n              initial={{ opacity: 0, y: 14 }}\\n              animate={{ opacity: 1, y: 0 }}\\n              exit={{ opacity: 0, y: 8 }}\\n              transition={{ duration: 0.24, ease: [0.16, 1, 0.3, 1] }}\\n              role=\\\"region\\\"\\n              aria-label={`${selectedModule.name} details`}\\n              className=\\\"mt-8 rounded-[1.5rem] bg-[#102A43] text-white border border-[#172B4D] p-6 sm:p-8 shadow-[0_16px_36px_-8px_rgba(16,42,69,0.22)]\\\"\\n            >\\n              <div className=\\\"flex flex-wrap items-start justify-between gap-4 pb-6 border-b border-white/10\\\">\\n                <div className=\\\"space-y-1.5\\\">\\n                  <div className=\\\"flex items-center gap-2.5 text-[11px] font-bold uppercase tracking-[0.08em] text-[#2DD4BF]\\\">\\n                    <span>{selectedModule.category}</span>\\n                    <span aria-hidden=\\\"true\\\">\302\267</span>\\n                    <span>{selectedModule.phase}</span>\\n                  </div>\\n                  <h3 className=\\\"font-[Manrope] text-[24px] sm:text-[28px] font-bold text-white\\\">\\n                    {selectedModule.name}\\n                  </h3>\\n                </div>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setSelectedModule(null)}\\n                  aria-label=\\\"Close module details\\\"\\n                  className=\\\"inline-flex items-center gap-1.5 rounded-[0.5rem] bg-white/10 hover:bg-white/15 px-3.5 py-2 text-[13px] font-semibold text-white transition-colors metr-focus\\\"\\n                >\\n                  <X size={15} aria-hidden=\\\"true\\\" />\\n                  Close Details\\n                </button>\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 pt-6\\\">\\n                {/* Business Scope & Connections */}\\n                <div className=\\\"lg:col-span-5 space-y-4\\\">\\n                  <div className=\\\"rounded-[0.75rem] bg-[#0B1724] border border-white/10 p-4 space-y-1.5\\\">\\n                    <div className=\\\"flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.08em] text-[#2DD4BF]\\\">\\n                      <Layers size={14} aria-hidden=\\\"true\\\" />\\n                      <span>What This Module Manages</span>\\n                    </div>\\n                    <p className=\\\"text-[14px] leading-[22px] text-[#EDF0FF]\\\">\\n                      {selectedModule.manages}\\n                    </p>\\n                  </div>\\n\\n                  <div className=\\\"rounded-[0.75rem] bg-[#0B1724] border border-white/10 p-4 space-y-1.5\\\">\\n                    <div className=\\\"flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.08em] text-[#B0C9E8]\\\">\\n                      <Link2 size={14} aria-hidden=\\\"true\\\" />\\n                      <span>Connects Seamlessly With</span>\\n                    </div>\\n                    <p className=\\\"text-[14px] leading-[22px] text-[#D1E4FF]\\\">\\n                      {selectedModule.connectsWith}\\n                    </p>\\n                  </div>\\n                </div>\\n\\n                {/* Included Tools & Key Team Workflows */}\\n                <div className=\\\"lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                  <div className=\\\"rounded-[0.75rem] bg-[#0B1724] border border-white/10 p-5\\\">\\n                    <div className=\\\"flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.08em] text-[#2DD4BF] mb-3\\\">\\n                      <Briefcase size={14} aria-hidden=\\\"true\\\" />\\n                      <span>Included Capabilities</span>\\n                    </div>\\n                    <ul className=\\\"space-y-2\\\">\\n                      {selectedModule.includedTools.map((tool) => (\\n                        <li\\n                          key={tool}\\n                          className=\\\"text-[13px] text-[#EDF0FF] py-1 border-b border-white/[0.06] last:border-b-0\\\"\\n                        >\\n                          {tool}\\n                        </li>\\n                      ))}\\n                    </ul>\\n                  </div>\\n\\n                  <div className=\\\"rounded-[0.75rem] bg-[#0B1724] border border-white/10 p-5\\\">\\n                    <div className=\\\"flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.08em] text-[#2DD4BF] mb-3\\\">\\n                      <CheckCircle2 size={14} aria-hidden=\\\"true\\\" />\\n                      <span>Key Team Workflows</span>\\n                    </div>\\n                    <ul className=\\\"space-y-2\\\">\\n                      {selectedModule.keyWorkflows.map((wf) => (\\n                        <li\\n                          key={wf}\\n                          className=\\\"text-[13px] text-[#9CF2E8] py-1 border-b border-white/[0.06] last:border-b-0\\\"\\n                        >\\n                          {wf}\\n                        </li>\\n                      ))}\\n                    </ul>\\n                  </div>\\n                </div>\\n              </div>\\n            </motion.div>\\n          )}\\n        </AnimatePresence>\\n      </div>\\n    </section>\\n  );\\n}\", \"StartLine\":1, \"TargetContent\":\"import React, { useEffect, useMemo, useRef, useState } from \'react\';\\nimport { AnimatePresence, motion } from \'motion/react\';\\nimport {\\n  ArrowUpRight,\\n  Database,\\n  Layers,\\n  Lock,\\n  Terminal,\\n  X,\\n} from \'lucide-react\';\\nimport type { ReleasePhase } from \'@metr/contracts\';\\nimport { PhaseBadge, Reveal } from \'@metr/ui\';\\nimport { ERP_MODULES, type ErpModuleItem } from \'../data/metrContent\';\\n\\ntype PhaseFilter = \'All\' | ReleasePhase;\\n\\nconst FILTER_OPTIONS: { value: PhaseFilter; label: string }[] = [\\n  { value: \'All\', label: \'All Domains\' },\\n  { value: \'Phase 1\', label: \'Phase 1: Core\' },\\n  { value: \'Phase 2\', label: \'Phase 2: Operations\' },\\n  { value: \'Phase 3\', label: \'Phase 3: Expansion\' },\\n];\\n\\nexport function ModulesGridSection() {\\n  const [phaseFilter, setPhaseFilter] = useState<PhaseFilter>(\'All\');\\n  const [selectedModule, setSelectedModule] = useState<ErpModuleItem | null>(null);\\n  const inspectorRef = useRef<HTMLDivElement | null>(null);\\n\\n  useEffect(() => {\\n    if (selectedModule && inspectorRef.current) {\\n      inspectorRef.current.scrollIntoView({ behavior: \'smooth\', block: \'nearest\' });\\n    }\\n  }, [selectedModule]);\\n\\n  const visibleModules = useMemo(() => {\\n    if (phaseFilter === \'All\') return ERP_MODULES;\\n    return ERP_MODULES.filter((mod) => mod.phase === phaseFilter);\\n  }, [phaseFilter]);\\n\\n  const totalEntitiesShown = useMemo(\\n    () => visibleModules.reduce((acc, mod) => acc + mod.entityCount, 0),\\n    [visibleModules]\\n  );\\n\\n  return (\\n    <section id=\\\"modules\\\" className=\\\"bg-[#F5F7FA] border-b border-[#E5EBF0] py-16 lg:py-24\\\">\\n      <div className=\\\"mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-12\\\">\\n        <Reveal>\\n          <div className=\\\"flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-10\\\">\\n            <div className=\\\"max-w-2xl\\\">\\n              <p className=\\\"text-[11px] font-bold uppercase tracking-[0.08em] text-[#0F766E] mb-3\\\">\\n                Modular Domain Inventory \302\267 Section B5 & C7\\n              </p>\\n              <h2 className=\\\"font-[Manrope] text-[28px] sm:text-[36px] lg:text-[40px] font-bold leading-[1.2] tracking-[-0.02em] text-[#102A43]\\\">\\n                15 isolated schemas. One coherent data model.\\n              </h2>\\n              <p className=\\\"mt-3 text-[15px] sm:text-[16px] leading-[26px] text-[#526579]\\\">\\n                Every module owns its aggregate rules and PostgreSQL tables. Cross-module writes\\n                orchestrate atomically without uncontrolled table mutations. Click any domain to\\n                inspect its canonical entities and REST contract.\\n              </p>\\n            </div>\\n\\n            {/* Interactive Phase Filter Bar */}\\n            <div className=\\\"flex flex-col items-start lg:items-end gap-2\\\">\\n              <div\\n                role=\\\"group\\\"\\n                aria-label=\\\"Filter modules by rollout phase\\\"\\n                className=\\\"inline-flex flex-wrap items-center gap-1 rounded-[0.75rem] bg-white p-1 border border-[#D7E0E8]\\\"\\n              >\\n                {FILTER_OPTIONS.map((opt) => {\\n                  const active = phaseFilter === opt.value;\\n                  return (\\n                    <button\\n                      key={opt.value}\\n                      type=\\\"button\\\"\\n                      aria-pressed={active}\\n                      onClick={() => setPhaseFilter(opt.value)}\\n                      className={`px-3.5 py-2 rounded-[0.5rem] text-[13px] font-semibold transition-colors whitespace-nowrap shrink-0 metr-focus ${\\n                        active\\n                          ? \'bg-[#0F766E] text-white\'\\n                          : \'text-[#526579] hover:text-[#172B4D] hover:bg-[#F5F7FA]\'\\n                      }`}\\n                    >\\n                      {opt.label}\\n                    </button>\\n                  );\\n                })}\\n              </div>\\n              <p className=\\\"text-[12px] font-medium text-[#526579] font-tabular\\\">\\n                Showing {visibleModules.length} domain groups \302\267 {totalEntitiesShown} canonical\\n                entities\\n              </p>\\n            </div>\\n          </div>\\n        </Reveal>\\n\\n        {/* Modules Grid */}\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\\\">\\n          {visibleModules.map((mod, idx) => {\\n            const isSelected = selectedModule?.id === mod.id;\\n            return (\\n              <motion.button\\n                key={mod.id}\\n                type=\\\"button\\\"\\n                layout=\\\"position\\\"\\n                initial={{ opacity: 0, y: 12 }}\\n                whileInView={{ opacity: 1, y: 0 }}\\n                viewport={{ once: true, amount: 0.1 }}\\n                transition={{\\n                  duration: 0.3,\\n                  delay: Math.min(idx * 0.04, 0.2),\\n                  ease: [0.16, 1, 0.3, 1],\\n                }}\\n                onClick={() => setSelectedModule(isSelected ? null : mod)}\\n                aria-expanded={isSelected}\\n                className={`metr-card metr-card-interactive text-left rounded-[1rem] p-6 flex flex-col justify-between gap-5 metr-focus ${\\n                  isSelected\\n                    ? \'border-[#0F766E] ring-2 ring-[#0F766E]/15\'\\n                    : \'\'\\n                }`}\\n              >\\n                <div className=\\\"space-y-3\\\">\\n                  {/* Quiet top metadata + Phase indicator */}\\n                  <div className=\\\"flex items-center justify-between gap-3\\\">\\n                    <span className=\\\"font-mono text-[12px] font-medium text-[#526579] truncate\\\">\\n                      {mod.schema}\\n                    </span>\\n                    <PhaseBadge phase={mod.phase} />\\n                  </div>\\n\\n                  <div>\\n                    <h3 className=\\\"font-[Manrope] text-[20px] font-bold leading-[28px] tracking-[-0.01em] text-[#102A43]\\\">\\n                      {mod.name}\\n                    </h3>\\n                    <p className=\\\"mt-2 text-[14px] leading-[22px] text-[#3E4947]\\\">\\n                      {mod.summary}\\n                    </p>\\n                  </div>\\n                </div>\\n\\n                {/* Clean footer row with unboxed metadata */}\\n                <div className=\\\"pt-4 border-t border-[#E5EBF0] flex items-center justify-between gap-3\\\">\\n                  <div className=\\\"flex items-center gap-2 text-[12px] font-medium text-[#526579] font-tabular\\\">\\n                    <span>{mod.entityCount} tables</span>\\n                    <span aria-hidden=\\\"true\\\">\302\267</span>\\n                    <span>{mod.priority}</span>\\n                    <span aria-hidden=\\\"true\\\">\302\267</span>\\n                    <span>{mod.requirementIds[0]}</span>\\n                  </div>\\n                  <span className=\\\"inline-flex items-center gap-1 text-[12px] font-semibold text-[#0F766E] whitespace-nowrap shrink-0\\\">\\n                    {isSelected ? \'Inspecting below\' : \'Inspect schema\'}\\n                    <ArrowUpRight size={14} aria-hidden=\\\"true\\\" />\\n                  </span>\\n                </div>\\n              </motion.button>\\n            );\\n          })}\\n        </div>\\n\\n        {/* Interactive Schema & Domain Boundary Inspector Panel */}\\n        <AnimatePresence>\\n          {selectedModule && (\\n            <motion.div\\n              ref={inspectorRef}\\n              key={selectedModule.id}\\n              initial={{ opacity: 0, y: 14 }}\\n              animate={{ opacity: 1, y: 0 }}\\n              exit={{ opacity: 0, y: 8 }}\\n              transition={{ duration: 0.24, ease: [0.16, 1, 0.3, 1] }}\\n              role=\\\"region\\\"\\n              aria-label={`${selectedModule.name} schema inspector`}\\n              className=\\\"mt-8 rounded-[1.5rem] bg-[#102A43] text-white border border-[#172B4D] p-6 sm:p-8 shadow-[0_16px_36px_-8px_rgba(16,42,69,0.22)]\\\"\\n            >\\n              <div className=\\\"flex flex-wrap items-start justify-between gap-4 pb-6 border-b border-white/10\\\">\\n                <div className=\\\"space-y-1.5\\\">\\n                  <div className=\\\"flex items-center gap-2.5 text-[11px] font-bold uppercase tracking-[0.08em] text-[#2DD4BF]\\\">\\n                    <span className=\\\"font-mono\\\">{selectedModule.schema}</span>\\n                    <span aria-hidden=\\\"true\\\">\302\267</span>\\n                    <span>{selectedModule.entityCount} Canonical Tables</span>\\n                    <span aria-hidden=\\\"true\\\">\302\267</span>\\n                    <span>{selectedModule.phase}</span>\\n                  </div>\\n                  <h3 className=\\\"font-[Manrope] text-[24px] sm:text-[28px] font-bold text-white\\\">\\n                    {selectedModule.name}\\n                  </h3>\\n                </div>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setSelectedModule(null)}\\n                  aria-label=\\\"Close schema inspector\\\"\\n                  className=\\\"inline-flex items-center gap-1.5 rounded-[0.5rem] bg-white/10 hover:bg-white/15 px-3.5 py-2 text-[13px] font-semibold text-white transition-colors metr-focus\\\"\\n                >\\n                  <X size={15} aria-hidden=\\\"true\\\" />\\n                  Close Inspector\\n                </button>\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 pt-6\\\">\\n                {/* Domain Ownership & Reference Rules (Section B5) */}\\n                <div className=\\\"lg:col-span-5 space-y-4\\\">\\n                  <div className=\\\"rounded-[0.75rem] bg-[#0B1724] border border-white/10 p-4 space-y-1.5\\\">\\n                    <div className=\\\"flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.08em] text-[#2DD4BF]\\\">\\n                      <Layers size={14} aria-hidden=\\\"true\\\" />\\n                      <span>Aggregate Ownership</span>\\n                    </div>\\n                    <p className=\\\"text-[14px] leading-[22px] text-[#EDF0FF]\\\">\\n                      {selectedModule.owns}\\n                    </p>\\n                  </div>\\n\\n                  <div className=\\\"rounded-[0.75rem] bg-[#0B1724] border border-white/10 p-4 space-y-1.5\\\">\\n                    <div className=\\\"flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.08em] text-[#B0C9E8]\\\">\\n                      <Lock size={14} aria-hidden=\\\"true\\\" />\\n                      <span>May Reference (No Direct Mutation)</span>\\n                    </div>\\n                    <p className=\\\"text-[14px] leading-[22px] text-[#D1E4FF]\\\">\\n                      {selectedModule.referencesOnly}\\n                    </p>\\n                  </div>\\n\\n                  <div className=\\\"text-[12px] text-[#B0C9E8] font-mono\\\">\\n                    Requirement IDs: {selectedModule.requirementIds.join(\' \302\267 \')}\\n                  </div>\\n                </div>\\n\\n                {/* Canonical Entities & Representative Endpoints */}\\n                <div className=\\\"lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                  <div className=\\\"rounded-[0.75rem] bg-[#0B1724] border border-white/10 p-5\\\">\\n                    <div className=\\\"flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.08em] text-[#2DD4BF] mb-3\\\">\\n                      <Database size={14} aria-hidden=\\\"true\\\" />\\n                      <span>Key Canonical Tables (C7)</span>\\n                    </div>\\n                    <ul className=\\\"space-y-2\\\">\\n                      {selectedModule.keyEntities.map((tableName) => (\\n                        <li\\n                          key={tableName}\\n                          className=\\\"font-mono text-[13px] text-[#EDF0FF] py-1 border-b border-white/[0.06] last:border-b-0\\\"\\n                        >\\n                          {tableName}\\n                        </li>\\n                      ))}\\n                    </ul>\\n                  </div>\\n\\n                  <div className=\\\"rounded-[0.75rem] bg-[#0B1724] border border-white/10 p-5\\\">\\n                    <div className=\\\"flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.08em] text-[#2DD4BF] mb-3\\\">\\n                      <Terminal size={14} aria-hidden=\\\"true\\\" />\\n                      <span>REST Endpoints (/api/v1)</span>\\n                    </div>\\n                    <ul className=\\\"space-y-2\\\">\\n                      {selectedModule.endpoints.map((ep) => (\\n                        <li\\n                          key={ep}\\n                          className=\\\"font-mono text-[12px] text-[#9CF2E8] py-1 border-b border-white/[0.06] last:border-b-0 break-all\\\"\\n                        >\\n                          {ep}\\n                        </li>\\n                      ))}\\n                    </ul>\\n                  </div>\\n                </div>\\n              </div>\\n            </motion.div>\\n          )}\\n        </AnimatePresence>\\n      </div>\\n    </section>\\n  );\\n}\", \"TargetFile\":\"/apps/web/src/components/ModulesGridSection.tsx\", \"toolAction\":\"Updating ModulesGridSection to business language\", \"toolSummary\":\"Update ModulesGridSection.tsx\"}"
