      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Remove internal PDF document codes from WorkflowPipeline cards and translate fields to plain business terms\", \"EndLine\":105, \"Instruction\":\"Update WorkflowStage interface to use business-friendly fields (statusFlow, safeguard, teamAction, automaticResult) and remove docCode badges from step cards so they display clean step numbers (Step 01\342\200\22306) and \'Books Balanced\'.\", \"ReplacementContent\":\"export interface WorkflowStage {\\n  id: string;\\n  label: string;\\n  statusLabel: string;\\n  summary: string;\\n  statusFlow: string;\\n  safeguard: string;\\n  teamAction: string;\\n  automaticResult: string;\\n  isTerminalLedger?: boolean;\\n}\\n\\nexport interface WorkflowPipelineProps {\\n  stages: WorkflowStage[];\\n  activeStageId: string;\\n  onSelectStage: (stageId: string) => void;\\n}\\n\\n/**\\n * \\\"Connected Movement\\\" Signature Component:\\n * Horizontal lifecycle pipeline linked by 2px #D7E0E8 connectors with centered 8px circular nodes.\\n * Active/completed stages illuminate to solid #0F766E with a #2DD4BF interior accelerator node.\\n */\\nexport function WorkflowPipeline({\\n  stages,\\n  activeStageId,\\n  onSelectStage,\\n}: WorkflowPipelineProps) {\\n  const activeIndex = Math.max(\\n    0,\\n    stages.findIndex((s) => s.id === activeStageId)\\n  );\\n\\n  return (\\n    <div\\n      className=\\\"w-full\\\"\\n      role=\\\"tablist\\\"\\n      aria-label=\\\"Connected business workflow stages\\\"\\n    >\\n      <div className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4 lg:gap-0 items-stretch\\\">\\n        {stages.map((stage, idx) => {\\n          const isCompleted = idx < activeIndex;\\n          const isActive = idx === activeIndex;\\n          const isIlluminated = isCompleted || isActive;\\n\\n          return (\\n            <div key={stage.id} className=\\\"flex items-center\\\">\\n              <motion.button\\n                type=\\\"button\\\"\\n                role=\\\"tab\\\"\\n                aria-selected={isActive}\\n                onClick={() => onSelectStage(stage.id)}\\n                whileHover={{ y: -2 }}\\n                transition={{ duration: 0.16, ease: [0.16, 1, 0.3, 1] }}\\n                className={`relative w-full h-full text-left rounded-[0.75rem] p-5 border transition-all duration-150 metr-focus flex flex-col justify-between gap-3 ${\\n                  isActive\\n                    ? \'bg-white border-[#0F766E] shadow-[0_10px_24px_-4px_rgba(16,42,69,0.08),0_4px_8px_-2px_rgba(16,42,69,0.04)]\'\\n                    : isCompleted\\n                    ? \'bg-white border-[#0F766E]/35 shadow-[0_1px_3px_rgba(16,42,69,0.04)]\'\\n                    : \'bg-white border-[#D7E0E8] hover:border-[#0F766E]/35 shadow-[0_1px_3px_rgba(16,42,69,0.04)]\'\\n                }`}\\n              >\\n                <div className=\\\"flex items-center justify-between gap-2\\\">\\n                  <span className=\\\"font-tabular text-[11px] font-semibold tracking-[0.04em] uppercase text-[#526579]\\\">\\n                    Step 0{idx + 1}\\n                  </span>\\n                  {stage.isTerminalLedger ? (\\n                    <span className=\\\"inline-flex items-center gap-1 rounded-[0.375rem] bg-[#102A43] px-2 py-0.5 text-[10px] font-semibold text-[#EDF0FF] whitespace-nowrap shrink-0\\\">\\n                      <Lock size={10} aria-hidden=\\\"true\\\" />\\n                      Books Balanced\\n                    </span>\\n                  ) : isCompleted ? (\\n                    <span\\n                      className=\\\"inline-flex h-5 w-5 items-center justify-center rounded-full bg-[#0F766E]/10 text-[#0F766E]\\\"\\n                      aria-hidden=\\\"true\\\"\\n                    >\\n                      <Check size={12} strokeWidth={2.5} />\\n                    </span>\\n                  ) : isActive ? (\\n                    <span\\n                      className=\\\"inline-flex h-2.5 w-2.5 rounded-full bg-[#2DD4BF] ring-4 ring-[#0F766E]/15\\\"\\n                      aria-hidden=\\\"true\\\"\\n                    />\\n                  ) : (\\n                    <span\\n                      className=\\\"inline-flex h-2 w-2 rounded-full bg-[#D7E0E8]\\\"\\n                      aria-hidden=\\\"true\\\"\\n                    />\\n                  )}\\n                </div>\\n\\n                <div>\\n                  <div\\n                    className={`font-[Manrope] text-[16px] font-bold leading-[22px] tracking-[-0.01em] ${\\n                      isActive ? \'text-[#0F766E]\' : \'text-[#172B4D]\'\\n                    }`}\\n                  >\\n                    {stage.label}\\n                  </div>\", \"StartLine\":5, \"TargetContent\":\"export interface WorkflowStage {\\n  id: string;\\n  label: string;\\n  docCode: string;\\n  statusLabel: string;\\n  summary: string;\\n  stateMachine: string;\\n  invariant: string;\\n  endpoint: string;\\n  outboxEvent: string;\\n  isTerminalLedger?: boolean;\\n}\\n\\nexport interface WorkflowPipelineProps {\\n  stages: WorkflowStage[];\\n  activeStageId: string;\\n  onSelectStage: (stageId: string) => void;\\n}\\n\\n/**\\n * \\\"Connected Movement\\\" Signature Component:\\n * Horizontal lifecycle pipeline linked by 2px #D7E0E8 connectors with centered 8px circular nodes.\\n * Active/completed stages illuminate to solid #0F766E with a #2DD4BF interior accelerator node.\\n */\\nexport function WorkflowPipeline({\\n  stages,\\n  activeStageId,\\n  onSelectStage,\\n}: WorkflowPipelineProps) {\\n  const activeIndex = Math.max(\\n    0,\\n    stages.findIndex((s) => s.id === activeStageId)\\n  );\\n\\n  return (\\n    <div\\n      className=\\\"w-full\\\"\\n      role=\\\"tablist\\\"\\n      aria-label=\\\"Connected enterprise transaction stages\\\"\\n    >\\n      <div className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4 lg:gap-0 items-stretch\\\">\\n        {stages.map((stage, idx) => {\\n          const isCompleted = idx < activeIndex;\\n          const isActive = idx === activeIndex;\\n          const isIlluminated = isCompleted || isActive;\\n\\n          return (\\n            <div key={stage.id} className=\\\"flex items-center\\\">\\n              <motion.button\\n                type=\\\"button\\\"\\n                role=\\\"tab\\\"\\n                aria-selected={isActive}\\n                onClick={() => onSelectStage(stage.id)}\\n                whileHover={{ y: -2 }}\\n                transition={{ duration: 0.16, ease: [0.16, 1, 0.3, 1] }}\\n                className={`relative w-full h-full text-left rounded-[0.75rem] p-5 border transition-all duration-150 metr-focus flex flex-col justify-between gap-3 ${\\n                  isActive\\n                    ? \'bg-white border-[#0F766E] shadow-[0_10px_24px_-4px_rgba(16,42,69,0.08),0_4px_8px_-2px_rgba(16,42,69,0.04)]\'\\n                    : isCompleted\\n                    ? \'bg-white border-[#0F766E]/35 shadow-[0_1px_3px_rgba(16,42,69,0.04)]\'\\n                    : \'bg-white border-[#D7E0E8] hover:border-[#0F766E]/35 shadow-[0_1px_3px_rgba(16,42,69,0.04)]\'\\n                }`}\\n              >\\n                <div className=\\\"flex items-center justify-between gap-2\\\">\\n                  <span className=\\\"font-mono font-tabular text-[11px] font-semibold tracking-[0.04em] text-[#526579]\\\">\\n                    0{idx + 1} \302\267 {stage.docCode}\\n                  </span>\\n                  {stage.isTerminalLedger ? (\\n                    <span className=\\\"inline-flex items-center gap-1 rounded-[0.375rem] bg-[#102A43] px-2 py-0.5 text-[10px] font-semibold text-[#EDF0FF] whitespace-nowrap shrink-0\\\">\\n                      <Lock size={10} aria-hidden=\\\"true\\\" />\\n                      GL Balanced\\n                    </span>\\n                  ) : isCompleted ? (\\n                    <span\\n                      className=\\\"inline-flex h-5 w-5 items-center justify-center rounded-full bg-[#0F766E]/10 text-[#0F766E]\\\"\\n                      aria-hidden=\\\"true\\\"\\n                    >\\n                      <Check size={12} strokeWidth={2.5} />\\n                    </span>\\n                  ) : isActive ? (\\n                    <span\\n                      className=\\\"inline-flex h-2.5 w-2.5 rounded-full bg-[#2DD4BF] ring-4 ring-[#0F766E]/15\\\"\\n                      aria-hidden=\\\"true\\\"\\n                    />\\n                  ) : (\\n                    <span\\n                      className=\\\"inline-flex h-2 w-2 rounded-full bg-[#D7E0E8]\\\"\\n                      aria-hidden=\\\"true\\\"\\n                    />\\n                  )}\\n                </div>\\n\\n                <div>\\n                  <div\\n                    className={`font-[Manrope] text-[16px] font-bold leading-[22px] tracking-[-0.01em] ${\\n                      isActive ? \'text-[#0F766E]\' : \'text-[#172B4D]\'\\n                    }`}\\n                  >\\n                    {stage.label}\\n                  </div>\", \"TargetFile\":\"/packages/ui/src/components/WorkflowPipeline.tsx\", \"toolAction\":\"Updating WorkflowPipeline for business clarity\", \"toolSummary\":\"Update WorkflowPipeline.tsx\"}"
