      arguments_json: "{\"CodeContent\":\"export { metrTokens, type MetrTokens } from \'./tokens\';\\nexport { BrandMark, type BrandMarkProps } from \'./components/BrandMark\';\\nexport { Button, type ButtonProps, type ButtonSize, type ButtonVariant } from \'./components/Button\';\\nexport { PhaseBadge, type PhaseBadgeProps } from \'./components/PhaseBadge\';\\nexport { MetricCard, type MetricCardProps } from \'./components/MetricCard\';\\nexport { Accordion, type AccordionItemData, type AccordionProps } from \'./components/Accordion\';\\nexport {\\n  WorkflowPipeline,\\n  type WorkflowPipelineProps,\\n  type WorkflowStage,\\n} from \'./components/WorkflowPipeline\';\\nexport { Reveal, type RevealProps } from \'./components/Reveal\';\\n\", \"Description\":\"Export all @metr/ui tokens and components from barrel index\", \"Overwrite\":true, \"TargetFile\":\"/packages/ui/src/index.ts\", \"toolAction\":\"Creating @metr/ui index barrel\", \"toolSummary\":\"Create @metr/ui index barrel\"}"
