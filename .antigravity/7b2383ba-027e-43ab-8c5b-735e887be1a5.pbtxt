        instruction: "import React from \'react\';\nimport { BrandMark } from \'@metr/ui\';\n\nexport function Footer() {\n  return (\n    <footer className=\"bg-[#102A43] text-[#EDF0FF] border-t border-[#172B4D]\">\n      <div className=\"mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-12 py-12 lg:py-16\">\n        <div className=\"grid grid-cols-1 md:grid-cols-12 gap-10 pb-10 border-b border-white/10\">\n          <div className=\"md:col-span-5 space-y-4\">\n            <BrandMark inverted />\n            <p className=\"text-[14px] leading-[22px] text-[#B0C9E8] max-w-[44ch]\">\n              METR is a unified Enterprise Resource Planning platform engineered for controlled\n              lead-to-cash, procure-to-pay, service delivery, and double-entry financial reporting.\n            </p>\n            <p className=\"text-[12px] font-mono text-[#80D5CB]\">\n              Specification Baseline \302\267 METR-SPEC-001 (v1.0)\n            </p>\n          </div>\n\n          <div className=\"md:col-span-3 space-y-3\">\n            <h3 className=\"text-[11px] font-bold uppercase tracking-[0.08em] text-[#80D5CB]\">\n              Platform Sections\n            </h3>\n            <ul className=\"space-y-2.5 text-[14px] text-[#D1E4FF]\">\n              <li>\n                <a href=\"#workflow\" className=\"hover:text-white transition-colors\">\n                  Connected Movement\n                </a>\n              </li>\n              <li>\n                <a href=\"#modules\" className=\"hover:text-white transition-colors\">\n                  Domain Modules\n                </a>\n              </li>\n              <li>\n                <a href=\"#architecture\" className=\"hover:text-white transition-colors\">\n                  Technical Architecture\n                </a>\n              </li>\n              <li>\n                <a href=\"#roadmap\" className=\"hover:text-white transition-colors\">\n                  Release Roadmap\n                </a>\n              </li>\n              <li>\n                <a href=\"#faq\" className=\"hover:text-white transition-colors\">\n                  FAQ\n                </a>\n              </li>\n            </ul>\n          </div>\n\n          <div className=\"md:col-span-4 space-y-3\">\n            <h3 className=\"text-[11px] font-bold uppercase tracking-[0.08em] text-[#80D5CB]\">\n              Standards & Governance Baseline\n            </h3>\n            <ul className=\"space-y-2 text-[13px] text-[#B0C9E8]\">\n              <li>OWASP ASVS 5.0.0 (Level 2 Target)</li>\n              <li>PostgreSQL Composite Tenant Isolation & RLS</li>\n              <li>NDPA 2023 / NDPC Compliance Readiness</li>\n              <li>OpenAPI 3.1 REST Contract (/api/v1)</li>\n              <li>WCAG 2.2 AA Accessibility Baseline</li>\n            </ul>\n          </div>\n        </div>\n\n        <div className=\"pt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-[12px] text-[#B0C9E8]\">\n          <p>\302\251 {new Date().getFullYear()} METR Enterprise Resource Planning Platform.</p>\n          <p>Precision Ledger & Flow Design System \302\267 apps/web & packages/ui</p>\n        </div>\n      </div>\n    </footer>\n  );\n}\n"
