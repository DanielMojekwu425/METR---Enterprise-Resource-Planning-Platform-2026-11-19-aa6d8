      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add monorepo package aliases to vite.config.ts\", \"EndLine\":36, \"Instruction\":\"Configure Vite resolve aliases for @metr/ui, @metr/contracts, and @metr/web\", \"ReplacementContent\":\"    resolve: {\\n      alias: {\\n        \'@\': path.resolve(__dirname, \'.\'),\\n        \'@metr/ui\': path.resolve(__dirname, \'packages/ui/src\'),\\n        \'@metr/contracts\': path.resolve(__dirname, \'packages/contracts/src\'),\\n        \'@metr/web\': path.resolve(__dirname, \'apps/web/src\'),\\n      },\\n    },\", \"StartLine\":29, \"TargetContent\":\"    resolve: {\\n      alias: {\\n        \'@\': path.resolve(__dirname, \'.\'),\\n      },\\n    },\", \"TargetFile\":\"/vite.config.ts\", \"toolAction\":\"Updating vite.config.ts aliases\", \"toolSummary\":\"Update vite.config.ts\"}"
