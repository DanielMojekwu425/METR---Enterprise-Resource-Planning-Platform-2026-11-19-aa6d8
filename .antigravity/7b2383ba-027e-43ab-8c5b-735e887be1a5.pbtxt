              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const response = await fetch(\'/api/v1/waitlist\', {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        method: \'POST\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        headers: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Content-Type\': \'application/json\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Idempotency-Key\': idempotencyKey,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        body: JSON.stringify(form),"
