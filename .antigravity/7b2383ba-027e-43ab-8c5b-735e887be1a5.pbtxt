      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add monorepo workspace path aliases for @metr/ui, @metr/contracts, and @metr/web in tsconfig.json\", \"EndLine\":25, \"Instruction\":\"Add monorepo path aliases matching apps/web and packages/*\", \"ReplacementContent\":\"    \\\"paths\\\": {\\n      \\\"@/*\\\": [\\\"./*\\\"],\\n      \\\"@metr/ui\\\": [\\\"./packages/ui/src/index.ts\\\"],\\n      \\\"@metr/ui/*\\\": [\\\"./packages/ui/src/*\\\"],\\n      \\\"@metr/contracts\\\": [\\\"./packages/contracts/src/index.ts\\\"],\\n      \\\"@metr/contracts/*\\\": [\\\"./packages/contracts/src/*\\\"],\\n      \\\"@metr/web/*\\\": [\\\"./apps/web/src/*\\\"]\\n    },\", \"StartLine\":17, \"TargetContent\":\"    \\\"paths\\\": {\\n      \\\"@/*\\\": [\\n        \\\"./*\\\"\\n      ]\\n    },\", \"TargetFile\":\"/tsconfig.json\", \"toolAction\":\"Updating tsconfig.json aliases\", \"toolSummary\":\"Update tsconfig.json\"}"
