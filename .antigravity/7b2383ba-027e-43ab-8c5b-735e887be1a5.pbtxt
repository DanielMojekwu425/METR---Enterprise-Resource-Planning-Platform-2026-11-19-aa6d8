        use_fast_apply: true
        replacement_chunks {
          target_content: "import React, { useState } from \'react\';\nimport { AnimatePresence, motion } from \'motion/react\';\nimport { Code2, Database, FolderTree, Lock, Server, ShieldCheck } from \'lucide-react\';\nimport { Reveal } from \'@metr/ui\';\nimport {\n  MONOREPO_TREE,\n  NFR_METRICS,\n  SAMPLE_API_PAYLOAD,\n  SQL_PATTERN_SNIPPET,\n} from \'../data/metrContent\';\n\ntype SpecTab = \'sql\' | \'monorepo\' | \'api\' | \'security\';\n\nconst SECURITY_CONTROLS = [\n  {\n    title: \'Tenant & Legal Entity Scoping\',\n    detail:\n      \'Every tenant-owned row carries tenant_id derived strictly from authenticated server context, enforced with composite foreign keys (tenant_id, id) and optional PostgreSQL RLS.\',\n  },\n  {\n    title: \'Deny-by-Default Authorization & Financial SoD\',\n    detail:\n      \'Server-side role + company + branch scope checks on every API action and export. Initiators cannot self-approve sensitive quotes, POs, vendor payments, or journals.\',\n  },\n  {\n    title: \'Durable Transactional Outbox\',\n    detail:\n      \'Async side effects (emails, PDFs, webhook reconciliations) write to workflow.outbox_events in the same ACID transaction with idempotent event_key delivery.\',\n  },\n  {\n    title: \'OWASP ASVS 5.0.0 L2 & NDPA 2023 Readiness\',\n    detail:\n      \'MFA for privileged approvers, KMS-managed secrets, signed short-lived S3 file URLs, masked payroll/bank identifiers, and append-only SHA-256 audit logs.\',\n  },\n];\n\nexport function ArchitectureTrustSection() {\n  const [activeTab, setActiveTab] = useState<SpecTab>(\'sql\');\n\n  return (\n    <section\n      id=\"architecture\"\n      className=\"bg-[#102A43] text-white border-b border-[#172B4D] py-16 lg:py-24\"\n    >\n      <div className=\"mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-12\">\n        <Reveal>\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start\">\n            {/* Left 5 Columns: Technical Identity & Architectural Layers */}\n            <div className=\"lg:col-span-5 space-y-6\">\n              <div>\n                <p className=\"text-[11px] font-bold uppercase tracking-[0.08em] text-[#2DD4BF] mb-3\">\n                  Technical Identity & Trust \302\267 Section B1\342\200\223B9\n                </p>\n                <h2 className=\"font-[Manrope] text-[28px] sm:text-[36px] lg:text-[40px] font-bold leading-[1.2] tracking-[-0.02em] text-white\">\n                  Modular monolith discipline. Ledger-grade PostgreSQL core.\n                </h2>\n                <p className=\"mt-4 text-[15px] sm:text-[16px] leading-[26px] text-[#D1E4FF]\">\n                  METR rejects premature microservice sprawl in favor of one transactional NestJS\n                  backend with domain-enforced module boundaries, a Next.js + TypeScript web client,\n                  and ACID PostgreSQL schemas.\n                </p>\n              </div>\n\n              {/* Clean Architectural Stack List */}\n              <div className=\"rounded-[1rem] bg-[#0B1724] border border-white/10 divide-y divide-white/[0.08]\">\n                {[\n                  {\n                    icon: Server,\n                    layer: \'Web Client\',\n                    stack: \'Next.js + TypeScript + Tailwind (apps/web + packages/ui)\',\n                  },\n                  {\n                    icon: Code2,\n                    layer: \'Application API\',\n                    stack: \'NestJS Modular Monolith \302\267 REST /api/v1 \302\267 OpenAPI + Idempotency-Key\',\n                  },\n                  {\n                    icon: Database,\n                    layer: \'Relational Core\',\n                    stack: \'PostgreSQL ACID \302\267 15 Domain Schemas \302\267 Transactional Outbox\',\n                  },\n                  {\n                    icon: Lock,\n                    layer: \'Files & Continuity\',\n                    stack: \'Private Encrypted S3 Buckets \302\267 Signed URLs \302\267 Continuous WAL/PITR\',\n                  },\n                ].map((row) => {\n                  const Icon = row.icon;\n                  return (\n                    <div key={row.layer} className=\"p-4 flex items-start gap-3.5\">\n                      <span className=\"mt-0.5 inline-flex h-8 w-8 items-center justify-center rounded-[0.5rem] bg-[#102A43] border border-white/10 text-[#2DD4BF] shrink-0\">\n                        <Icon size={16} aria-hidden=\"true\" />\n                      </span>\n                      <div>\n                        <div className=\"text-[13px] font-semibold text-white\">{row.layer}</div>\n                        <div className=\"text-[13px] text-[#B0C9E8] mt-0.5 leading-[20px]\">\n                          {row.stack}\n                        </div>\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n            </div>\n\n            {/* Right 7 Columns: Dark Surface Code & Contract Inspector */}\n            <div className=\"lg:col-span-7\">\n              <div className=\"rounded-[1.25rem] bg-[#0B1724] border border-white/12 overflow-hidden\">\n                {/* Tab Bar */}\n                <div\n                  role=\"tablist\"\n                  aria-label=\"Technical specification views\"\n                  className=\"flex flex-wrap items-center gap-1 p-2.5 bg-[#08121D] border-b border-white/10\"\n                >\n                  {[\n                    { id: \'sql\' as const, label: \'SQL Ledger Pattern\', icon: Database },\n                    { id: \'monorepo\' as const, label: \'Monorepo Structure\', icon: FolderTree },\n                    { id: \'api\' as const, label: \'API Payload (D5)\', icon: Code2 },\n                    { id: \'security\' as const, label: \'Security Controls\', icon: ShieldCheck },\n                  ].map((tab) => {\n                    const Icon = tab.icon;\n                    const active = activeTab === tab.id;\n                    return (\n                      <button\n                        key={tab.id}\n                        type=\"button\"\n                        role=\"tab\"\n                        aria-selected={active}\n                        onClick={() => setActiveTab(tab.id)}\n                        className={`inline-flex items-center gap-1.5 px-3.5 py-2 rounded-[0.5rem] text-[12px] font-semibold transition-colors whitespace-nowrap shrink-0 metr-focus ${\n                          active\n                            ? \'bg-[#0F766E] text-white\'\n                            : \'text-[#B0C9E8] hover:text-white hover:bg-white/[0.06]\'\n                        }`}\n                      >\n                        <Icon size={13} aria-hidden=\"true\" />\n                        {tab.label}\n                      </button>\n                    );\n                  })}\n                </div>\n\n                {/* Tab Content */}\n                <div className=\"p-5 sm:p-6 min-h-[360px] flex flex-col justify-between\">\n                  <AnimatePresence mode=\"wait\">\n                    {activeTab === \'sql\' && (\n                      <motion.div\n                        key=\"sql\"\n                        initial={{ opacity: 0, y: 6 }}\n                        animate={{ opacity: 1, y: 0 }}\n                        exit={{ opacity: 0, y: -6 }}\n                        transition={{ duration: 0.18 }}\n                        className=\"space-y-3\"\n                      >\n                        <div className=\"flex items-center justify-between text-[11px] font-mono text-[#80D5CB]\">\n                          <span>database/migrations/0012_finance_ledger.sql</span>\n                          <span>PostgreSQL 18 \302\267 numeric(20,4)</span>\n                        </div>\n                        <pre className=\"font-mono text-[12px] sm:text-[13px] leading-[21px] text-[#EDF0FF] overflow-x-auto p-4 rounded-[0.75rem] bg-[#102A43]/60 border border-white/[0.08]\">\n                          <code>{SQL_PATTERN_SNIPPET}</code>\n                        </pre>\n                      </motion.div>\n                    )}\n\n                    {activeTab === \'monorepo\' && (\n                      <motion.div\n                        key=\"monorepo\"\n                        initial={{ opacity: 0, y: 6 }}\n                        animate={{ opacity: 1, y: 0 }}\n                        exit={{ opacity: 0, y: -6 }}\n                        transition={{ duration: 0.18 }}\n                        className=\"space-y-3\"\n                      >\n                        <div className=\"flex items-center justify-between text-[11px] font-mono text-[#80D5CB]\">\n                          <span>Section B3 \302\267 Repository Conventions</span>\n                          <span>Workspace Packages</span>\n                        </div>\n                        <pre className=\"font-mono text-[12px] sm:text-[13px] leading-[22px] text-[#EDF0FF] overflow-x-auto p-4 rounded-[0.75rem] bg-[#102A43]/60 border border-white/[0.08]\">\n                          <code>{MONOREPO_TREE}</code>\n                        </pre>\n                      </motion.div>\n                    )}\n\n                    {activeTab === \'api\' && (\n                      <motion.div\n                        key=\"api\"\n                        initial={{ opacity: 0, y: 6 }}\n                        animate={{ opacity: 1, y: 0 }}\n                        exit={{ opacity: 0, y: -6 }}\n                        transition={{ duration: 0.18 }}\n                        className=\"space-y-3\"\n                      >\n                        <div className=\"flex items-center justify-between text-[11px] font-mono text-[#80D5CB]\">\n                          <span>Section D5 \302\267 Versioned Quote Creation</span>\n                          <span>Decimal Strings \302\267 ISO-4217</span>\n                        </div>\n                        <pre className=\"font-mono text-[12px] sm:text-[13px] leading-[21px] text-[#EDF0FF] overflow-x-auto p-4 rounded-[0.75rem] bg-[#102A43]/60 border border-white/[0.08]\">\n                          <code>{SAMPLE_API_PAYLOAD}</code>\n                        </pre>\n                      </motion.div>\n                    )}\n\n                    {activeTab === \'security\' && (\n                      <motion.div\n                        key=\"security\"\n                        initial={{ opacity: 0, y: 6 }}\n                        animate={{ opacity: 1, y: 0 }}\n                        exit={{ opacity: 0, y: -6 }}\n                        transition={{ duration: 0.18 }}\n                        className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\"\n                      >\n                        {SECURITY_CONTROLS.map((ctrl) => (\n                          <div\n                            key={ctrl.title}\n                            className=\"rounded-[0.75rem] bg-[#102A43]/70 border border-white/10 p-4 space-y-2\"\n                          >\n                            <h3 className=\"font-[Manrope] text-[15px] font-bold text-white\">\n                              {ctrl.title}\n                            </h3>\n                            <p className=\"text-[13px] leading-[20px] text-[#D1E4FF]\">\n                              {ctrl.detail}\n                            </p>\n                          </div>\n                        ))}\n                      </motion.div>\n                    )}\n                  </AnimatePresence>\n                </div>\n              </div>\n            </div>\n          </div>\n        </Reveal>\n\n        {/* Non-Functional Requirements & Design SLO Strip (Section B9) */}\n        <Reveal delay={0.1}>\n          <div className=\"mt-12 pt-10 border-t border-white/12\">\n            <div className=\"flex flex-wrap items-baseline justify-between gap-4 mb-6\">\n              <h3 className=\"font-[Manrope] text-[18px] font-bold text-white\">\n                Target Non-Functional Engineering Baselines (Section B9)\n              </h3>\n              <p className=\"text-[12px] text-[#B0C9E8]\">\n                Design targets validated through load, PITR recovery, and automated boundary suites.\n              </p>\n            </div>\n\n            <div className=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4\">\n              {NFR_METRICS.map((metric) => (\n                <div\n                  key={metric.id}\n                  className=\"rounded-[1rem] bg-[#0B1724] border border-white/10 p-4 flex flex-col justify-between gap-2\"\n                >\n                  <span className=\"text-[11px] font-bold uppercase tracking-[0.08em] text-[#80D5CB]\">\n                    {metric.eyebrow}\n                  </span>\n                  <span className=\"font-[Manrope] font-tabular text-[22px] font-bold text-white leading-tight\">\n                    {metric.value}\n                  </span>\n                  <span className=\"text-[12px] text-[#B0C9E8] leading-[17px]\">\n                    {metric.detail}\n                  </span>\n                </div>\n              ))}\n            </div>\n          </div>\n        </Reveal>\n      </div>\n    </section>\n  );\n}"
          replacement_content: "import React, { useState } from \'react\';\nimport { AnimatePresence, motion } from \'motion/react\';\nimport {\n  Building2,\n  CheckCircle2,\n  FileCheck2,\n  Layers,\n  Lock,\n  Scale,\n  ShieldCheck,\n  UserCheck,\n} from \'lucide-react\';\nimport { Reveal } from \'@metr/ui\';\nimport { RELIABILITY_METRICS, TRUST_SHOWCASE_TABS } from \'../data/metrContent\';\n\ntype TrustTab = \'financial\' | \'entities\' | \'approvals\' | \'privacy\';\n\nconst PLATFORM_PILLARS = [\n  {\n    icon: Layers,\n    layer: \'Unified Business Workspace\',\n    detail:\n      \'One fast, consistent workspace for sales, operations, and finance\342\200\224no juggling disconnected spreadsheets or apps.\',\n  },\n  {\n    icon: UserCheck,\n    layer: \'Built-In Approval Controls\',\n    detail:\n      \'Multi-step sign-offs prevent staff from approving their own high-value quotes, purchases, or payouts.\',\n  },\n  {\n    icon: Scale,\n    layer: \'Audit-Ready Financial Core\',\n    detail:\n      \'Every transaction balances automatically and leaves a permanent, tamper-proof trail for external auditors.\',\n  },\n  {\n    icon: Lock,\n    layer: \'Encrypted Files & Continuous Backups\',\n    detail:\n      \'Contracts, invoices, and receipts stay privately encrypted with automated backups and tested rapid recovery.\',\n  },\n];\n\nconst TRUST_TABS: { id: TrustTab; label: string; icon: typeof Scale }[] = [\n  { id: \'financial\', label: \'Financial Safeguards\', icon: Scale },\n  { id: \'entities\', label: \'Multi-Company Control\', icon: Building2 },\n  { id: \'approvals\', label: \'Approvals & Access\', icon: FileCheck2 },\n  { id: \'privacy\', label: \'Privacy & Continuity\', icon: ShieldCheck },\n];\n\nexport function ArchitectureTrustSection() {\n  const [activeTab, setActiveTab] = useState<TrustTab>(\'financial\');\n  const currentTabData = TRUST_SHOWCASE_TABS[activeTab];\n\n  return (\n    <section\n      id=\"architecture\"\n      className=\"bg-[#102A43] text-white border-b border-[#172B4D] py-16 lg:py-24\"\n    >\n      <div className=\"mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-12\">\n        <Reveal>\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start\">\n            {/* Left 5 Columns: Business Trust & Platform Pillars */}\n            <div className=\"lg:col-span-5 space-y-6\">\n              <div>\n                <p className=\"text-[11px] font-bold uppercase tracking-[0.08em] text-[#2DD4BF] mb-3\">\n                  Trust, Security & Controls\n                </p>\n                <h2 className=\"font-[Manrope] text-[28px] sm:text-[36px] lg:text-[40px] font-bold leading-[1.2] tracking-[-0.02em] text-white\">\n                  Built for financial accuracy, strict privacy, and audit readiness.\n                </h2>\n                <p className=\"mt-4 text-[15px] sm:text-[16px] leading-[26px] text-[#D1E4FF]\">\n                  METR keeps your operations, approvals, and financial books inside one tightly\n                  governed platform\342\200\224so every number is traceable, every company stays cleanly\n                  separated, and nothing falls through the cracks.\n                </p>\n              </div>\n\n              {/* Clean Platform Pillars List */}\n              <div className=\"rounded-[1rem] bg-[#0B1724] border border-white/10 divide-y divide-white/[0.08]\">\n                {PLATFORM_PILLARS.map((row) => {\n                  const Icon = row.icon;\n                  return (\n                    <div key={row.layer} className=\"p-4 flex items-start gap-3.5\">\n                      <span className=\"mt-0.5 inline-flex h-8 w-8 items-center justify-center rounded-[0.5rem] bg-[#102A43] border border-white/10 text-[#2DD4BF] shrink-0\">\n                        <Icon size={16} aria-hidden=\"true\" />\n                      </span>\n                      <div>\n                        <div className=\"text-[13px] font-semibold text-white\">{row.layer}</div>\n                        <div className=\"text-[13px] text-[#B0C9E8] mt-0.5 leading-[20px]\">\n                          {row.detail}\n                        </div>\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n            </div>\n\n            {/* Right 7 Columns: Dark Surface Interactive Controls & Assurance Showcase */}\n            <div className=\"lg:col-span-7\">\n              <div className=\"rounded-[1.25rem] bg-[#0B1724] border border-white/12 overflow-hidden\">\n                {/* Tab Bar */}\n                <div\n                  role=\"tablist\"\n                  aria-label=\"Platform trust and safeguard views\"\n                  className=\"flex flex-wrap items-center gap-1 p-2.5 bg-[#08121D] border-b border-white/10\"\n                >\n                  {TRUST_TABS.map((tab) => {\n                    const Icon = tab.icon;\n                    const active = activeTab === tab.id;\n                    return (\n                      <button\n                        key={tab.id}\n                        type=\"button\"\n                        role=\"tab\"\n                        aria-selected={active}\n                        onClick={() => setActiveTab(tab.id)}\n                        className={`inline-flex items-center gap-1.5 px-3.5 py-2 rounded-[0.5rem] text-[12px] font-semibold transition-colors whitespace-nowrap shrink-0 metr-focus ${\n                          active\n                            ? \'bg-[#0F766E] text-white\'\n                            : \'text-[#B0C9E8] hover:text-white hover:bg-white/[0.06]\'\n                        }`}\n                      >\n                        <Icon size={13} aria-hidden=\"true\" />\n                        {tab.label}\n                      </button>\n                    );\n                  })}\n                </div>\n\n                {/* Tab Content */}\n                <div className=\"p-5 sm:p-6 min-h-[380px] flex flex-col justify-between\">\n                  <AnimatePresence mode=\"wait\">\n                    <motion.div\n                      key={activeTab}\n                      initial={{ opacity: 0, y: 6 }}\n                      animate={{ opacity: 1, y: 0 }}\n                      exit={{ opacity: 0, y: -6 }}\n                      transition={{ duration: 0.18 }}\n                      className=\"space-y-4\"\n                    >\n                      <div className=\"flex flex-wrap items-center justify-between gap-2 text-[11px] font-semibold uppercase tracking-[0.06em] text-[#80D5CB]\">\n                        <span>{currentTabData.headerLeft}</span>\n                        <span>{currentTabData.headerRight}</span>\n                      </div>\n\n                      <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                        {currentTabData.cards.map((card) => (\n                          <div\n                            key={card.title}\n                            className=\"rounded-[0.75rem] bg-[#102A43]/70 border border-white/10 p-4 flex flex-col justify-between gap-3\"\n                          >\n                            <div className=\"space-y-1.5\">\n                              <div className=\"flex items-center justify-between gap-2\">\n                                <h3 className=\"font-[Manrope] text-[15px] font-bold text-white leading-snug\">\n                                  {card.title}\n                                </h3>\n                                <span className=\"text-[10px] font-bold uppercase tracking-[0.06em] text-[#2DD4BF] whitespace-nowrap shrink-0\">\n                                  {card.badge}\n                                </span>\n                              </div>\n                              <p className=\"text-[13px] leading-[20px] text-[#D1E4FF]\">\n                                {card.summary}\n                              </p>\n                            </div>\n\n                            <ul className=\"space-y-1.5 pt-2.5 border-t border-white/[0.08]\">\n                              {card.highlights.map((item) => (\n                                <li\n                                  key={item}\n                                  className=\"flex items-start gap-2 text-[12px] leading-[17px] text-[#B0C9E8]\"\n                                >\n                                  <CheckCircle2\n                                    size={13}\n                                    className=\"text-[#2DD4BF] mt-0.5 shrink-0\"\n                                    aria-hidden=\"true\"\n                                  />\n                                  <span>{item}</span>\n                                </li>\n                              ))}\n                            </ul>\n                          </div>\n                        ))}\n                      </div>\n                    </motion.div>\n                  </AnimatePresence>\n                </div>\n              </div>\n            </div>\n          </div>\n        </Reveal>\n\n        {/* Platform Reliability & Security Commitments Strip */}\n        <Reveal delay={0.1}>\n          <div className=\"mt-12 pt-10 border-t border-white/12\">\n            <div className=\"flex flex-wrap items-baseline justify-between gap-4 mb-6\">\n              <h3 className=\"font-[Manrope] text-[18px] font-bold text-white\">\n                Platform Reliability & Security Commitments\n              </h3>\n              <p className=\"text-[12px] text-[#B0C9E8]\">\n                Routinely verified through uptime checks, backup drills, and company privacy audits.\n              </p>\n            </div>\n\n            <div className=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4\">\n              {RELIABILITY_METRICS.map((metric) => (\n                <div\n                  key={metric.id}\n                  className=\"rounded-[1rem] bg-[#0B1724] border border-white/10 p-4 flex flex-col justify-between gap-2\"\n                >\n                  <span className=\"text-[11px] font-bold uppercase tracking-[0.08em] text-[#80D5CB]\">\n                    {metric.eyebrow}\n                  </span>\n                  <span className=\"font-[Manrope] font-tabular text-[22px] font-bold text-white leading-tight\">\n                    {metric.value}\n                  </span>\n                  <span className=\"text-[12px] text-[#B0C9E8] leading-[17px]\">\n                    {metric.detail}\n                  </span>\n                </div>\n              ))}\n            </div>\n          </div>\n        </Reveal>\n      </div>\n    </section>\n  );\n}"
          start_line: 1
          end_line: 270
        }
      }
    }
