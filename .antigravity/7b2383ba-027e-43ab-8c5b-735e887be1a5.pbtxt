              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            className={`mt-0.5 inline-flex h-[18px] w-[18px] items-center justify-center rounded-[4px] border shrink-0 transition-colors ${"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                              checked"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                ? \'bg-[#0F766E] border-[#0F766E] text-white\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                : \'bg-white border-[#D7E0E8]\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            }`}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
