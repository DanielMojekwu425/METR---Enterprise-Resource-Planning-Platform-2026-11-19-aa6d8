  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\n\nexport interface BrandMarkProps {\n  inverted?: boolean;\n  className?: string;\n}\n\n/**\n * Geometric METR monogram with rounded stroke caps (stroke-linecap=\"round\")\n * representing connected ledger nodes and systemic operational flow.\n */\nexport function BrandMark({ inverted = false, className = \'\' }: BrandMarkProps) {\n  const strokePrimary = inverted ? \'#2DD4BF\' : \'#0F766E\';\n  const strokeSecondary = inverted ? \'#FFFFFF\' : \'#102A43\';\n  const textColor = inverted ? \'text-white\' : \'text-[#102A43]\';\n\n  return (\n    <span className={`inline-flex items-center gap-2.5 whitespace-nowrap shrink-0 ${className}`}>\n      <svg\n        width=\"28\"\n        height=\"28\"\n        viewBox=\"0 0 28 28\"\n        fill=\"none\"\n        xmlns=\"http://www.w3.org/2000/svg\"\n        aria-hidden=\"true\"\n        className=\"shrink-0\"\n      >\n        <rect\n          x=\"1.5\"\n          y=\"1.5\"\n          width=\"25\"\n          height=\"25\"\n          rx=\"6\"\n          stroke={inverted ? \'rgba(255,255,255,0.2)\' : \'#D7E0E8\'}\n          strokeWidth=\"1.5\"\n          fill={inverted ? \'#0B1724\' : \'#FFFFFF\'}\n        />\n        <path\n          d=\"M7.5 19.5V9.5L14 15.5L20.5 9.5V19.5\"\n          stroke={strokeSecondary}\n          strokeWidth=\"2.2\"\n          strokeLinecap=\"round\"\n          strokeLinejoin=\"round\"\n        />\n        <path\n          d=\"M14 15.5V20\"\n          stroke={strokePrimary}\n          strokeWidth=\"2.2\"\n          strokeLinecap=\"round\"\n        />\n        <circle cx=\"14\" cy=\"8.5\" r=\"2\" fill={strokePrimary} />\n      </svg>\n      <span\n        className={`font-[Manrope] text-[20px] font-extrabold tracking-[-0.03em] leading-none ${textColor}`}\n      >\n        METR\n      </span>\n    </span>\n  );\n}\n"
        path {
          absolute_uri: "file:///packages/ui/src/components/BrandMark.tsx"
        }
        overwrite: true
      }
    }
