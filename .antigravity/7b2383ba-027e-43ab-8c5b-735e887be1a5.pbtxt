    tool_calls {
      id: "call_16039954103718414129"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Translate HeroSection technical metrics, PDF codes, and ledger preview labels into plain business terms\", \"Instruction\":\"Remove METR-SPEC-001, PostgreSQL Schemas, Canonical Entities, numeric(20,4), UAT-04, UAT-08, B7 Guard, SUM(debit_base), and finance.payment_allocations from HeroSection and replace with clear business-friendly language.\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":131, \"ReplacementContent\":\"            <div className=\\\"flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.08em] text-[#0F766E]\\\">\\n              <span>Multi-Entity ERP Platform</span>\\n            </div>\\n\\n            <h1 className=\\\"font-[Manrope] text-[36px] sm:text-[46px] lg:text-[52px] xl:text-[56px] font-extrabold leading-[1.12] tracking-[-0.03em] text-[#102A43]\\\">\\n              One System of Record from Lead to Ledger.\\n            </h1>\\n\\n            <p className=\\\"text-[16px] sm:text-[18px] leading-[28px] text-[#3E4947] max-w-[50ch]\\\">\\n              Replace fragmented spreadsheets, disconnected invoicing tools, and manual\\n              reconciliations with a unified operational and double-entry financial platform built\\n              for technology and professional-services enterprises.\\n            </p>\\n\\n            {/* Primary & Secondary Actions */}\\n            <div className=\\\"flex flex-wrap items-center gap-3 pt-1\\\">\\n              <Button asAnchor href=\\\"#waitlist\\\" variant=\\\"primary\\\" size=\\\"lg\\\">\\n                Request Early Access\\n                <ArrowRight size={16} aria-hidden=\\\"true\\\" />\\n              </Button>\\n              <Button asAnchor href=\\\"#architecture\\\" variant=\\\"secondary\\\" size=\\\"lg\\\">\\n                Security & Controls\\n              </Button>\\n            </div>\\n\\n            {/* Quiet unboxed proof strip */}\\n            <div className=\\\"pt-5 mt-2 border-t border-[#E5EBF0] grid grid-cols-3 gap-2.5 sm:gap-4 font-tabular\\\">\\n              <div className=\\\"min-w-0\\\">\\n                <div className=\\\"font-[Manrope] text-[18px] sm:text-[20px] font-bold text-[#102A43] leading-tight\\\">\\n                  12\\n                </div>\\n                <div className=\\\"text-[11px] sm:text-[12px] font-medium text-[#526579] mt-0.5\\\">\\n                  Business Modules\\n                </div>\\n              </div>\\n              <div className=\\\"border-l border-[#E5EBF0] pl-2.5 sm:pl-4 min-w-0\\\">\\n                <div className=\\\"font-[Manrope] text-[18px] sm:text-[20px] font-bold text-[#102A43] leading-tight\\\">\\n                  Multi-Entity\\n                </div>\\n                <div className=\\\"text-[11px] sm:text-[12px] font-medium text-[#526579] mt-0.5\\\">\\n                  Companies & Currencies\\n                </div>\\n              </div>\\n              <div className=\\\"border-l border-[#E5EBF0] pl-2.5 sm:pl-4 min-w-0\\\">\\n                <div className=\\\"font-[Manrope] text-[18px] sm:text-[20px] font-bold text-[#0F766E] leading-tight whitespace-nowrap\\\">\\n                  100%\\n                </div>\\n                <div className=\\\"text-[11px] sm:text-[12px] font-medium text-[#526579] mt-0.5\\\">\\n                  Auto-Balanced Books\\n                </div>\\n              </div>\\n            </div>\\n          </motion.div>\", \"StartLine\":74, \"TargetContent\":\"            <div className=\\\"flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.08em] text-[#0F766E]\\\">\\n              <span>METR-SPEC-001</span>\\n              <span aria-hidden=\\\"true\\\" className=\\\"text-[#D7E0E8]\\\">\\n                /\\n              </span>\\n              <span className=\\\"text-[#526579]\\\">Multi-Entity ERP Platform</span>\\n            </div>\\n\\n            <h1 className=\\\"font-[Manrope] text-[36px] sm:text-[46px] lg:text-[52px] xl:text-[56px] font-extrabold leading-[1.12] tracking-[-0.03em] text-[#102A43]\\\">\\n              One System of Record from Lead to Ledger.\\n            </h1>\\n\\n            <p className=\\\"text-[16px] sm:text-[18px] leading-[28px] text-[#3E4947] max-w-[50ch]\\\">\\n              Replace fragmented spreadsheets, disconnected invoicing tools, and manual\\n              reconciliations with a unified operational and double-entry financial platform built\\n              for technology and professional-services enterprises.\\n            </p>\\n\\n            {/* Primary & Secondary Actions */}\\n            <div className=\\\"flex flex-wrap items-center gap-3 pt-1\\\">\\n              <Button asAnchor href=\\\"#waitlist\\\" variant=\\\"primary\\\" size=\\\"lg\\\">\\n                Request Early Access\\n                <ArrowRight size={16} aria-hidden=\\\"true\\\" />\\n              </Button>\\n              <Button asAnchor href=\\\"#architecture\\\" variant=\\\"secondary\\\" size=\\\"lg\\\">\\n                Inspect Architecture\\n              </Button>\\n            </div>\\n\\n            {/* Quiet unboxed proof strip */}\\n            <div className=\\\"pt-5 mt-2 border-t border-[#E5EBF0] grid grid-cols-3 gap-2.5 sm:gap-4 font-tabular\\\">\\n              <div className=\\\"min-w-0\\\">\\n                <div className=\\\"font-[Manrope] text-[18px] sm:text-[20px] font-bold text-[#102A43] leading-tight\\\">\\n                  15\\n                </div>\\n                <div className=\\\"text-[11px] sm:text-[12px] font-medium text-[#526579] mt-0.5\\\">\\n                  PostgreSQL Schemas\\n                </div>\\n              </div>\\n              <div className=\\\"border-l border-[#E5EBF0] pl-2.5 sm:pl-4 min-w-0\\\">\\n                <div className=\\\"font-[Manrope] text-[18px] sm:text-[20px] font-bold text-[#102A43] leading-tight\\\">\\n                  108\\n                </div>\\n                <div className=\\\"text-[11px] sm:text-[12px] font-medium text-[#526579] mt-0.5\\\">\\n                  Canonical Entities\\n                </div>\\n              </div>\\n              <div className=\\\"border-l border-[#E5EBF0] pl-2.5 sm:pl-4 min-w-0\\\">\\n                <div className=\\\"font-mono text-[12px] sm:text-[15px] font-semibold text-[#0F766E] leading-[22px] sm:leading-[25px] whitespace-nowrap\\\">\\n                  numeric(20,4)\\n                </div>\\n                <div className=\\\"text-[11px] sm:text-[12px] font-medium text-[#526579] mt-0.5\\\">\\n                  Ledger Precision\\n                </div>\\n              </div>\\n            </div>\\n          </motion.div>\"}, {\"AllowMultiple\":false, \"EndLine\":153, \"ReplacementContent\":\"                    <Building2 size={16} className=\\\"text-[#2DD4BF] shrink-0\\\" aria-hidden=\\\"true\\\" />\\n                    <span className=\\\"text-[12px] font-semibold tracking-[0.02em] text-[#EDF0FF] whitespace-nowrap\\\">\\n                      Company Workspace\\n                    </span>\", \"StartLine\":146, \"TargetContent\":\"                    <Building2 size={16} className=\\\"text-[#2DD4BF] shrink-0\\\" aria-hidden=\\\"true\\\" />\\n                    <span className=\\\"text-[12px] font-semibold tracking-[0.02em] text-[#EDF0FF] whitespace-nowrap\\\">\\n                      Legal Entity Scope\\n                    </span>\"}, {\"AllowMultiple\":false, \"EndLine\":270, \"ReplacementContent\":\"                    <div className=\\\"text-[11px] font-medium font-tabular text-[#526579]\\\">\\n                      {journalCheck.valid ? \'Double-Entry Verified\' : \'Blocked \342\200\224 Out of Balance\'}\\n                    </div>\", \"StartLine\":265, \"TargetContent\":\"                    <div className=\\\"text-[11px] font-medium font-tabular text-[#526579]\\\">\\n                      {journalCheck.valid ? \'Double-Entry Verified\' : \'Posting Blocked (UAT-04)\'}\\n                    </div>\"}, {\"AllowMultiple\":false, \"EndLine\":441, \"ReplacementContent\":\"                            <tr className=\\\"bg-[#F5F7FA] border-t border-[#D7E0E8] font-semibold text-[13px] font-tabular\\\">\\n                              <td colSpan={2} className=\\\"py-2.5 px-3.5 text-[#102A43]\\\">\\n                                Balanced Journal Total{\' \'}\\n                                <span className=\\\"font-mono text-[11px] font-medium text-[#526579] ml-1.5\\\">\\n                                  ({entity.journalNumber})\\n                                </span>\\n                              </td>\\n                              <td className=\\\"py-2.5 px-3.5 text-right text-[#102A43]\\\">\\n                                {entity.symbol}\\n                                {journalCheck.formattedDebit}\\n                              </td>\\n                              <td className=\\\"py-2.5 px-3.5 text-right text-[#102A43]\\\">\\n                                {entity.symbol}\\n                                {journalCheck.formattedCredit}\\n                              </td>\\n                            </tr>\\n                          </tfoot>\\n                        </table>\\n                      </div>\\n\\n                      {/* Invariant Banner */}\\n                      <div\\n                        className={`px-4 py-2.5 text-[12px] flex items-center justify-between gap-3 border-t ${\\n                          journalCheck.valid\\n                            ? \'bg-[#0F766E]/[0.06] border-[#0F766E]/15 text-[#005C55]\'\\n                            : \'bg-[#FFDAD6]/60 border-[#BA1A1A]/25 text-[#93000A]\'\\n                        }`}\\n                      >\\n                        <span className=\\\"inline-flex items-center gap-2 font-medium\\\">\\n                          {journalCheck.valid ? (\\n                            <>\\n                              <CheckCircle2 size={14} className=\\\"shrink-0\\\" aria-hidden=\\\"true\\\" />\\n                              Debits equal credits \302\267 Permanently locked once posted\\n                            </>\\n                          ) : (\\n                            <>\\n                              <ShieldAlert size={14} className=\\\"shrink-0\\\" aria-hidden=\\\"true\\\" />\\n                              {journalCheck.errors[0]}\\n                            </>\\n                          )}\\n                        </span>\\n                        <span className=\\\"inline-flex items-center gap-1 text-[11px] font-semibold whitespace-nowrap shrink-0\\\">\\n                          <Lock size={11} aria-hidden=\\\"true\\\" />\\n                          Auto-Balanced\\n                        </span>\\n                      </div>\", \"StartLine\":395, \"TargetContent\":\"                            <tr className=\\\"bg-[#F5F7FA] border-t border-[#D7E0E8] font-semibold text-[13px] font-tabular\\\">\\n                              <td colSpan={2} className=\\\"py-2.5 px-3.5 text-[#102A43]\\\">\\n                                Atomic Posting Check{\' \'}\\n                                <span className=\\\"font-mono text-[11px] font-medium text-[#526579] ml-1.5\\\">\\n                                  ({entity.journalNumber})\\n                                </span>\\n                              </td>\\n                              <td className=\\\"py-2.5 px-3.5 text-right text-[#102A43]\\\">\\n                                {entity.symbol}\\n                                {journalCheck.formattedDebit}\\n                              </td>\\n                              <td className=\\\"py-2.5 px-3.5 text-right text-[#102A43]\\\">\\n                                {entity.symbol}\\n                                {journalCheck.formattedCredit}\\n                              </td>\\n                            </tr>\\n                          </tfoot>\\n                        </table>\\n                      </div>\\n\\n                      {/* Invariant Banner */}\\n                      <div\\n                        className={`px-4 py-2.5 text-[12px] flex items-center justify-between gap-3 border-t ${\\n                          journalCheck.valid\\n                            ? \'bg-[#0F766E]/[0.06] border-[#0F766E]/15 text-[#005C55]\'\\n                            : \'bg-[#FFDAD6]/60 border-[#BA1A1A]/25 text-[#93000A]\'\\n                        }`}\\n                      >\\n                        <span className=\\\"inline-flex items-center gap-2 font-medium\\\">\\n                          {journalCheck.valid ? (\\n                            <>\\n                              <CheckCircle2 size={14} className=\\\"shrink-0\\\" aria-hidden=\\\"true\\\" />\\n                              SUM(debit_base) = SUM(credit_base) \302\267 Immutable posted entry\\n                            </>\\n                          ) : (\\n                            <>\\n                              <ShieldAlert size={14} className=\\\"shrink-0\\\" aria-hidden=\\\"true\\\" />\\n                              {journalCheck.errors[0]}\\n                            </>\\n                          )}\\n                        </span>\\n                        <span className=\\\"inline-flex items-center gap-1 font-mono text-[11px] whitespace-nowrap shrink-0\\\">\\n                          <Lock size={11} aria-hidden=\\\"true\\\" />\\n                          B7 Guard\\n                        </span>\\n                      </div>\"}, {\"AllowMultiple\":false, \"EndLine\":499, \"ReplacementContent\":\"                            <tr className=\\\"bg-[#F5F7FA] border-b border-[#D7E0E8] text-[11px] font-bold uppercase tracking-[0.06em] text-[#526579]\\\">\\n                              <th className=\\\"py-2.5 px-3.5\\\">Item Code</th>\\n                              <th className=\\\"py-2.5 px-3.5\\\">Description</th>\\n                              <th className=\\\"py-2.5 px-3.5 text-right\\\">Qty</th>\\n                              <th className=\\\"py-2.5 px-3.5 text-right\\\">Line Total</th>\\n                            </tr>\\n                          </thead>\\n                          <tbody className=\\\"divide-y divide-[#E5EBF0] text-[13px]\\\">\\n                            {entity.lines.map((line) => (\\n                              <tr key={line.sku} className=\\\"hover:bg-[#F5F7FA]/60\\\">\\n                                <td className=\\\"py-2.5 px-3.5 font-mono text-[12px] text-[#526579]\\\">\\n                                  {line.sku}\\n                                </td>\\n                                <td className=\\\"py-2.5 px-3.5 text-[#172B4D] font-medium\\\">\\n                                  {line.description}\\n                                </td>\\n                                <td className=\\\"py-2.5 px-3.5 text-right font-tabular text-[#526579]\\\">\\n                                  {line.qty}\\n                                </td>\\n                                <td className=\\\"py-2.5 px-3.5 text-right font-tabular font-medium text-[#172B4D]\\\">\\n                                  {entity.symbol}\\n                                  {line.lineTotal}\\n                                </td>\\n                              </tr>\\n                            ))}\\n                          </tbody>\\n                          <tfoot>\\n                            <tr className=\\\"bg-[#F5F7FA] border-t border-[#D7E0E8] font-semibold text-[13px] font-tabular\\\">\\n                              <td colSpan={3} className=\\\"py-2.5 px-3.5 text-[#102A43]\\\">\\n                                Approved Quote ({entity.quoteNumber})\\n                              </td>\\n                              <td className=\\\"py-2.5 px-3.5 text-right text-[#0F766E]\\\">\\n                                {entity.quoteTotal}\\n                              </td>\\n                            </tr>\\n                          </tfoot>\\n                        </table>\\n                      </div>\\n                      <div className=\\\"px-4 py-2.5 text-[12px] bg-[#102A43]/[0.04] border-t border-[#E5EBF0] text-[#526579] flex items-center justify-between gap-2\\\">\\n                        <span>\\n                          {paymentAllocated\\n                            ? `Payment of ${entity.symbol}${entity.partialPaymentAmount} applied \302\267 Remaining balance ${entity.symbol}${entity.remainingAfterPayment}`\\n                            : \'Approved prices, tax rates, and currency stay locked even if your catalogue changes later.\'}\\n                        </span>\\n                      </div>\", \"StartLine\":454, \"TargetContent\":\"                            <tr className=\\\"bg-[#F5F7FA] border-b border-[#D7E0E8] text-[11px] font-bold uppercase tracking-[0.06em] text-[#526579]\\\">\\n                              <th className=\\\"py-2.5 px-3.5\\\">SKU</th>\\n                              <th className=\\\"py-2.5 px-3.5\\\">Snapshot Description</th>\\n                              <th className=\\\"py-2.5 px-3.5 text-right\\\">Qty</th>\\n                              <th className=\\\"py-2.5 px-3.5 text-right\\\">Line Total</th>\\n                            </tr>\\n                          </thead>\\n                          <tbody className=\\\"divide-y divide-[#E5EBF0] text-[13px]\\\">\\n                            {entity.lines.map((line) => (\\n                              <tr key={line.sku} className=\\\"hover:bg-[#F5F7FA]/60\\\">\\n                                <td className=\\\"py-2.5 px-3.5 font-mono text-[12px] text-[#526579]\\\">\\n                                  {line.sku}\\n                                </td>\\n                                <td className=\\\"py-2.5 px-3.5 text-[#172B4D] font-medium\\\">\\n                                  {line.description}\\n                                </td>\\n                                <td className=\\\"py-2.5 px-3.5 text-right font-tabular text-[#526579]\\\">\\n                                  {line.qty}\\n                                </td>\\n                                <td className=\\\"py-2.5 px-3.5 text-right font-tabular font-medium text-[#172B4D]\\\">\\n                                  {entity.symbol}\\n                                  {line.lineTotal}\\n                                </td>\\n                              </tr>\\n                            ))}\\n                          </tbody>\\n                          <tfoot>\\n                            <tr className=\\\"bg-[#F5F7FA] border-t border-[#D7E0E8] font-semibold text-[13px] font-tabular\\\">\\n                              <td colSpan={3} className=\\\"py-2.5 px-3.5 text-[#102A43]\\\">\\n                                Quote Snapshot ({entity.quoteNumber})\\n                              </td>\\n                              <td className=\\\"py-2.5 px-3.5 text-right text-[#0F766E]\\\">\\n                                {entity.quoteTotal}\\n                              </td>\\n                            </tr>\\n                          </tfoot>\\n                        </table>\\n                      </div>\\n                      <div className=\\\"px-4 py-2.5 text-[12px] bg-[#102A43]/[0.04] border-t border-[#E5EBF0] text-[#526579] flex items-center justify-between gap-2\\\">\\n                        <span>\\n                          {paymentAllocated\\n                            ? `Allocated ${entity.symbol}${entity.partialPaymentAmount} via finance.payment_allocations \302\267 Open balance ${entity.symbol}${entity.remainingAfterPayment}`\\n                            : \'Prices, tax codes, and currency snapshotted on approval (UAT-08 immutable).\'}\\n                        </span>\\n                      </div>\"}], \"TargetFile\":\"/apps/web/src/components/HeroSection.tsx\", \"toolAction\":\"Updating HeroSection copy to business terms\", \"toolSummary\":\"Update HeroSection.tsx\"}"
