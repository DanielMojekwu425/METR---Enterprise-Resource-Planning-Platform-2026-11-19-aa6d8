  - generic [ref=e535]: P2\n              - generic [aria-hidden] [ref=e536]: \302\267\n              - generic [ref=e537]: HR-01\n            - generic [ref=e538]: Inspect schema\n    - generic [ref=e543]:\n      - generic [ref=e545]:\n        - generic [ref=e546]:\n          - generic [ref=e547]:\n            - paragraph [ref=e548]: Technical Identity & Trust \302\267 Section B1\342\200\223B9\n            - heading \"Modular monolith discipline. Ledger-grade PostgreSQL core.\" [level=2] [ref=e549]\n            - paragraph [ref=e550]: METR rejects premature microservice sprawl in favor of one transactional NestJS backend with domain-enforced module boundaries, a Next.js + TypeScript web client, and ACID PostgreSQL schemas.\n          - generic [ref=e551]:\n            - generic [ref=e557]:\n              - generic [ref=e558]: Web Client\n              - generic [ref=e559]: Next.js + TypeScript + Tailwind (apps/web + packages/ui)\n            - generic [ref=e566]:\n              - generic [ref=e567]: Application API\n              - generic [ref=e568]: NestJS Modular Monolith \302\267 REST /api/v1 \302\267 OpenAPI + Idempotency-Key\n            - generic [ref=e575]:\n              - generic [ref=e576]: Relational Core\n              - generic [ref=e577]: PostgreSQL ACID \302\267 15 Domain Schemas \302\267 Transactional Outbox\n            - generic [ref=e583]:\n              - generic [ref=e584]: Files & Continuity\n              - generic [ref=e585]: Private Encrypted S3 Buckets \302\267 Signed URLs \302\267 Continuous WAL/PITR\n        - generic [ref=e587]:\n          - tablist \"Technical specification views\" [ref=e588]:\n            - tab \"SQL Ledger Pattern\" [selected] [ref=e589] [cursor=pointer]\n            - tab \"Monorepo Structure\" [ref=e594] [cursor=pointer]\n            - tab \"API Payload (D5)\" [ref=e600] [cursor=pointer]\n            - tab \"Security Controls\" [ref=e605] [cursor=pointer]\n          - generic [ref=e610]:\n            - generic [ref=e611]:\n              - generic [ref=e612]: database/migrations/0012_finance_ledger.sql\n              - generic [ref=e613]: PostgreSQL 18 \302\267 numeric(20,4)\n            - code [ref=e615]: CREATE TABLE finance.invoices ( id uuid PRIMARY KEY, tenant_id uuid NOT NULL, company_id uuid NOT NULL, customer_party_id uuid NOT NULL, currency char(3) NOT NULL, total numeric(20,4) NOT NULL CHECK (total >= 0), status text NOT NULL DEFAULT \'draft\', FOREIGN KEY (tenant_id, customer_party_id) REFERENCES core.parties (tenant_id, id), UNIQUE (tenant_id, id) ); CREATE TABLE finance.journal_lines ( id uuid PRIMARY KEY, journal_entry_id uuid NOT NULL, gl_account_id uuid NOT NULL, debit_base numeric(20,4) NOT NULL DEFAULT 0 CHECK (debit_base >= 0), credit_base numeric(20,4) NOT NULL DEFAULT 0 CHECK (credit_base >= 0), CHECK ( (debit_base > 0 AND credit_base = 0) OR (credit_base > 0 AND debit_base = 0) ) );\n      - generic [ref=e617]:\n        - generic [ref=e618]:\n          - heading \"Target Non-Functional Engineering Baselines (Section B9)\" [level=3] [ref=e619]\n          - paragraph [ref=e620]: Design targets validated through load, PITR recovery, and automated boundary suites.\n        - generic [ref=e621]:\n          - generic [ref=e622]:\n            - generic [ref=e623]: Monthly Availability\n            - generic [ref=e624]: \342\211\245 99.5%\n            - generic [ref=e625]: Synthetic HTTP monitoring\n          - generic [ref=e626]:\n            - generic [ref=e627]: p95 Read / Write\n            - generic [ref=e628]: \342\211\244 1.2s / 2.0s\n            - generic [ref=e629]: 100 concurrent staff target\n          - generic [ref=e630]:\n            - generic [ref=e631]: Recovery Point (RPO)\n            - generic [ref=e632]: \342\211\244 15 min\n            - generic [ref=e633]: Continuous PostgreSQL WAL/PITR\n          - generic [ref=e634]:\n            - generic [ref=e635]: Recovery Time (RTO)\n            - generic [ref=e636]: \342\211\244 4 hours\n            - generic [ref=e637]: Monthly staged restore drills\n          - generic [ref=e638]:\n            - generic [ref=e639]: Security Baseline\n            - generic [ref=e640]: OWASP ASVS L2\n            - generic [ref=e641]: ASVS 5.0.0 + NDPA 2023 ready\n          - generic [ref=e642]:\n            - generic [ref=e643]: Tenant Isolation\n            - generic [ref=e644]: 100% Pass\n            - generic [ref=e645]: Composite FK + automated negative suite\n    - generic [ref=e647]:\n      - generic [ref=e649]:\n        - generic [ref=e650]:\n          - paragraph [ref=e651]: Sequenced Delivery Plan \302\267 Section D1 & D2\n          - heading \"Vertical slices before breadth. Proven GL before expansion.\" [level=2] [ref=e652]\n          - paragraph [ref=e653]: METR ships complete end-to-end user journeys\342\200\224UI, API, server-side authorization, migrations, outbox events, and audit tests\342\200\224gated by explicit business sign-offs.\n        - group \"Roadmap view mode\" [ref=e654]:\n          - button \"Release Milestones (M0\342\200\223M5)\" [pressed] [ref=e655] [cursor=pointer]\n          - button \"Vertical Slices (0\342\200\2237)\" [ref=e656] [cursor=pointer]\n      - generic [ref=e657]:\n        - tablist \"Release milestones\" [ref=e658]:\n          - tab \"M0 Foundation & Isolation 3 core deliverables Phase 1\" [ref=e659] [cursor=pointer]:\n            - generic [ref=e660]:\n              - generic [ref=e661]: M0\n              - generic [ref=e662]:\n                - generic [ref=e663]: Foundation & Isolation\n                - generic [ref=e664]: 3 core deliverables\n            - generic [ref=e665]: Phase 1\n          - tab \"M1 Commercial & Quote-to-Order 3 core deliverables Phase 1\" [ref=e666] [cursor=pointer]:\n            - generic [ref=e667]:\n              - generic [ref=e668]: M1\n              - generic [ref=e669]:\n                - generic [ref=e670]: Commercial & Quote-to-Order\n                - generic [ref=e671]: 3 core deliverables\n