              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'explicit-exclusions\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    category: \'Rollout\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    question: \'What is explicitly out of scope for the initial Phase 1 release?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    answer:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'To protect transactional integrity and launch velocity, the first release explicitly excludes manufacturing MRP/BOM, retail POS tills, regulated banking core ledgers, self-service external tenant signup, AI-autonomous financial posting, and unvalidated jurisdiction-specific payroll calculations.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
