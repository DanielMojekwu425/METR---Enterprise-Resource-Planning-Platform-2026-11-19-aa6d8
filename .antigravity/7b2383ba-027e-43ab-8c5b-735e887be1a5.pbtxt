  code_action {
    action_spec {
      command {
        instruction: "Rewrite ArchitectureTrustSection keeping the exact dark navy 5:7 split layout, 4-tab inspector, and 6-card reliability strip, while replacing all developer jargon (SQL, NestJS, Next.js, PostgreSQL, Monorepo, API Payload, OWASP, WAL/PITR, Section B1-B9) with clear business trust, financial safeguard, multi-company, approval, and privacy assurance cards."
        is_edit: true
        file {
