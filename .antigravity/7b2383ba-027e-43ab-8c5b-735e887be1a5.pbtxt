      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Update FaqSection headings and categories to plain business terms without PDF references\", \"EndLine\":40, \"Instruction\":\"Replace technical FAQ categories and METR-SPEC-001/OWASP copy with business-friendly categories and description.\", \"ReplacementContent\":\"const FAQ_CATEGORIES = [\'All\', \'Platform\', \'Accounting\', \'Security\', \'Rollout\'];\\n\\nexport function FaqSection() {\\n  const [category, setCategory] = useState(\'All\');\\n  const [openId, setOpenId] = useState<string | null>(FAQ_ITEMS[0].id);\\n\\n  const filteredItems = useMemo(() => {\\n    if (category === \'All\') return FAQ_ITEMS;\\n    return FAQ_ITEMS.filter((item) => item.category === category);\\n  }, [category]);\\n\\n  const handleToggle = (id: string) => {\\n    setOpenId((prev) => (prev === id ? null : id));\\n  };\\n\\n  return (\\n    <section id=\\\"faq\\\" className=\\\"bg-[#F5F7FA] border-b border-[#E5EBF0] py-16 lg:py-24\\\">\\n      <div className=\\\"mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-12\\\">\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-start\\\">\\n          {/* Left 4 Columns: Framing & Category Filters */}\\n          <Reveal className=\\\"lg:col-span-4 space-y-5\\\">\\n            <div>\\n              <p className=\\\"text-[11px] font-bold uppercase tracking-[0.08em] text-[#0F766E] mb-3\\\">\\n                Frequently Asked Questions\\n              </p>\\n              <h2 className=\\\"font-[Manrope] text-[28px] sm:text-[34px] font-bold leading-[1.2] tracking-[-0.02em] text-[#102A43]\\\">\\n                Clear answers for business & finance leaders.\\n              </h2>\\n              <p className=\\\"mt-3 text-[15px] leading-[24px] text-[#526579]\\\">\\n                Everything you need to know about multi-company accounting, team permissions, data\\n                privacy, and phased onboarding.\\n              </p>\\n            </div>\", \"StartLine\":5, \"TargetContent\":\"const FAQ_CATEGORIES = [\'All\', \'Architecture\', \'Finance & Ledger\', \'Security & Tenancy\', \'Rollout\'];\\n\\nexport function FaqSection() {\\n  const [category, setCategory] = useState(\'All\');\\n  const [openId, setOpenId] = useState<string | null>(FAQ_ITEMS[0].id);\\n\\n  const filteredItems = useMemo(() => {\\n    if (category === \'All\') return FAQ_ITEMS;\\n    return FAQ_ITEMS.filter((item) => item.category === category);\\n  }, [category]);\\n\\n  const handleToggle = (id: string) => {\\n    setOpenId((prev) => (prev === id ? null : id));\\n  };\\n\\n  return (\\n    <section id=\\\"faq\\\" className=\\\"bg-[#F5F7FA] border-b border-[#E5EBF0] py-16 lg:py-24\\\">\\n      <div className=\\\"mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-12\\\">\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-start\\\">\\n          {/* Left 4 Columns: Framing & Category Filters */}\\n          <Reveal className=\\\"lg:col-span-4 space-y-5\\\">\\n            <div>\\n              <p className=\\\"text-[11px] font-bold uppercase tracking-[0.08em] text-[#0F766E] mb-3\\\">\\n                Architecture & Governance FAQ\\n              </p>\\n              <h2 className=\\\"font-[Manrope] text-[28px] sm:text-[34px] font-bold leading-[1.2] tracking-[-0.02em] text-[#102A43]\\\">\\n                Key engineering & accounting questions.\\n              </h2>\\n              <p className=\\\"mt-3 text-[15px] leading-[24px] text-[#526579]\\\">\\n                Every answer maps directly to METR-SPEC-001 policy decisions, accounting invariants,\\n                and OWASP ASVS security controls.\\n              </p>\\n            </div>\", \"TargetFile\":\"/apps/web/src/components/FaqSection.tsx\", \"toolAction\":\"Updating FaqSection to business language\", \"toolSummary\":\"Update FaqSection.tsx\"}"
      original_name: "replace_file_content"
    }
