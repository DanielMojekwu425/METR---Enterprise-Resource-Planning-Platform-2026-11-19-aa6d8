e\',\n      \'GET /api/v1/reports/project-margin\',\n    ],\n    requirementIds: [\'PRJ-01\', \'PRJ-02\'],\n  },\n  {\n    id: \'support\',\n    name: \'Support Desk & SLA Clocks\',\n    schema: \'support.*\',\n    entityCount: 8,\n    phase: \'Phase 2\',\n    priority: \'P1\',\n    summary:\n      \'Entitlement-verified support tickets linked to installed customer assets, business-hour SLA calendars, internal vs. customer-visible message isolation, and escalation rules.\',\n    owns: \'Customer assets, SLA policies/calendars, queues, tickets, messages, worklogs, SLA events\',\n    referencesOnly: \'Customer parties, contract entitlements, and assigned support employees\',\n    keyEntities: [\n      \'support.tickets\',\n      \'support.customer_assets\',\n      \'support.sla_policies\',\n      \'support.ticket_messages\',\n      \'support.ticket_sla_events\',\n    ],\n    endpoints: [\n      \'POST /api/v1/tickets\',\n      \'POST /api/v1/tickets/{id}/messages\',\n      \'POST /api/v1/tickets/{id}/resolve\',\n    ],\n    requirementIds: [\'SUP-01\', \'SUP-02\'],\n  },\n  {\n    id: \'expansion\',\n    name: \'HR, Payroll, Assets & Portals\',\n    schema: \'hr.* \302\267 assets.* \302\267 integrations.*\',\n    entityCount: 13,\n    phase: \'Phase 3\',\n    priority: \'P2\',\n    summary:\n      \'Restricted HR employee records decoupled from login users, approved payroll runs, fixed asset depreciation schedules, SSO/banking adapters, and scoped customer/vendor portals.\',\n    owns: \'Employees, leave, attendance, payroll runs/payslips, fixed assets, external sync adapters\',\n    referencesOnly: \'Core user principals, GL posting destinations, and party portal scopes\',\n    keyEntities: [\n      \'hr.employees\',\n      \'hr.payroll_runs\',\n      \'hr.payslips\',\n      \'assets.fixed_assets\',\n      \'assets.depreciation_entries\',\n      \'integrations.connections\',\n    ],\n    endpoints: [\n      \'POST /api/v1/hr/payroll-runs\',\n      \'POST /api/v1/assets/depreciation/post\',\n      \'POST /api/v1/integrations/webhooks\',\n    ],\n    requirementIds: [\'HR-01\', \'HR-02\', \'AST-01\', \'INT-03\'],\n  },\n];\n\nexport interface MilestoneItem {\n  id: string;\n  code: string;\n  title: string;\n  phase: ReleasePhase;\n  deliverables: string[];\n  reviewEvidence: string;\n  exitGate: string;\n}\n\nexport const ROADMAP_MILESTONES: MilestoneItem[] = [\n  {\n    id: \'m0\',\n    code: \'M0\',\n    title: \'Foundation & Isolation\',\n    phase: \'Phase 1\',\n    deliverables: [\n      \'OIDC / session authentication with mandatory MFA for admins and finance approvers\',\n      \'Tenant & multi-company legal entity schema with composite (tenant_id, id) foreign keys\',\n      \'Deduplicated party master registry, atomic number sequences, and audit/outbox pipelines\',\n    ],\n    reviewEvidence:\n      \'Admin signs in, switches authorized legal entity, and is cryptographically blocked (403/404) from accessing any forbidden company record.\',\n    exitGate: \'100% cross-tenant denial suite pass + automated PITR backup/restore verified.\',\n  },\n  {\n    id: \'m1\',\n    code: \'M1\',\n    title: \'Commercial & Quote-to-Order\',\n    phase: \'Phase 1\',\n    deliverables: [\n      \'Catalogue management (goods, services, licences, bundles) with time-bounded price lists\',\n      \'CRM lead qualification, opportunity pipeline stages, and activity history\',\n      \'Versioned quotations with immutable price/tax snapshots, approval chains, and branded PDF export\',\n    ],\n    reviewEvidence:\n      \'An accepted 10-line quotation converts cleanly into a traceable sales order retaining exact historical prices even after catalogue changes.\',\n    exitGate: \'Revision immutability & no-self-approval UAT checks signed off.\',\n  },\n  {\n    id: \'m2\',\n    code: \'M2\',\n    title: \'Finance Core / MVP Go-Live\',\n    phase: \'Phase 1\',\n    deliverables: [\n      \'Numbered customer invoices, partial/multi-invoice payment allocations, and manual vendor bills\',\n      \'Atomic double-entry General Ledger posting engine with open fiscal period guards\',\n      \'Company-scoped Trial Balance, General Ledger, P&L, Balance Sheet, and AR/AP ageing reports\',\n    ],\n    reviewEvidence:\n      \'Representative end-to-end customer deal from lead to settled invoice reconciles to the penny across Trial Balance and financial statements.\',\n    exitGate: \'Zero unbalanced journals, closed-period lock verified, OWASP ASVS L2 triage closed.\',\n  },\n  {\n    id: \'m3\',\n    code: \'M3\',\n    title: \'Operations, Procurement & Stock\',\n    phase: \'Phase 2\',\n    deliverables: [\n      \'Internal requisitions, approved Purchase Orders, and partial goods receiving workflows\',\n      \'Append-only physical stock movement ledger, serial tracking, and atomic order reservations\',\n      \'Automated 2-way and 3-way supplier bill matching with exception tolerance approval\',\n    ],\n    reviewEvidence:\n      \'Partial PO receipt (+5 of 10 units) updates stock ledger once without negative availability or duplicate allocation under concurrency.\',\n    exitGate: \'Stock conservation invariants and concurrency reservation conflict tests pass.\',\n  },\n  {\n    id: \'m4\',\n    code: \'M4\',\n    title: \'Service Delivery & Recurring Revenue\',\n    phase: \'Phase 2\',\n    deliverables: [\n      \'Master customer agreements, vendor licence seat tracking, and idempotent recurring billing\',\n      \'Project tasks, milestone billing triggers, and approval-gated billable timesheets & expenses\',\n      \'Entitlement-verified support desk with calendar-aware SLA clocks and internal note isolation\',\n    ],\n    reviewEvidence:\n      \'Live project margin report, SLA escalation timer, and idempotent subscription renewal opportunity verified without duplicate invoices.\',\n    exitGate: \'Renewal job replay idempotency and customer-scope privacy negative tests pass.\',\n  },\n  {\n    id: \'m5\',\n    code: \'M5\',\n    title: \'Enterprise Expansion & Portals\',\n    phase: \'Phase 3\',\n    deliverables: [\n      \'Restricted HR records, leave/attendance workflows, and approved payroll runs with GL posting\',\n      \'Fixed asset register, depreciation schedules, banking feeds, and budget controls\',\n      \'Feature-flagged customer & vendor self-service portals, SSO adapters, and BI warehouse views\',\n    ],\n    reviewEvidence:\n      \'NDPA 2023 / NDPC privacy impact review completed alongside scoped portal tenant-boundary audits.\',\n    exitGate: \'Role segregation, privacy compliance sign-off, and independent UAT approval.\',\n  },\n];\n\nexport interface VerticalSliceItem {\n  sequence: number;\n  outcome: string;\n  exitGate: string;\n  phase: ReleasePhase;\n}\n\nexport const VERTICAL_SLICES: VerticalSliceItem[] = [\n  {\n    sequence: 0,\n    outcome: \'Repository, environments, IAM, tenant/company boundaries, CI, and migration discipline\',\n    exitGate: \'Cross-tenant denial tests; automated deploy and backup.\',\n    phase: \'Phase 1\',\n  },\n  {\n    sequence: 1,\n    outcome: \'Party registry, catalogue, and CRM lead-to-opportunity conversion\',\n    exitGate: \'No duplicate business identity; scoped pipeline.\',\n    phase: \'Phase 1\',\n  },\n  {\n    sequence: 2,\n    outcome: \'Quote \342\206\222 approval \342\206\222 sales order with immutable revision snapshots\',\n    exitGate: \'Versioned documents, price/tax and audit acceptance.\',\n    phase: \'Phase 1\',\n  },\n  {\n    sequence: 3,\n    outcome: \'Invoice \342\206\222 payment \342\206\222 allocation \342\206\222 double-entry journal \342\206\222 financial reports\',\n    exitGate: \'End-to-end GL reconciliation and closed-period invariant.\',\n    phase: \'Phase 1\',\n  },\n  {\n    sequence: 4,\n    outcome: \'Procurement \342\206\222 AP; approved PO \342\206\222 goods receipt \342\206\222 append-only stock ledger\',\n    exitGate: \'Two/three-way matching, stock conservation and returns.\',\n    phase: \'Phase 2\',\n  },\n  {\n    sequence: 5,\n    outcome: \'Agreement \342\206\222 project/time \342\206\222 milestone billing; idempotent subscription renewal\',\n    exitGate: \'Recurring billing idempotency and actual deal margin computation.\',\n    phase: \'Phase 2\',\n  },\n  {\n    sequence: 6,\n    outcome: \'Support entitlement \342\206\222 SLA ticket \342\206\222 calendar-aware escalation & resolution\',\n    exitGate: \'SLA clock controls and customer scope negative tests.\',\n    phase: \'Phase 2\',\n  },\n  {\n    sequence: 7,\n    outcome: \'Advanced HR, payroll, asset depreciation, analytics warehouse, and portals\',\n    exitGate: \'NDPA privacy review, role segregation, and independent UAT sign-off.\',\n    phase: \'Phase 3\',\n  },\n];\n\nexport const NFR_METRICS = [\n  {\n    id: \'nfr-01\',\n    code: \'NFR-01\',\n    eyebrow: \'Monthly Availability\',\n    value: \'\342\211\245 99.5%\',\n    detail: \'Synthetic HTTP monitoring\',\n  },\n  {\n    id: \'nfr-02\',\n    code: \'NFR-02\',\n    eyebrow: \'p95 Read / Write\',\n    value: \'\342\211\244 1.2s / 2.0s\',\n    detail: \'100 concurrent staff target\',\n  },\n  {\n    id: \'nfr-05\',\n    code: \'NFR-05\',\n    eyebrow: \'Recovery Point (RPO)\',\n    value: \'\342\211\244 15 min\',\n    detail: \'Continuous PostgreSQL WAL/PITR\',\n  },\n  {\n    id: \'nfr-06\',\n    code: \'NFR-06\',\n    eyebrow: \'Recovery Time (RTO)\',\n    value: \'\342\211\244 4 hours\',\n    detail: \'Monthly staged restore drills\',\n  },\n  {\n    id: \'nfr-07\',\n    code: \'NFR-07\',\n    eyebrow: \'Security Baseline\',\n    value: \'OWASP ASVS L2\',\n    detail: \'ASVS 5.0.0 + NDPA 2023 ready\',\n  },\n  {\n    id: \'nfr-08\',\n    code: \'NFR-08\',\n    eyebrow: \'Tenant Isolation\',\n    value: \'100% Pass\',\n    detail: \'Composite FK + automated negative suite\',\n  },\n];\n\nexport const FAQ_ITEMS: AccordionItemData[] = [\n  {\n    id: \'modular-monolith\',\n    category: \'Architecture\',\n    question: \'Why does METR launch as a modular monolith instead of microservices?\',\n    answer:\n      \'Financial posting, stock reservations, and sales orders require strict ACID transactional guarantees. Splitting ledger, inventory, and orders across premature microservices introduces distributed failure modes before operations mature. METR enforces domain ownership boundaries inside a NestJS + TypeScript modular monolith backed by 15 PostgreSQL schemas and a durable transactional outbox.\',\n    specRef: \'METR-SPEC-001 \302\267 Section B1 & B2\',\n  },\n  {\n    id: \'tenant-vs-company\',\n    category: \'Security & Tenancy\',\n    question: \'How does METR separate a tenant workspace from multiple legal entities?\',\n    answer:\n      \'A Tenant defines the workspace isolation boundary, while a Company represents an individual legal entity with its own Chart of Accounts, base currency, tax codes, fiscal periods, bank accounts, and atomic document number sequences. Every tenant-owned row carries tenant_id derived exclusively from authenticated server context and enforced via composite foreign keys (tenant_id, id) plus optional PostgreSQL RLS.\',\n    specRef: \'METR-SPEC-001 \302\267 Section B4\',\n  },\n  {\n    id: \'double-entry-immutability\',\n    category: \'Finance & Ledger\',\n    question: \'How are double-entry integrity and posted document immutability enforced?\',\n    answer:\n      \'Every journal post executes atomically inside a database transaction that validates an open fiscal period, verifies SUM(debit_base) = SUM(credit_base) with numeric(20,4) fixed-point decimals (never IEEE floating-point), and records an idempotency key. Once posted or issued, journals and invoices cannot be edited or deleted\342\200\224corrections require linked reversing journals or approved credit notes.\',\n    specRef: \'METR-SPEC-001 \302\267 Section B7 & C9\',\n  },\n  {\n    id: \'separation-of-duties\',\n    category: \'Security & Tenancy\',\n    question: \'Can a system administrator view payroll or approve their own purchase orders?\',\n    answer:\n      \'No. METR enforces deny-by-default server-side authorization with strict Separation of Duties (SoD). Initiators cannot self-approve sensitive quotations, purchase orders, vendor payments, or journal postings above configured thresholds, and platform administrators never inherit unrestricted financial or HR payroll viewing merely by holding administrative privileges.\',\n    specRef: \'METR-SPEC-001 \302\267 Section A3b & B8\',\n  },\n  {\n    id: \'vertical-slices\',\n    category: \'Rollout\',\n    question: \'How is METR rolled out without disrupting active finance and delivery teams?\',\n    answer:\n      \'Engineering delivers complete vertical slices (UI + API + permission checks + PostgreSQL persistence + outbox events + GL reporting + negative tests) rather than disconnected tabs. Phase 1 proves Lead-to-Cash and Trial Balance reconciliation end-to-end before Phase 2 introduces procurement, warehousing, contracts, projects, and SLA support.\',\n    specRef: \'METR-SPEC-001 \302\267 Section D1 & D2\',\n  },\n  {\n    id: \'explicit-exclusions\',\n    category: \'Rollout\',\n    question: \'What is explicitly out of scope for the initial Phase 1 release?\',\n    answer:\n      \'To protect transactional integrity and launch velocity, the first release explicitly excludes manufacturing MRP/BOM, retail POS tills, regulated banking core ledgers, self-service external tenant signup, AI-autonomous financial posting, and unvalidated jurisdiction-specific payroll calculations.\',\n    specRef: \'METR-SPEC-001 \302\267 Section A4\',\n  },\n];\n\nexport const MONOREPO_TREE = `metr/\n\342\224\234\342\224\200\342\224\200 apps/\n\342\224\202   \342\224\234\342\224\200\342\224\200 web/                 # Next.js + TypeScript web interface (hero, modules, roadmap, waitlist)\n\342\224\202   \342\224\224\342\224\200\342\224\200 api/                 # NestJS modular monolith API (/api/v1 + OpenAPI)\n\342\224\234\342\224\200\342\224\200 packages/\n\342\224\202   \342\224\234\342\224\200\342\224\200 ui/                  # Precision Ledger & Flow tokens + shared accessible components\n\342\224\202   \342\224\234\342\224\200\342\224\200 contracts/           # Typed API contracts, enums, fixed-point ledger validators\n\342\224\202   \342\224\224\342\224\200\342\224\200 config/              # Tooling, ESLint, TypeScript, and runtime schemas\n\342\224\234\342\224\200\342\224\200 database/\n\342\224\202   \342\224\234\342\224\200\342\224\200 migrations/          # Reviewed, ordered PostgreSQL DDL migrations (15 schemas)\n\342\224\202   \342\224\224\342\224\200\342\224\200 seeds/               # Deterministic non-production demo datasets\n\342\224\234\342\224\200\342\224\200 docs/\n\342\224\202   \342\224\234\342\224\200\342\224\200 adr/                 # Architecture Decision Records (auth, ORM, tax, FX)\n\342\224\202   \342\224\224\342\224\200\342\224\200 api/                 # Generated OpenAPI 3.1 specifications + sample payloads\n\342\224\224\342\224\200\342\224\200 tests/e2e/               # Critical business journey & cross-tenant denial suites`;\n\nexport const SQL_PATTERN_SNIPPET = `CREATE TABLE finance.invoices (\n  id uuid PRIMARY KEY,\n  tenant_id uuid NOT NULL,\n  company_id uuid NOT NULL,\n  customer_party_id uuid NOT NULL,\n  currency char(3) NOT NULL,\n  total numeric(20,4) NOT NULL CHECK (total >= 0),\n  status text NOT NULL DEFAULT \'draft\',\n  FOREIGN KEY (tenant_id, customer_party_id)\n    REFERENCES core.parties (tenant_id, id),\n  UNIQUE (tenant_id, id)\n);\n\nCREATE TABLE finance.journal_lines (\n  id uuid PRIMARY KEY,\n  journal_entry_id uuid NOT NULL,\n  gl_account_id uuid NOT NULL,\n  debit_base numeric(20,4) NOT NULL DEFAULT 0 CHECK (debit_base >= 0),\n  credit_base numeric(20,4) NOT NULL DEFAULT 0 CHECK (credit_base >= 0),\n  CHECK (\n    (debit_base > 0 AND credit_base = 0) OR\n    (credit_base > 0 AND debit_base = 0)\n  )\n);`;\n\nexport const SAMPLE_API_PAYLOAD = `POST /api/v1/quotes HTTP/1.1\nAuthorization: Bearer <scoped-session-token>\nIdempotency-Key: 9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d\nContent-Type: application/json\n\n{\n  \"companyId\": \"c8f2a10e-7b4d-4d91-9e12-40a18bc10422\",\n  \"customerPartyId\": \"71f9d3a0-523c-4f2e-a8b9-9f4e21a60c11\",\n  \"opportunityId\": \"39a7c21b-11e0-4d34-b08c-6d2191e409fa\",\n  \"currency\": \"NGN\",\n  \"validUntil\": \"2026-12-16\",\n  \"lines\": [\n    {\n      \"itemId\": \"fw-ng-400-appliance-uuid\",\n      \"quantity\": \"1\",\n      \"unitPrice\": \"1500000.00\"\n    },\n    {\n      \"itemId\": \"svc-inst-01-deployment-uuid\",\n      \"quantity\": \"1\",\n      \"unitPrice\": \"350000.00\"\n    }\n  ]\n}`;\n"
