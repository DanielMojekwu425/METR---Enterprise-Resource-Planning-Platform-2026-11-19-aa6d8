      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Configure Google Fonts (Manrope, Inter, JetBrains Mono) and METR metadata in index.html\", \"EndLine\":17, \"Instruction\":\"Update title, meta tags, and load Manrope, Inter, and JetBrains Mono fonts\", \"ReplacementContent\":\"<!doctype html>\\n<html lang=\\\"en\\\" class=\\\"scroll-smooth\\\">\\n  <head>\\n    <meta charset=\\\"UTF-8\\\" />\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\" />\\n    <title>METR \342\200\224 Enterprise Resource Planning Platform</title>\\n    <meta\\n      name=\\\"description\\\"\\n      content=\\\"Unified multi-entity Enterprise Resource Planning platform for lead-to-cash, procure-to-pay, service delivery, and posting-grade double-entry financial records.\\\"\\n    />\\n    <meta property=\\\"og:title\\\" content=\\\"METR \342\200\224 Enterprise Resource Planning Platform\\\" />\\n    <meta\\n      property=\\\"og:description\\\"\\n      content=\\\"Unified multi-entity Enterprise Resource Planning platform for lead-to-cash, procure-to-pay, service delivery, and posting-grade double-entry financial records.\\\"\\n    />\\n    <meta property=\\\"og:type\\\" content=\\\"website\\\" />\\n    <meta name=\\\"twitter:card\\\" content=\\\"summary_large_image\\\" />\\n    <link rel=\\\"preconnect\\\" href=\\\"https://fonts.googleapis.com\\\" />\\n    <link rel=\\\"preconnect\\\" href=\\\"https://fonts.gstatic.com\\\" crossorigin />\\n    <link\\n      href=\\\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap\\\"\\n      rel=\\\"stylesheet\\\"\\n    />\\n  </head>\\n  <body class=\\\"bg-[#F5F7FA] text-[#172B4D] antialiased selection:bg-[#0F766E]/15 selection:text-[#005C55]\\\">\\n    <div id=\\\"root\\\"></div>\\n    <script type=\\\"module\\\" src=\\\"/src/main.tsx\\\"></script>\\n  </body>\\n</html>\", \"StartLine\":1, \"TargetContent\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n  <head>\\n    <meta charset=\\\"UTF-8\\\" />\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\" />\\n    <title>My Google AI Studio App</title>\\n    <meta name=\\\"description\\\" content=\\\"An application built with Google AI Studio.\\\" />\\n    <meta property=\\\"og:title\\\" content=\\\"My Google AI Studio App\\\" />\\n    <meta property=\\\"og:description\\\" content=\\\"An application built with Google AI Studio.\\\" />\\n    <meta property=\\\"og:type\\\" content=\\\"website\\\" />\\n    <meta name=\\\"twitter:card\\\" content=\\\"summary_large_image\\\" />\\n  </head>\\n  <body>\\n    <div id=\\\"root\\\"></div>\\n    <script type=\\\"module\\\" src=\\\"/src/main.tsx\\\"></script>\\n  </body>\\n</html>\", \"TargetFile\":\"/index.html\", \"toolAction\":\"Updating index.html fonts and meta\", \"toolSummary\":\"Update index.html\"}"
