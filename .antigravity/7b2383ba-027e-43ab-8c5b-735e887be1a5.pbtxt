ntityCount\', e.target.value)}\n                    aria-invalid={Boolean(fieldErrors.entityCount)}\n                    aria-describedby={fieldErrors.entityCount ? \'err-entityCount\' : undefined}\n                    className=\"metr-input w-full px-3.5 text-[14px]\"\n                  >\n                    <option value=\"\">Select legal entity structure...</option>\n                    {ENTITY_OPTIONS.map((opt) => (\n                      <option key={opt} value={opt}>\n                        {opt}\n                      </option>\n                    ))}\n                  </select>\n                  {fieldErrors.entityCount && (\n                    <p\n                      id=\"err-entityCount\"\n                      className=\"mt-1.5 text-[12px] font-medium text-[#BA1A1A]\"\n                    >\n                      {fieldErrors.entityCount}\n                    </p>\n                  )}\n                </div>\n\n                {/* Priority Phases Checkboxes (Precision Ledger 18px teal checkboxes) */}\n                <fieldset>\n                  <legend className=\"text-[13px] font-semibold text-[#172B4D] mb-2\">\n                    Priority Rollout Scope <span className=\"text-[#BA1A1A]\">*</span>\n                  </legend>\n                  <div className=\"space-y-2.5\">\n                    {PHASE_CHOICES.map((choice) => {\n                      const checked = form.priorityPhases.includes(choice.phase);\n                      return (\n                        <label\n                          key={choice.phase}\n                          className={`flex items-start gap-3 rounded-[0.5rem] border p-3 cursor-pointer transition-colors ${\n                            checked\n                              ? \'border-[#0F766E]/45 bg-[#0F766E]/[0.04]\'\n                              : \'border-[#D7E0E8] bg-white hover:bg-[#F5F7FA]\'\n                          }`}\n                        >\n                          <input\n                 