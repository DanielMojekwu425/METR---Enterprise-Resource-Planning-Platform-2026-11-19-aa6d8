      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Replace BrandMark inline SVG icon with attached /assets/aistudio/metr-mark_85805334.svg asset for header and footer\", \"EndLine\":52, \"Instruction\":\"Render /assets/aistudio/metr-mark_85805334.svg in place of the previous inline SVG icon\", \"ReplacementContent\":\"/**\\n * METR brand mark using the official attached SVG mark paired with the Manrope wordmark.\\n */\\nexport function BrandMark({ inverted = false, className = \'\' }: BrandMarkProps) {\\n  const textColor = inverted ? \'text-white\' : \'text-[#102A43]\';\\n\\n  return (\\n    <span className={`inline-flex items-center gap-2.5 whitespace-nowrap shrink-0 ${className}`}>\\n      <img\\n        src=\\\"/assets/aistudio/metr-mark_85805334.svg\\\"\\n        alt=\\\"\\\"\\n        width={28}\\n        height={28}\\n        aria-hidden=\\\"true\\\"\\n        className={`h-7 w-7 shrink-0 object-contain ${\\n          inverted ? \'brightness-[1.75] saturate-[1.15]\' : \'\'\\n        }`}\\n      />\\n      <span\\n        className={`font-[Manrope] text-[20px] font-extrabold tracking-[-0.03em] leading-none ${textColor}`}\\n      >\\n        METR\\n      </span>\\n    </span>\\n  );\\n}\", \"StartLine\":8, \"TargetContent\":\"/**\\n * Geometric METR monogram with rounded stroke caps (stroke-linecap=\\\"round\\\")\\n * representing connected ledger nodes and systemic operational flow.\\n */\\nexport function BrandMark({ inverted = false, className = \'\' }: BrandMarkProps) {\\n  const strokePrimary = inverted ? \'#2DD4BF\' : \'#0F766E\';\\n  const strokeSecondary = inverted ? \'#FFFFFF\' : \'#102A43\';\\n  const textColor = inverted ? \'text-white\' : \'text-[#102A43]\';\\n\\n  return (\\n    <span className={`inline-flex items-center gap-2.5 whitespace-nowrap shrink-0 ${className}`}>\\n      <svg\\n        width=\\\"28\\\"\\n        height=\\\"28\\\"\\n        viewBox=\\\"0 0 28 28\\\"\\n        fill=\\\"none\\\"\\n        xmlns=\\\"http://www.w