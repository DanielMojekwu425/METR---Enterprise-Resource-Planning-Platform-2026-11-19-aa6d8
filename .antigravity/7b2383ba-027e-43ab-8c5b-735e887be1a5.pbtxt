   - generic [ref=e545]:\n            - paragraph [ref=e546]: Technical Identity & Trust \302\267 Section B1\342\200\223B9\n            - heading \"Modular monolith discipline. Ledger-grade PostgreSQL core.\" [level=2] [ref=e547]\n            - paragraph [ref=e548]: METR rejects premature microservice sprawl in favor of one transactional NestJS backend with domain-enforced module boundaries, a Next.js + TypeScript web client, and ACID PostgreSQL schemas.\n          - generic [ref=e549]:\n            - generic [ref=e555]:\n              - generic [ref=e556]: Web Client\n              - generic [ref=e557]: Next.js + TypeScript + Tailwind (apps/web + packages/ui)\n            - generic [ref=e564]:\n              - generic [ref=e565]: Application API\n              - generic [ref=e566]: NestJS Modular Monolith \302\267 REST /api/v1 \302\267 OpenAPI + Idempotency-Key\n            - generic [ref=e573]:\n              - generic [ref=e574]: Relational Core\n              - generic [ref=e575]: PostgreSQL ACID \302\267 15 Domain Schemas \302\267 Transactional Outbox\n            - generic [ref=e581]:\n              - generic [ref=e582]: Files & Continuity\n              - generic [ref=e583]: Private Encrypted S3 Buckets \302\267 Signed URLs \302\267 Continuous WAL/PITR\n        - generic [ref=e585]:\n          - tablist \"Technical specification views\" [ref=e586]:\n            - tab \"SQL Ledger Pattern\" [selected] [ref=e587] [cursor=pointer]\n            - tab \"Monorepo Structure\" [ref=e592] [cursor=pointer]\n            - tab \"API Payload (D5)\" [ref=e598] [cursor=pointer]\n            - tab \"Security Controls\" [ref=e603] [cursor=pointer]\n          - generic [ref=e608]:\n            - generic [ref=e609]:\n              - generic [ref=e610]: database/migrations/0012_finance_ledger.sql\n              - generic [ref=e611]: PostgreSQL 18 \302\267 numeric(20,4)\n            - code [ref=e613]: CREATE TABLE finance.invoices ( id uuid PRIMARY KEY, tenant_id uuid NOT NULL, company_id uuid NOT NULL, customer_party_id uuid NOT NULL, currency char(3) NOT NULL, total numeric(20,4) NOT NULL CHECK (total >= 0), status text NOT NULL DEFAULT \'draft\', FOREIGN KEY (tenant_id, customer_party_id) REFERENCES core.parties (tenant_id, id), UNIQUE (tenant_id, id) ); CREATE TABLE finance.journal_lines ( id uuid PRIMARY KEY, journal_entry_id uuid NOT NULL, gl_account_id uuid NOT NULL, debit_base numeric(20,4) NOT NULL DEFAULT 0 CHECK (debit_base >= 0), credit_base numeric(20,4) NOT NULL DEFAULT 0 CHECK (credit_base >= 0), CHECK ( (debit_base > 0 AND credit_base = 0) OR (credit_base > 0 AND debit_base = 0) ) );\n      - generic [ref=e615]:\n        - generic [ref=e616]:\n          - heading \"Target Non-Functional Engineering Baselines (Section B9)\" [level=3] [ref=e617]\n          - paragraph [ref=e618]: Design targets validated through load, PITR recovery, and automated boundary suites.\n        - generic [ref=e619]:\n          - generic [ref=e620]:\n            - generic [ref=e621]: Monthly Availability\n            - generic [ref=e622]: \342\211\245 99.5%\n            - generic [ref=e623]: Synthetic HTTP monitoring\n          - generic [ref=e624]:\n            - generic [ref=e625]: p95 Read / Write\n            - generic [ref=e626]: \342\211\244 1.2s / 2.0s\n            - generic [ref=e627]: 100 concurrent staff target\n          - generic [ref=e628]:\n            - generic [ref=e629]: Recovery Point (RPO)\n            - generic [ref=e630]: \342\211\244 15 min\n            - generic [ref=e631]: Continuous PostgreSQL WAL/PITR\n          - generic [ref=e632]:\n            - generic [ref=e633]: Recovery Time (RTO)\n            - generic [ref=e634]: \342\211\244 4 hours\n            - generic [ref=e635]: Monthly staged restore drills\n          - generic [ref=e636]:\n            - generic [ref=e637]: Security Baseline\n            - generic [ref=e638]: OWASP ASVS L2\n            - generic [ref=e639]: ASVS 5.0.0 + NDPA 2023 ready\n          - generic [r