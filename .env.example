# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Base URL for self-referential links, OAuth, and email verification links.
APP_URL="http://localhost:3000"

# PostgreSQL connection string (Supabase / Neon / self-hosted Postgres)
# e.g., postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/3metr"

# Resend API key for transactional emails
RESEND_API_KEY="re_sample_key"

# Email address to receive notifications on new waitlist registrations
ADMIN_EMAIL="danielm@3csaquarah.com"

# Sender email address for user verification messages
# Use onboarding@resend.dev during development/testing
SENDER_EMAIL="onboarding@resend.dev"

# Privacy notice version agreed to by registrant
CONSENT_VERSION="2026-11-20-v1"
